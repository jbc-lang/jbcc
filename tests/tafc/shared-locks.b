* tafc-emulation: prime
* TAFC-CROSSCHECK.md section 6: READL family, MATWRITEU, DELETEU, SSELECTV.
* jbcc-options: --memory-file VENDORS
EXECUTE 'CREATE-FILE VENDORS 1 1' CAPTURING JUNK
OPEN 'VENDORS' TO F ELSE STOP 201, 'VENDORS'
WRITE 'ABC':@FM:'x' TO F, '12345'
READL R FROM F, '12345' THEN CRT 'readl ':R<1> ELSE CRT 'readl else'
CRT 'locked ':RECORDLOCKED(F, '12345')
READVL V FROM F, '12345', 2 THEN CRT 'readvl ':V ELSE CRT 'readvl else'
DIM M(3)
MATREAD M FROM F, '12345' ELSE NULL
M(1) = 'NEW'
MATWRITEU M ON F, '12345'
CRT 'locked ':RECORDLOCKED(F, '12345')
READ R FROM F, '12345' THEN CRT 'read ':R<1>
DELETEU F, '12345'
CRT 'locked ':RECORDLOCKED(F, '12345')
READ R FROM F, '12345' THEN CRT 'still there' ELSE CRT 'deleted'
WRITE 'b' TO F, 'B' ; WRITE 'a' TO F, 'A' ; WRITE 'c' TO F, 'C'
SSELECTV F TO LIST
CRT 'sselectv ':OCONV(LIST, 'MCP')
