* tafc-emulation: prime
* TAFC-CROSSCHECK.md sections 4 and 5: TIMEDIFF sign and month masks.
A = MAKETIMESTAMP(19024, 0, 'UTC')    ;* 31 JAN 2020 00:00
B = MAKETIMESTAMP(19419, 3600, 'UTC') ;* 01 MAR 2021 01:00
FOR M = 0 TO 7
   CRT M:' ':OCONV(TIMEDIFF(B, A, M), 'MCP'):'  ':OCONV(TIMEDIFF(A, B, M), 'MCP')
NEXT M
C = MAKETIMESTAMP(19055, 0, 'UTC')    ;* 02 MAR 2020 00:00
D = MAKETIMESTAMP(19024, 7200, 'UTC') ;* 31 JAN 2020 02:00
FOR M = 2 TO 7
   CRT M:' ':OCONV(TIMEDIFF(C, D, M), 'MCP')
NEXT M
