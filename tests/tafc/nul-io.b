* tafc-emulation: prime
* NUL-BYTES.md stage 4: byte 0 in files, records and EXECUTE data.
* TAFC's OSBWRITE of byte 0 writes extra bytes; jbcc writes the bytes given.
* jbcc-options: --memory-file VENDORS
Z = CHAR(0)
X = 'a':Z:'b':@FM:'c'
OSWRITE X ON 'f1'
OSREAD Y FROM 'f1' THEN CRT 1:' ':OCONV(Y, 'MX'):' ':LEN(Y) ELSE CRT 1:' else'
OPENSEQ 'f2' TO F THEN NULL ELSE NULL
WRITESEQ 'p':Z:'q' TO F ELSE NULL
WRITESEQ 'r' TO F ELSE NULL
CLOSESEQ F
OPENSEQ 'f2' TO F ELSE STOP
READSEQ L FROM F THEN CRT 2:' ':OCONV(L, 'MX') ELSE CRT 2:' else ':STATUS()
READSEQ L FROM F THEN CRT 3:' ':OCONV(L, 'MX') ELSE CRT 3:' else'
CLOSESEQ F
OPENSEQ 'f2' TO F ELSE STOP
READBLK B FROM F, 4 THEN CRT 4:' ':OCONV(B, 'MX') ELSE CRT 4:' else ':STATUS()
CLOSESEQ F
OSWRITE '' ON 'f3'
OPENSEQ 'f3' TO F ELSE STOP
WRITEBLK Z:'w':Z TO F ELSE NULL
CLOSESEQ F
OSREAD Y FROM 'f3' THEN CRT 5:' ':OCONV(Y, 'MX') ELSE CRT 5:' else'
OSOPEN 'f3' TO H ELSE STOP
OSBREAD V FROM H AT 0 LENGTH 3
CRT 6:' ':OCONV(V, 'MX')
OSCLOSE H
EXECUTE 'CREATE-FILE VENDORS 1 1' CAPTURING JUNK
OPEN 'VENDORS' TO V ELSE STOP 201, 'VENDORS'
WRITE X TO V, 'k':Z
READ R FROM V, 'k':Z THEN CRT 8:' ':OCONV(R, 'MX') ELSE CRT 8:' else'
READ R FROM V, 'k' THEN CRT 9:' found' ELSE CRT 9:' missing'
READV R FROM V, 'k':Z, 1 THEN CRT 10:' ':OCONV(R, 'MX') ELSE CRT 10:' else'
EXECUTE './CHILD' CAPTURING C PASSDATA 'd':Z:'e' RTNDATA RD
CRT 11:' ':OCONV(C, 'MX'):' ':OCONV(RD, 'MX')
* tafc-program: CHILD
COLLECTDATA A
CRT 'x':CHAR(0):'y ':LEN(A)
RTNDATA CHAR(0):'r'
