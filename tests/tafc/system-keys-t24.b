* tafc-emulation: prime
* TAFC-CROSSCHECK.md: SYSTEM keys T24 reads, and ASSIGN TO SYSTEM.
CRT SYSTEM(1021)[1,4] = 'TAFJ', INDEX(SYSTEM(1021), 'TEMENOS', 1) > 0
FOR I = 1 TO 12
   SK = FIELD('11,25,32,43,47,91,600,1025,1029,1039,2003,2090', ',', I)
   CRT SK:'=[':SYSTEM(SK):']'
NEXT I
ASSIGN 5 TO SYSTEM(2021)
CRT '2021 after ASSIGN=[':SYSTEM(2021):']'
