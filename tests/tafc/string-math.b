* tafc-emulation: prime
* TAFC-CROSSCHECK.md: SADD, SSUB, SMUL and SDIV places.
CRT SADD(4.33333333333333333, 1.8)
CRT SADD('1.12345678901234567890', '0')
CRT SADD('99999999999999999999', '1')
CRT SADD('-1.5', '0.25')
CRT SSUB('1', '0.33333333333333333333')
CRT SSUB('5', '7.5')
CRT SMUL(0.0000000000000475, 3.61)
CRT SMUL('1.23456789', '9.87654321')
CRT SMUL('-2.5', '4')
CRT SMUL('123456789012345678', '1000')
CRT SDIV('1', '3')
CRT SDIV('2', '3')
CRT SDIV('-10', '4')
CRT SDIV('1', '7')
CRT '[':SADD('', '2'):']'
CRT '[':SADD('abc', '2'):']'
