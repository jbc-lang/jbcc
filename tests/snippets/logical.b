PRINT 1 OR 0 AND 0
PRINT 1 OR (0 AND 0)
PRINT 0 OR 2 EQ 3
PRINT 2 EQ 2 OR 0
PRINT '' OR '0.00'
PRINT '' ! 'text'
PRINT 'text' & '0'
PRINT 1 OR 1 / 0
PRINT 0 AND 1 / 0
IF 0 OR 1 THEN PRINT 'yes'
PRECISION 2
PRINT '.001' OR '.002'
! A comment at the start of a statement
PRINT 0 ! 1 : ;! A trailing comment
PRINT '.'
