A = 'first' : @AM : 'second'
B = 'left' : @AM : 'right'
SELECT A TO 3
SELECT B TO L
//
READNEXT X FROM 3 ELSE STOP
READNEXT Y FROM L ELSE STOP
PRINT X,Y
CLEARSELECT 3
READNEXT X FROM 3 THEN STOP
READNEXT Y FROM L THEN PRINT Y
CLEARSELECT L
FOR I = 1 TO 3
 A = @AM : 'a' : @VM : 'b' : @SM : 'c' : @AM : @AM
 SELECT A TO 3
 A = 'replaced'
NEXT I
LOOP WHILE READNEXT X FROM 3 DO
 PRINT '[' : CONVERT(X,@VM:@SM,'/~') : ']'
REPEAT
SELECT '10' TO L
READNEXT X FROM L THEN PRINT X
CLEARSELECT L
SELECT '' TO L
READNEXT X FROM L THEN STOP ELSE PRINT 'empty'
SELECT 'one' SETTING Code
READNEXT X THEN PRINT X,LEN(Code)
