S = 'The world is my lobster'
CRT DQUOTE(LEFT(S,9))
CRT DQUOTE(LEFT(S,999))
CRT DQUOTE(LEFT(S,0))
CRT DQUOTE(RIGHT(S,7))
CRT DQUOTE(RIGHT(S,99))
CRT DQUOTE(RIGHT(S,0))
CRT DQUOTE(LEFT('',1)):DQUOTE(RIGHT('',1))
CRT DQUOTE(LEFT(S,-1)):DQUOTE(RIGHT(S,-1))
CRT LEFT('abc','2.9'):RIGHT('abc','2.9')
Text = 'a':@FM:'b'
CRT LEFT(Text,2):RIGHT(Text,2)
