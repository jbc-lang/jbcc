CRT @SYSTEM.RETURN.CODE
EXECUTE 'exit 9'
Saved = @SYSTEM.RETURN.CODE
PERFORM "printf captured; exit 4" CAPTURING Out
CRT Saved : ' ' : Out : ' ' : @SYSTEM.RETURN.CODE
EXECUTE "printf error >&2; exit 6" SETTING R
CRT R<1> : ' ' : R<2> : ' ' : @SYSTEM.RETURN.CODE
EXECUTE 'kill -TERM $$' CAPTURING Out RETURNING R
CRT SYSTEM(17) : ' ' : @SYSTEM.RETURN.CODE
PERFORM ':'
CRT @SYSTEM.RETURN.CODE : ' ' : SYSTEM(17)
