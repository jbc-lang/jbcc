PRECISION 6
PRINT 2 / 3
PRINT -2 / 3
P = 9
PRECISION P
PRINT NOT('0.00000000000001')
A = '0.12345678901234560'
B = '0.12345678901234561'
PRINT A EQ B
PRECISION 17
PRINT A EQ B
PRINT NOT('0.00000000000001')
PRINT 1 / 10000000000
PRECISION 2
PRINT '.2909' EQ '.29'
PRINT '-.009' EQ '0'
PRINT 'a.001' EQ 'a.002'
PRINT 0.29 * 1
* TAFC prints 999.99: it keeps the literal at the first PRECISION (6) and
* rescales it without rounding. jbcc rounds operands at the current
* PRECISION and prints 1000 (TAFC-CROSSCHECK.md, mixed precision).
PRINT 999.999 / 1
IF 0 THEN PRECISION 5
PRINT 1 / 3
GOSUB WHOLE
PRINT 12 / 5
STOP
WHOLE:
PRECISION 0
PRINT 100 / 1
PRINT -1 / 2
RETURN
