T = 'AAAAA':@FM:'BBBBB':@VM:'CCCCC':@SM:'DDDDD':@FM:'EEEEE':@VM:@SM
CRT SUBSTRINGS(T,3,2)
CRT SUBSTRINGS(T,4,20)
CRT SUBSTRINGS(T,0,1)
T = @FM:'abc':@SM:'x':@VM:CHAR(200):'yz':@FM
CRT SUBSTRINGS(T,2,2)
CRT SUBSTRINGS(T,-2,1)
CRT SUBSTRINGS(T,99,1)
CRT SUBSTRINGS(T,1,0)
CRT SUBSTRINGS(T,'1.9',1)
CRT SUBSTRINGS('',1,1)
CRT T
