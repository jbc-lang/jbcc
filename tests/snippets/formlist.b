KEYS = 'first':@FM:'':@FM:'last':@FM:''
FORMLIST KEYS TO L SETTING N
KEYS = 'changed'
CRT N
FORMLIST 'default'
FORMLIST 'left':@VM:'right' TO 10 SETTING N
CRT N
LOOP WHILE READNEXT K FROM L DO
  CRT '[':K:']'
REPEAT
READNEXT K THEN CRT K
READNEXT K FROM 10 THEN CRT K<1,1>:',':K<1,2>
FORMLIST '' TO 10 SETTING N
READNEXT K FROM 10 ELSE CRT 'empty ':N
FORMLIST 'quoted':@FM:'number' TO "1" SETTING N
CRT N
READNEXT K FROM 1 THEN CRT K
READNEXT K FROM 1 THEN CRT K
FORMLIST 'leading zero' TO '01'
READNEXT K FROM 1 THEN CRT K
