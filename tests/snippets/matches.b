PRINT 'AB123' MATCH "'AB'3N", 'AB123x' MATCHES "'AB'3N", 'ab123' MATCH "'AB'3N"
PRINT '2022/08' MATCHES "2-4N'/'2N", '22/08' MATCH "2-4N'/'2N", '2/08' MATCH "2-4N'/'2N"
PRINT 'PL12345' MATCH 'PL5N', '123' MATCH '123', 'Z8q' MATCH '3C'
PRINT '.99' MATCH "0N'.'2N", '11122' MATCH '0N2N', 'ab12cd' MATCH "0X2N0A"
PRINT '12' MATCH '0A2N', '1x' MATCH '2N', 'a-B' MATCH '3C', 'a-B' MATCH '3X'
Pattern = '2N' : @VM : "'Z'1N"
PRINT 'Z4' MATCH Pattern, 'Z' MATCH Pattern, '' MATCH '0X', @FM MATCH '1X'
PRINT 2 > 'no' MATCH '2N', 'x' MATCH '1' : 'A' AND 1
PRINT 'JOHN DORY' MATCH "'JOHN'...", 'JOHN DORY' MATCH "'JOHN'0X"
PRINT '1234' MATCH '2-3N1N', '12' MATCH '2-3N1N', '12' MATCH '99999999999999999999999N'
PRINT "'A'" MATCH \"'A'"\, '1N' MATCH "'1N'"
