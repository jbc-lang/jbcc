PRINT ASSIGNED(X), UNASSIGNED(X)
IF ASSIGNED(X) AND X THEN PRINT 'wrong'
IF UNASSIGNED(X) THEN X = ''
PRINT ASSIGNED(X), UNASSIGNED(X), LEN(X)
X = 0
PRINT ASSIGNED(X), UNASSIGNED(X)
DIM M(2)
M(1) = ''
PRINT UNASSIGNED(M(0)), ASSIGNED(M(1)), ASSIGNED(M(2))
FOR I = 0 TO 1
  IF I THEN Y = 'yes'
  IF NOT(UNASSIGNED(Y)) AND Y THEN PRINT Y
NEXT
COMMON /STATE/ Z
PRINT ASSIGNED(Z)
Z = ''
PRINT ASSIGNED(Z)
IF 1 THEN Flag = 'set'
LOOP WHILE ASSIGNED(Flag) AND Flag
  PRINT Flag
  Flag = ''
REPEAT
LOOP UNTIL ASSIGNED(Done)
  Done = 1
REPEAT
PRINT Done
