PRINT ASSIGNED(X), UNASSIGNED(X)
IF ASSIGNED(X) AND X THEN PRINT 'wrong'
IF UNASSIGNED(X) THEN X = ''
PRINT ASSIGNED(X), UNASSIGNED(X), LEN(X)
X = 0
PRINT ASSIGNED(X), UNASSIGNED(X)
DIM M(2)
M(1) = ''
PRINT UNASSIGNED(M(0)), ASSIGNED(M(1)), ASSIGNED(M(2))
FOR I = 0 TO 1
  IF I THEN Y = 'yes'
  IF NOT(UNASSIGNED(Y)) AND Y THEN PRINT Y
NEXT
* Prime starts COMMON at 0, so Z is assigned (TAFC PB201214).
COMMON /STATE/ Z
PRINT ASSIGNED(Z)
Z = ''
PRINT ASSIGNED(Z)
IF 1 THEN Flag = 'set'
LOOP WHILE ASSIGNED(Flag) AND Flag
  PRINT Flag
  Flag = ''
REPEAT
LOOP UNTIL ASSIGNED(Done)
  Done = 1
REPEAT
PRINT Done
* An extraction argument, as in T24 R13 RAISE.PENDING.ENTRIES. The
* reference applies UNASSIGNED to the extracted value, which is assigned.
List = 'a':@VM:'b'
IF UNASSIGNED(List<1,3>) THEN PRINT 'wrong' ELSE PRINT 'extracted'
PRINT ASSIGNED(List<1>), UNASSIGNED(List<2,1,1>)
