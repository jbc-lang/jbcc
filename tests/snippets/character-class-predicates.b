Letters = 'Az'
CRT ALPHA(Letters), ISALPHA(Letters), ISALPHA(''), ISALPHA('Az1'), ISALPHA('a-b')
CRT ISALPHA('a':@FM:'b'), ISALPHA(CHAR(233)), ISALPHA('a b')
CRT ISDIGIT('009'), ISDIGIT(0), ISDIGIT(-9), ISDIGIT(9.5), ISDIGIT('+9'), ISDIGIT('9 ')
CRT ISDIGIT(''), ISDIGIT('7':@VM:'9'), ISDIGIT(CHAR(178))
CRT NUM(-9), NUM(9.5), NUM(''), NUM('+9')
* ISALNUM as in T24 R13 IN2SEC; values from the guide's ISALNUM example.
CRT ISALNUM('AWERC1'), ISALNUM('AWERC'), ISALNUM('009'), ISALNUM(''), ISALNUM('A-1')
CRT ISALNUM('A 1'), ISALNUM('a':@FM:'1'), ISALNUM(CHAR(233))
IF ISDIGIT('123') AND ISALPHA('xY') THEN CRT 'accepted' ELSE ABORT
* ISUPPER and ISSPACE as in T24 R19 PAYMENT.ORDER IBAN and BIC checks;
* ISSPACE values from the guide's example.
CRT ISUPPER('DEUT'), ISUPPER('DeUT'), ISUPPER(''), ISUPPER('AB1'), ISUPPER(CHAR(201))
CRT ISLOWER('abc'), ISLOWER('aBc'), ISLOWER('')
CRT ISSPACE(''), ISSPACE(' '), ISSPACE(' ':CHAR(9):CHAR(10):CHAR(11):CHAR(12):CHAR(13)), ISSPACE(' x')
IF ISUPPER('AB') AND NOT(ISSPACE('a')) THEN CRT 'accepted' ELSE ABORT
