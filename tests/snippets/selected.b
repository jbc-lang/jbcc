* The guide distinguishes the default external list from BASIC selections.
CRT @SELECTED
SELECT 'a':@FM:'b' TO Named
SELECT 'a':@FM:'b'
CRT @SELECTED
WRITELIST 'first':@FM:'':@FM:'last' ON ''
CRT @SELECTED
READNEXT Key THEN CRT Key:':':@SELECTED ELSE STOP
READLIST Rest FROM 0 SETTING N THEN CRT N:':':@SELECTED ELSE STOP
FORMLIST 'num' TO 2
CLEARSELECT 2
CLEARSELECT Named
CRT @SELECTED
WRITELIST 'replacement' ON ''
CLEARSELECT
CRT @SELECTED
WRITELIST '' ON ''
CRT @SELECTED
