A = 'ABC' : @FM : 'DEF' : @VM : '123' : @VM : 'XYZ' : @VM : '456'
A := @FM : '789' : @FM : '---' : @SM : 'XYZ'
FIND 'XYZ' IN A SETTING F,V THEN PRINT F,V ELSE PRINT 'miss'
DIM Pos(3)
FIND 'XYZ' IN A,2 SETTING Pos(1),Pos(2),Pos(3) ELSE STOP
PRINT Pos(1),Pos(2),Pos(3)
FIND 'XY' IN A SETTING F,V,S THEN
  PRINT 'unexpected match'
END ELSE
  PRINT F,V,UNASSIGNED(S)
END
FIND 'XYZ' IN A<4> SETTING F,V,S THEN PRINT F,V,S
A = '01' : @FM : '1' : @VM
FIND 1 IN A SETTING F THEN PRINT F
FIND '' IN A SETTING F,V,S THEN PRINT F,V,S
FIND '1' IN A,2 SETTING F ELSE PRINT 'no second match'
