OPENSEQ 'input' READONLY TO F ELSE ABORT
DIM Block(1)
READBLK Block(1) FROM F,4 SETTING S THEN CRT CONVERT(CHAR(13):CHAR(10):@FM, 'RN|', Block(1)),S ELSE ABORT
READBLK V FROM F,2 THEN CRT V ELSE ABORT
READBLK V FROM F,99 SETTING S THEN ABORT ELSE CRT 'short',S,LEN(V)
SEEK F,-1,1 ELSE ABORT
READBLK V FROM F,1 THEN CRT V ELSE ABORT
READBLK V FROM F,1 SETTING S THEN ABORT ELSE CRT 'eof',S
WRITEBLK 'no' TO F SETTING S THEN ABORT ELSE CRT 'readonly',S
CLOSESEQ F
OPENSEQ 'output' TO F THEN ABORT ELSE NULL
WRITEBLK 'no' TO F SETTING S THEN ABORT ELSE CRT 'pending',S
CREATE F ELSE ABORT
WRITEBLK 'A':@FM ON F SETTING S THEN CRT 'wrote',S ELSE ABORT
WRITEBLK 'B' TO F ELSE ABORT
SEEK F ELSE ABORT
READBLK V FROM F,1 THEN CRT V ELSE ABORT
WRITEBLK 'X' TO F ELSE ABORT
READBLK V FROM F,1 THEN CRT V ELSE ABORT
CLOSESEQ F
OPENSEQ 'binary' READONLY TO F ELSE ABORT
READBLK V FROM F,3 SETTING S THEN ABORT ELSE CRT 'nul',S,LEN(V)
READBLK V FROM F,1 THEN CRT V ELSE ABORT
CLOSESEQ F
