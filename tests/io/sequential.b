OPENSEQ '.', 'input' READONLY TO F SETTING S ELSE STOP
CRT S
OPENSEQ 'input' READONLY TO SHARED ELSE STOP
CLOSESEQ SHARED
READSEQ V FROM F ELSE STOP
CRT '[':V:']'
READSEQ V FROM F ELSE STOP
CRT '[':V:']'
READSEQ V FROM F ELSE STOP
CRT LEN(V)
READSEQ V FROM F ELSE STOP
CRT V
READSEQ V FROM F SETTING S THEN STOP ELSE CRT 'eof ':S
WRITESEQ 'bad' TO F SETTING S ON ERROR CRT S THEN STOP ELSE STOP
ALIAS = F
CLOSESEQ F
READSEQ V FROM ALIAS THEN STOP ELSE CRT 'closed'
CLOSESEQ ALIAS THEN STOP ELSE CRT 'already closed'
OPENSEQ EXISTING 'new' TO F THEN STOP ELSE NULL
WRITESEQ 'bad' TO F THEN STOP ELSE CRT 'missing'
OPENSEQ 'new' TO F THEN STOP ELSE NULL
WRITESEQ 'one' TO F ELSE STOP
WRITESEQF 'two' ON F ELSE STOP
CLOSESEQ F
OPENSEQ 'new' TO F ELSE STOP
READSEQ V FROM F ELSE STOP
WRITESEQ 'TWO' TO F ELSE STOP
WRITESEQ 'last' APPEND TO F ELSE STOP
CLOSESEQ F
OPENSEQ APPEND 'new' TO F ELSE STOP
WRITESEQ 'end' TO F ELSE STOP
CLOSESEQ F
CRT 'done'
