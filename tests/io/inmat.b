N = 4
DIM A(3), B(2,N)
CRT INMAT(), INMAT(A), CONVERT(INMAT(B),@VM,'x')
OPEN 'F' TO F ELSE ABORT
WRITE 'a':@FM:'b':@FM:'' TO F,'fit'
WRITE 'a':@FM:'b':@FM:'c':@FM:'d' TO F,'overflow'
MATREAD A FROM F,'fit' THEN CRT INMAT(), LEN(A(3)) ELSE ABORT
MATREAD A FROM F,'overflow' SETTING S THEN CRT INMAT(), S, CONVERT(A(3),@FM,'|') ELSE ABORT
MATREADU A FROM F,'fit' THEN CRT INMAT(), RECORDLOCKED(F,'fit') ELSE ABORT
MATREADU A FROM F,'busy' LOCKED CRT INMAT() ELSE ABORT
MATREAD A FROM F,'fit' ELSE ABORT
MATREAD A FROM F,'missing' ELSE CRT INMAT()
MATPARSE A FROM 'a':@FM:'b':@VM:'c' SETTING S
CRT INMAT(),S
MATPARSE A,2,3 FROM 'x:y:z' USING ':' SETTING S
CRT INMAT(),S,A(0)
MATPARSE A,2,3 FROM 'x:y' USING ':' SETTING S
CRT INMAT(),S
CALL SHAPE(MAT B)
CRT INMAT()
