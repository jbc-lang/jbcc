OPEN 'Free' ELSE ABORT
OPEN 'Free' TO F ELSE ABORT
OPEN 'Free' TO Alias ELSE ABORT
OPEN 'Busy' TO Busy ELSE ABORT
FILELOCK SETTING Code ON ERROR ABORT LOCKED ABORT
CRT Code, STATUS(), RECORDLOCKED(F, 'key')
WRITE 'value' TO F, 'key'
RELEASE F, 'key'
CRT RECORDLOCKED(F, 'key')
RECORDLOCKU F, 'key' ELSE ABORT
FILEUNLOCK
CRT STATUS(), RECORDLOCKED(F, 'key'), RECORDLOCKED(F, 'other')
RELEASE F, 'key'
FILELOCK F
CLOSE F
CRT RECORDLOCKED(Alias, 'key')
OPEN 'Free' TO F ELSE ABORT
CRT RECORDLOCKED(F, 'key')
READ Value FROM F, 'key' THEN CRT Value ELSE ABORT
FILELOCK Busy SETTING Code ON ERROR ABORT
LOCKED
    CRT Code, STATUS(), RECORDLOCKED(Busy, 'held')
END
FILELOCK Busy SETTING Code
CRT Code, STATUS()
Bad = ''
FILELOCK Bad ON ERROR CRT STATUS() LOCKED ABORT
FILEUNLOCK Bad ON ERROR CRT STATUS()
