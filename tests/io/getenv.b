NAME = 'JBCC_TEST_VALUE'
IF GETENV(NAME, RESULT) THEN CRT RESULT ELSE STOP
CRT GETENV('JBCC_TEST_':'VALUE')
CRT GETENV('JBCC_TEST_EMPTY', RESULT):'[':RESULT:']'
RESULT = 'old'
CRT GETENV('JBCC_TEST_ABSENT', RESULT):'[':RESULT:']'
CRT '[':GETENV('JBCC_TEST_ABSENT'):']'
DIM VALUES(2)
OK = GETENV(NAME, VALUES(2))
CRT OK:':':VALUES(2)
CRT NAME:':':GETENV(NAME, NAME):':':NAME
IF 0 AND GETENV('JBCC_TEST_VALUE', SKIPPED) THEN STOP
CRT ASSIGNED(SKIPPED)
IF 1 AND GETENV('JBCC_TEST_VALUE', FRESH) THEN CRT FRESH
