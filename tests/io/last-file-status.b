CRT STATUS()
OPEN 'missing' ELSE CRT 'open', STATUS()
OPEN 'F' TO F THEN CRT 'opened', STATUS() ELSE ABORT
READ V FROM F,'missing' ELSE CRT 'read', STATUS()
READU V FROM F,'busy' LOCKED CRT 'locked', STATUS() ELSE ABORT
WRITE 'value' ON F,'busy' ON ERROR CRT 'write', STATUS()
WRITE 'value' ON F,'key' SETTING S
CRT 'wrote', STATUS(), LEN(S)
DIM A(2)
MATREAD A FROM F,'key' SETTING S THEN CRT 'fields', STATUS(), S ELSE ABORT
CALL PROBE(F)
CRT 'after call', STATUS()
STATUS Meta FROM F THEN CRT Meta<21>, STATUS() ELSE ABORT
CLOSE F
CLOSE F ON ERROR CRT 'close', STATUS()
OPENSEQ 'input' READONLY TO G THEN CRT 'seq open', STATUS() ELSE ABORT
READBLK V FROM G,2 THEN CRT V,STATUS() ELSE ABORT
READBLK V FROM G,2 ELSE CRT 'short', STATUS()
WRITEBLK 'x' TO G ELSE CRT 'readonly', STATUS()
CLOSESEQ G THEN CRT 'seq close', STATUS() ELSE ABORT
