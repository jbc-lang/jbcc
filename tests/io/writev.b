OPEN 'F' TO F ELSE STOP
OPEN 'F' ELSE STOP
WRITE 'one':@FM:'two':@FM:'three' TO F,'r'
READVU V FROM 'r',2 ELSE STOP
WRITEVU V:@VM:'extra' TO F,'r',2 SETTING S ON ERROR STOP
CRT LEN(S), RECORDLOCKED(F,'r')
WRITEV 'six' ON 'r',6
CRT RECORDLOCKED(F,'r')
READ R FROM 'r' THEN CRT CONVERT(@FM:@VM, '|,', R) ELSE STOP
WRITEVU 'new' TO 'missing',3
READ R FROM 'missing' THEN CRT CONVERT(@FM, '|', R) ELSE STOP
CRT RECORDLOCKED(F,'missing')
WRITEV 'blocked' TO F,'busy',2 SETTING S ON ERROR CRT S, RECORDLOCKED(F,'busy')
WRITEVU 'blocked' TO F,'busy',2 SETTING S ON ERROR CRT S
READ R FROM 'busy' THEN STOP ELSE CRT 'missing'
BAD = 'F'
WRITEV 'no' TO BAD,'r',2 SETTING S ON ERROR CRT S
