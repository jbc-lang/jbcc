OPENPATH 'data/customers' TO F ELSE STOP
WRITE 'old' ON F,'a'
WRITE 'Emily' ON F,'a'
WRITE 'Jo' ON F,'b'
DIM A(1)
STATUS A(1) FROM F SETTING S ELSE STOP
INFO = A(1)
CRT S:',':INFO<6>:',':INFO<20>:',':INFO<21>:',':DCOUNT(INFO,@FM)
CRT '[':INFO<22>:INFO<23>:INFO<27>:']'
DELETE F,'a'
STATUS INFO FROM F ELSE STOP
CRT INFO<6>
BAD = 'data/customers'
STATUS INFO FROM BAD SETTING S THEN STOP ELSE CRT S:':[':INFO:']'
