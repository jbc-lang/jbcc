OPEN 'F' ELSE STOP
OPEN 'F' TO F ELSE STOP
OPEN 'G' TO G ELSE STOP
DIM FILES(2)
OPEN 'G' TO FILES(1) ELSE STOP
OPEN 'F' TO FILES(2) ELSE STOP
WRITE 'saved' ON F,'id'
READU R FROM F,'id' ELSE STOP
READU R FROM G,'other' ELSE NULL
CLOSE F
CRT ASSIGNED(F),RECORDLOCKED(FILES(2),'id'),RECORDLOCKED(G,'other'),RECORDLOCKED(FILES(2),'foreign')
READ R FROM 'id' THEN CRT R ELSE STOP
CLOSE FILES(1), FILES(2)
CRT ASSIGNED(FILES(1)),ASSIGNED(FILES(2)),RECORDLOCKED(G,'other')
CLOSE F ON ERROR CRT 'already closed'
F = 'ordinary'
CLOSE F ON ERROR CRT F
OPEN 'F' TO F ELSE STOP
READ R FROM F,'id' THEN CRT R ELSE STOP
CLOSE F ON ERROR STOP
CRT UNASSIGNED(F)
