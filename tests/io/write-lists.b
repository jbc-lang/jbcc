NAME = '../order'
WRITELIST 'old' ON NAME
WRITELIST 'first':@FM:'':@FM:'last':@FM:'' TO NAME SETTING S ON ERROR CRT 'write failed'
CRT S
WRITELIST '' ON 'empty'
WRITELIST '7' ON '0'
OPEN 'F' TO F ELSE STOP
WRITE '' TO F,'a'
WRITE '' TO F,'b'
SELECT F TO L
WRITELIST L TO 'keys'
SELECT F
READNEXT KEY ELSE STOP
READLIST REST SETTING N THEN CRT 'remaining ':N:',':REST
