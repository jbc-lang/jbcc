OPENPATH = 'data'
PATH = OPENPATH:'/customers'
OPENPATH PATH TO F SETTING S THEN CRT S ELSE STOP
WRITE 'Ada' ON F, '1'
OPEN PATH ELSE STOP
READ R FROM '1' THEN CRT R ELSE STOP
OPENPATH PATH TO SETTING S ELSE STOP
WRITE 'updated' ON '1'
READ R FROM F, '1' THEN CRT R ELSE STOP
DIM FILES(1)
OPENPATH '/records/customers' TO FILES(1) ELSE STOP
WRITE 'Grace' ON FILES(1), '1'
OPENPATH '/records/customers' THEN NULL ELSE STOP
READ R FROM '1' THEN CRT R ELSE STOP
OPENPATH 'missing' SETTING S ON ERROR STOP THEN STOP ELSE CRT S
READ R FROM '1' THEN STOP ELSE CRT 'default cleared'
OPENPATH 'missing' TO F SETTING S ELSE CRT S
WRITE 'x' ON F, '1' THEN STOP ELSE CRT 'descriptor cleared'
OPENPATH 'DICT', PATH TO D ELSE CRT 'no dictionary'
