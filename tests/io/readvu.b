OPEN 'F' TO F ELSE STOP
OPEN 'F' ELSE STOP
WRITE 'first':@FM:'second':@VM:'value' TO F,'key'
DIM R(1)
READVU R(1) FROM F,'key',2 SETTING S THEN CRT CONVERT(@VM, '|', R(1)), LEN(S), RECORDLOCKED(F,'key') ELSE STOP
READVU R(1) FROM 'key',0 LOCKED STOP THEN CRT R(1)
READVU R(1) FROM 'key',3 THEN CRT LEN(R(1)), RECORDLOCKED(F,'key')
RELEASE 'key'
CRT RECORDLOCKED(F,'key')
READVU V FROM 'missing',1 SETTING S ON ERROR STOP ELSE CRT S, LEN(V), RECORDLOCKED(F,'missing')
WRITE 'created' TO F,'missing'
CRT RECORDLOCKED(F,'missing')
V = 'kept'
READVU V FROM F,'busy',1 SETTING S ON ERROR STOP LOCKED CRT S, V ELSE STOP
READV V FROM 'key',1 THEN CRT V, RECORDLOCKED(F,'key')
BAD = 'F'
READVU V FROM BAD,'key',1 SETTING S ON ERROR CRT S, LEN(V) LOCKED STOP ELSE STOP
