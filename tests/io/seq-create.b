OPENSEQ 'new' TO F THEN STOP ELSE NULL
OPENSEQ 'new' TO OTHER THEN STOP ELSE NULL
CREATE F SETTING S THEN CRT 'created ':S ELSE STOP
READSEQ V FROM F THEN STOP ELSE CRT 'empty'
WRITESEQ 'winner' TO F ELSE STOP
CREATE OTHER THEN STOP ELSE CRT 'lost race'
WEOFSEQ OTHER SETTING S
CRT S
CREATE F THEN STOP ELSE CRT 'exists'
CLOSESEQ F
OPENSEQ 'input' TO F ELSE STOP
READSEQ LINE FROM F ELSE STOP
ALIAS = F
WEOFSEQ ALIAS SETTING S THEN CRT LINE:' ':S ELSE STOP
READSEQ LINE FROM F THEN CRT 'unexpected data' ELSE CRT 'end'
WRITESEQ 'replacement' TO F ELSE STOP
CLOSESEQ F
OPENSEQ 'input' READONLY TO F ELSE STOP
WEOFSEQ F SETTING S ON ERROR CRT 'readonly ':S
WEOFSEQ F THEN STOP ELSE CRT 'denied'
CLOSESEQ F
OPENSEQ 'empty' TO F THEN STOP ELSE WEOFSEQ F
CLOSESEQ F
OPENSEQ 'zero' TO F ELSE STOP
WEOFSEQ F
CLOSESEQ F
CRT 'done'
