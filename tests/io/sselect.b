SSELECT ON ERROR CRT 'missing default'
SSELECT SETTING STATUS
CRT STATUS
OPEN 'F' ELSE STOP
OPEN 'F' TO F ELSE STOP
SSELECT F TO EMPTY.LIST ON ERROR STOP
READNEXT KEY FROM EMPTY.LIST ELSE CRT 'empty'
WRITE '' TO F,'item2'
WRITE '' TO F,'item10'
WRITE '' TO F,'item1'
SSELECT F TO L SETTING STATUS ON ERROR STOP
CRT LEN(STATUS)
SSELECT TO 2
SSELECT
WRITE '' TO F,'a'
DELETE F,'item10'
READNEXT KEY THEN CRT 'default ':KEY
READNEXT KEY FROM 2 THEN CRT 'numbered ':KEY
LOOP WHILE READNEXT KEY FROM L DO
  CRT KEY
REPEAT
BAD = 'F'
SSELECT BAD TO L SETTING STATUS ON ERROR CRT 'bad file ':STATUS
READNEXT KEY FROM L ELSE CRT 'cleared'
