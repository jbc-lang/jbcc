OPEN 'CUSTOMERS' TO F ELSE STOP
OPEN 'CUSTOMERS' ELSE STOP
WRITE 'keep' TO F,'A'
WRITE 'delete me' TO F,'B'
WRITE 'keep too' TO F,'C'
OPEN 'OTHER' TO G ELSE STOP
WRITE 'other' TO G,'B'
DELETE 'B' SETTING Status ON ERROR PRINT 'unexpected'
PRINT Status
DELETE F,'B' ON ERROR
  PRINT 'missing key failed'
END
READ R FROM F,'B' THEN PRINT 'unexpected' ELSE PRINT 'gone'
READ R FROM F,'A' THEN PRINT R
READ R FROM F,'C' THEN PRINT R
READ R FROM G,'B' THEN PRINT R
WRITE 'back' TO F,'B'
READ R FROM F,'B' ELSE STOP
DELETE F,'B'
PRINT R
DIM Codes(2)
DELETE 'CUSTOMERS','A' SETTING Codes(1) ON ERROR
  PRINT Codes(1)
END
DELETE 'bad','A' SETTING Codes(2)
PRINT Codes(2)
