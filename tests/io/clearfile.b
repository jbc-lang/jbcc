OPEN 'CUSTOMERS' TO F ELSE STOP
OPEN 'OTHER' TO G ELSE STOP
OPEN 'OTHER' ELSE STOP
FOR I = 1 TO 3
    WRITE I TO F,I
NEXT
WRITE 'retained' TO G,'1'
Alias = F
CLEARFILE Alias SETTING Code ON ERROR STOP
IF Code NE '' THEN STOP
FOR I = 1 TO 3
    READ R FROM F,I THEN STOP ELSE PRINT 'gone ':I
NEXT
READ R FROM G,'1' ELSE STOP
PRINT R
CLEARFILE F ON ERROR STOP
WRITE 'reused' TO F,'1'
CLEARFILE
READ R FROM G,'1' THEN STOP ELSE PRINT 'default cleared'
READ R FROM Alias,'1' ELSE STOP
PRINT R
DIM Codes(2)
Bad = 'CUSTOMERS'
CLEARFILE Bad SETTING Codes(1) ON ERROR
    PRINT 'error ':Codes(1)
END
CLEARFILE Bad SETTING Codes(2)
PRINT Codes(2)
READ R FROM F,'1' THEN PRINT R
