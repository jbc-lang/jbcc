OPEN 'F' TO F ELSE STOP
OPEN 'F' ELSE STOP
READU R FROM 'new' SETTING S THEN STOP ELSE CRT S, RECORDLOCKED(F, 'new')
WRITE 'first' ON F, 'new'
CRT RECORDLOCKED(F, 'new')
READU R FROM F, 'new' THEN CRT R, RECORDLOCKED(F, 'new')
READU R FROM 'new' LOCKED STOP THEN CRT 'own lock'
RELEASE 'new'
CRT RECORDLOCKED(F, 'new')
READU R FROM F, 'other' ELSE NULL
READU R FROM F, 'new' THEN NULL
DELETE F, 'other'
CRT RECORDLOCKED(F, 'other'), RECORDLOCKED(F, 'new')
CALL REOPEN()
CRT RECORDLOCKED(F, 'new')
READU R FROM 'new' THEN NULL
DIM A(1)
MAT A = 'value'
MATWRITE A ON F, 'new'
CRT RECORDLOCKED(F, 'new')
READU R FROM 'new' THEN NULL
RELEASE F, 'new'
CRT RECORDLOCKED(F, 'new')
READU R FROM 'new' THEN NULL
RELEASE
CRT RECORDLOCKED(F, 'new'), RECORDLOCKED(F, 'busy')
R = 'kept'
READU R FROM 'busy' SETTING S ON ERROR STOP LOCKED CRT 'busy', S, R ELSE STOP
READU R FROM 'invalid', 'id' SETTING S ON ERROR CRT 'error', S LOCKED STOP ELSE STOP
WRITE 'no' ON F, 'busy' THEN STOP ELSE NULL
MATWRITE A ON F, 'busy' SETTING S ON ERROR CRT 'write conflict', S
DELETE F, 'busy' SETTING S ON ERROR CRT 'delete conflict', S
RELEASE F, 'busy'
CRT RECORDLOCKED(F, 'busy')
