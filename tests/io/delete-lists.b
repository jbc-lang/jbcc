NAME = '..'
GETLIST NAME:'/order' SETTING N THEN CRT N ELSE STOP
READNEXT FIRST ELSE STOP
CRT FIRST
GETLIST '' TO 2 SETTING N THEN CRT N
READNEXT KEY FROM 2 THEN CRT '[':KEY:']'
GETLIST '0' TO COPY SETTING N ELSE STOP
DELETELIST '0'
DELETELIST '0'
READNEXT KEY FROM COPY THEN CRT KEY
DELETELIST NAME:'/order'
GETLIST NAME:'/order' SETTING N ELSE CRT 'missing ':N
GETLIST '' ELSE CRT 'inactive'
GETLIST 'keys' THEN NULL ELSE STOP
DELETELIST ''
READNEXT KEY ELSE CRT 'cleared'
