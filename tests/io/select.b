OPEN 'F' TO F ELSE STOP
OPEN 'F' ELSE STOP
SELECT
READNEXT K THEN STOP ELSE PRINT 'empty'
WRITE '' TO F,'a'
WRITE '' TO F,'b'
WRITE '' TO F,'c'
SELECT F TO L SETTING Status
SELECT TO 2
READNEXT K,M FROM L SETTING Status ELSE STOP
PRINT K,M,LEN(Status)
READNEXT K FROM 2 ELSE STOP
PRINT K
DELETE F,'a'
DELETE F,'b'
WRITE 'updated' TO F,'c'
WRITE 'new' TO F,'d'
LOOP WHILE READNEXT K FROM L DO
 PRINT K
REPEAT
N = 2
READNEXT K FROM N THEN PRINT K
READNEXT K FROM 2 THEN PRINT K
READNEXT K FROM 2 THEN STOP ELSE PRINT 'done'
WRITE 'new' TO F,'e'
READNEXT K FROM L THEN STOP ELSE PRINT 'still done'
SELECT F TO N
READNEXT K FROM 2 THEN PRINT K
SELECT F
READNEXT K THEN PRINT 'source first ':K
SELECTE TO Copy
READNEXT K FROM Copy THEN PRINT 'copied ':K
READNEXT K THEN PRINT 'source next ':K
SELECT
CLEARFILE F
READNEXT K THEN STOP ELSE PRINT 'cleared'
OPEN 'MISSING' THEN STOP
SELECT SETTING Status
PRINT Status
