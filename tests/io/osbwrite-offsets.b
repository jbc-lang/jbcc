OSOPEN 'data' TO F ELSE ABORT
AT = 2
NODELAY = 1
OSBWRITE 'A':CHAR(128):'B' TO F AT AT NODELAY SETTING S
CRT S:':':STATUS()
OSBWRITE 'C' ON F
OSBREAD B FROM F AT 1 LENGTH 6
CRT B
OSBWRITE 'Z' TO F
OSBWRITE 'Q' TO F AT 12
OSBREAD B FROM F AT 10 LENGTH 20
CRT B
OSBWRITE '' TO F AT 4
OSBREAD B FROM F LENGTH 2
CRT B
OSCLOSE F
