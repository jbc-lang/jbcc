READLIST L FROM '../order' SETTING N THEN CRT N ELSE STOP
LOOP WHILE READNEXT KEY FROM L DO
  CRT '[':KEY:']'
REPEAT
READLIST L FROM 'empty' SETTING N THEN CRT 'empty ':N
READLIST L FROM 'missing' SETTING N ELSE CRT 'missing ':N
READLIST L FROM '0' THEN READNEXT KEY FROM L THEN CRT KEY
READLIST L FROM 'keys' SETTING N THEN CRT 'keys ':N
LOOP WHILE READNEXT KEY FROM L DO
  CRT KEY
REPEAT
