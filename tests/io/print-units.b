BASE = 1
HEADING "Screen ^'N'"
PRINT ON 0 "screen"
PRINTER ON
HEADING "Default ^"
PRINT "first":
CRT "progress"
HEADING ON 2 "Other ^"
PRINT ON BASE+1 "A", "B":
PAGE ON 2 9
PRINTER OFF
PRINT "back"
PRINTER ON
PRINT " job"
PAGE
PRINTER CLOSE
PRINT ON (BASE+1) "separate"
PRINTER RESET ON 2
HEADING ON 2 "Reset ^"
PRINTER CLOSE ON 2
PRINT ON 2 "new job"
PRINTER CLOSE ON 2
PRINTER ON ON 127
PRINT "high"
PRINTER OFF ON 127
PRINT "terminal"
PRINTER CLOSE ON 127
PAGE
CRT "end"
