NAME = 'JBCC_TEST_PUTENV'
CRT GETENV(NAME)
IF PUTENV(NAME:'=two words=three') THEN CRT GETENV(NAME) ELSE STOP
EXECUTE 'printf "%s" "$JBCC_TEST_PUTENV"' CAPTURING CHILD
CRT CHILD
SAVED = GETENV(NAME)
CRT PUTENV(NAME:'='):':':GETENV(NAME, VALUE):'[':VALUE:']'
CRT PUTENV(NAME):':':PUTENV('=invalid'):':':PUTENV('')
CRT GETENV(NAME, VALUE):'[':VALUE:']'
IF 0 AND PUTENV(NAME:'=skipped') THEN STOP
CRT '[':GETENV(NAME):']'
CRT PUTENV('JBCC_TEST_NEW_ENV=':SAVED)
CRT GETENV('JBCC_TEST_NEW_ENV')
