TESTCASE SAMPLE.RECORDED_1
* setDate and setTime fix DATE() and TIME(); addEasyQAStub builds a repeatable stub from
* matrices, where '*' is any() and same(); addStubCommonCondition answers
* only while a COMMON variable has a value, and a COMMON change fills a
* matrix from a value's fields; setStopping ends the run.
    COMMON /SAMPLE.FLAGS/ FLAG
    FLAG = 'ON'
    UTF.setDate(24, 12, 2009)
    UTF.setTime(13, 39, 41)
    UTF.setTarget("SAMPLE.RECORDED")
    DIM IN(2), OUT(2)
    MAT IN = '*'
    MAT OUT = '*'
    IN(1) = 1
    OUT(2) = 'ADA'
    ERR = 'unset'
    FETCH = UTF.addEasyQAStub('SAMPLE.FETCH', 2, MAT IN, MAT OUT, ERR)
    CHECK = UTF.addStub('SAMPLE.CHECK')
    UTF.addStubCommonCondition(CHECK, FLAG, 'ON')
    COMMON /SAMPLE.ROWS/ ROWS(3)
    UTF.addStubCommonChange(CHECK, ROWS, 'r1' : @FM : 'r2')
    HALT = UTF.addStub('SAMPLE.HALT')
    UTF.setStopping(HALT)
    AFTER = 'not reached'
    UTF.addParam(DAY)
    UTF.addParam(NAME)
    UTF.addParam(AFTER)
    UTF.runTest()
    UTF.assertEquals(DAY, '24/12/2009')
    UTF.assertEquals(NAME, 'ADA')
    UTF.assertEquals(ERR, '')
    UTF.assertEquals(AFTER, 'not reached')
    UTF.assertEquals(UTF.getNbInvocation(CHECK), 1)
    UTF.assertEquals(ROWS(2), 'r2')
    UTF.assertEquals(OCONV(TIME(), 'MTS'), '13:39:41')
    UTF.assertGreaterThan(UTF.getNbInvocation(CHECK), 0)
END
