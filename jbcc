class Token(NamedTuple):
    word: str
    kind: str
    line: int
    column: int
    path: Path


def angle_tokens(words):
    # jpp pairs angle brackets within an expression, excluding logical and
    # statement boundaries. Parenthesized expressions have their own pairs.
    scopes = [[]]
    in_locate = False
    for i, token in enumerate(words):
        word = token.word
        prev = words[i - 1] if i else None
        following = words[i + 1] if i + 1 < len(words) else None
        adjacent = following and token.line == following.line and token.column + 1 == following.column
        if token.kind == 'routine_name':
            continue
        if word in ('(', '['):
            scopes.append([])
        elif word in (')', ']'):
            if len(scopes) > 1:
                scopes.pop()
        elif word in ('THEN', 'ELSE', ';'):
            scopes[-1].clear()
            in_locate = False
        elif word == 'LOCATE':
            in_locate = True
        elif word in LOGICAL:
            scopes[-1].clear()
        elif word == '<' and prev:
            if prev.kind in ('name', 'system_name', 'number', 'string') or prev.word in (')', ']', '>'):
                tight = prev.line == token.line and prev.column + len(prev.word) == token.column
                if not (adjacent and following.word in ('=', '>')):
                    scopes[-1].append((i, tight))
        elif word == '>' and scopes[-1] and prev.word != '<':
            j, tight = scopes[-1].pop()
            if not tight and following:
                # Preserve spaced comparison chains such as A < B > C and
                # A < B >= C. A selector can end before a binary operator.
                if adjacent and following.word == '=':
                    continue
                clause = following.word in ('THEN', 'ELSE') or (
                    in_locate and following.word in ('IN', 'BY', 'SETTING'))
                operand = following.kind in ('name', 'system_name', 'string', 'number') or following.word in ('(', '@')
                if operand and following.word not in PRECEDENCE and not clause:
                    continue
            words[j] = words[j]._replace(kind='array_open')
            words[i] = token._replace(kind='array_close')
    i = 0
    while i < len(words):
        token = words[i]
        i += 1
        if i < len(words) and token.kind == words[i].kind == 'symbol' and token.line == words[i].line:
            following = words[i]
            pair = token.word + following.word
            adjacent = following.column == token.column + 1
            # Form >= only after selector closers have been classified.
            if pair == '>=' or (adjacent and pair in ('<=', '<>')):
                token = token._replace(word=pair)
                i += 1
        yield token


def is_label(name, colon):
    return (name.kind in ('name', 'number') and name.word not in ('CRT', 'DISPLAY', 'PRINT')
            and colon.kind == 'symbol' and colon.word == ':'
            and colon.column == name.column + len(name.word))


def routine_name_at(line, offset, n, path, call):
    bare = BARE_ROUTINE_NAME.match(line, offset)
    if not bare:
        return None, offset
    name = bare[1]
    token = Token(name, 'routine_name', n, bare.start(1) + 1, path)
    if call and name[0] == '@':
        return None, offset
    if call and name[0] in "\"'\\":
        quoted = QUOTED_ROUTINE_NAME.match(line, offset)
        if not quoted:
            directive_error(token, "unterminated quoted routine name")
        name = quoted[1][1:-1]
        if not name:
            directive_error(token, "expected a subroutine name")
        return token._replace(word=name), quoted.end()
    if name == '!' or (not call and (plain := TOKEN.fullmatch(name)) and plain.lastgroup == 'name'):
        # Ordinary headers retain EQUATE expansion.
        return None, offset
    return token, bare.end()


def lex_line(line, n, path, words, parentheses):
    if line.strip() == "//":
        return parentheses
    first_on_line = len(words)
    statement_start = 0
    offset = 0
    while offset < len(line):
        match = TOKEN.match(line, offset)
        offset = match.end()
        word = match[0]
        if match.lastgroup == 'space':
            continue
        if len(words) in (first_on_line, statement_start) and (word.startswith('*') or word in ('!', 'REM')):
            # A comma continues the expression onto this physical line.
            # jpp's leading REM comment rule requires whitespace or end of line.
            if not (word == 'REM' and words and words[-1].word == ',' and line.startswith('(', offset)):
                break
        # jpp treats the rest of a line after comma-semicolon as a comment.
        if (word == ';' and words and words[-1].kind == 'symbol'
                and words[-1].word == ',' and words[-1].line == n):
            break
        kind = match.lastgroup
        if word == '!' and offset < len(line) and TOKEN.match(line, offset).lastgroup == 'name':
            kind = 'bang_prefix'
        if kind == 'compound_assign':
            word = word[0] + '='
            kind = 'symbol'
        if kind == 'name' and words and words[-1].word == '@':
            # jpp expands equates in CALL @ targets but protects system names.
            if len(words) < 2 or words[-2].word != 'CALL':
                kind = 'system_name'
        if word == 'PROGRAM' and (len(words) == statement_start
                                  or words[-1].word in ('THEN', 'ELSE')):
            name = PROGRAM_NAME.match(line, offset)
            if name:
                kind = 'program_header'
                offset = name.end()
        if word == '(':
            parentheses += 1
        elif word == ')' and parentheses:
            parentheses -= 1
        elif word == ';' and parentheses:
            kind = 'argument_separator'
        call = word == 'CALL'
        is_routine_header = word in ('SUB', 'SUBROUTINE') and len(words) == first_on_line
        name = None
        if not parentheses and (call or is_routine_header):
            starts_statement = (len(words) in (first_on_line, statement_start)
                                or words[-1].word in ('THEN', 'ELSE', 'ERROR', 'LOCKED', 'DO', 'LOOP')
                                or words[statement_start].word == 'CASE')
            if starts_statement and not line.startswith(':', offset):
                name, offset = routine_name_at(line, offset, n, path, call)
        words.append(Token(word, kind, n, match.start() + 1, path))
        if name:
            words.append(name)
        if (word == ';' and not parentheses) or (len(words) == statement_start + 2
                           and is_label(words[statement_start], words[-1])):
            statement_start = len(words)
    while words and words[-1].kind == 'symbol' and words[-1].word == ';':
        words.pop()
    return parentheses


INCLUDE = re.compile(r"""\s*[$#]?(?:INSERT|INCLUDE)\s+(?:"([^"]+)"|'([^']+)'|([^;\s]+))\s*(?:;\s*(?:[*!]|REM\b).*)?""")


def branch_continuations(lines):
    # jpp joins the preceding line to a branch keyword, skipping comment lines.
    joined = set()
    previous = 0
    for n, line in enumerate(lines, 1):
        content = line.lstrip(' \t')
        if not content or content.startswith(('*', '!')):
            continue
        if re.match(r'(?:THEN|ELSE|LOCKED)(?:[ \t]|$)', content):
            joined.update(range(previous, n))
        previous = n
    return joined


def directive_error(token, message):
    raise Diagnostic(f"{token.path}:{token.line}:{token.column}: {message}")


def split_statements(tokens):
    start = 0
    separator = None
    for i, token in enumerate(tokens):
        if token.word == ';' and token.kind == 'symbol':
            yield separator, tokens[start:i]
            separator = token
            start = i + 1
    yield separator, tokens[start:]


def is_equate(statement):
    if not statement or statement[0].word not in ('EQU', 'EQUATE'):
        return False
    # EQU and EQUATE can also be assignment targets.
    return len(statement) == 1 or statement[1].word not in ASSIGNMENT_PREFIXES | {'('}


class Preprocessor:
    def __init__(self, directories, encoding='utf-8'):
        self.directories = directories
        self.encoding = encoding
        self.equates = {}

    def define(self, words):
        i = 1
        while i < len(words):
            name = words[i]
            if name.kind != 'name' or i + 2 >= len(words) or words[i + 1].word not in EQUATE_OPERATORS:
                directive_error(name, "expected EQUATE name TO expression")
            end = i + 2
            while end < len(words):
                if (words[end].word == ',' and end + 2 < len(words)
                        and words[end + 1].kind == 'name' and words[end + 2].word in EQUATE_OPERATORS):
                    break
                end += 1
            if end == i + 2:
                directive_error(name, "empty EQUATE expression")
            replacement = words[i + 2:end]
            literal = replacement[0]
            if (words[i + 1].word != 'TO' and len(replacement) == 1
                    and literal.kind == 'string' and literal.word[0] in "\"'"):
                replacement = [literal._replace(kind='equate_text')]
            self.equates[name.word] = replacement
            i = end + 1
        if len(words) == 1:
            directive_error(words[0], "missing EQUATE definition")

    def expand(self, words, stack=()):
        for i, token in enumerate(words):
            if token.kind == 'equate_text':
                replacement = []
                # Preserve the column within the quoted text, including for lexer errors.
                text = ' ' * token.column + token.word[1:-1]
                lex_line(text, token.line, token.path, replacement, 0)
                yield from self.expand(list(angle_tokens(replacement)), stack)
            elif token.kind == 'name' and token.word in self.equates:
                # The reference preprocessor skips EQUATE lookup for direct CALL names.
                if ((i > 0 and words[i - 1].word == 'CALL')
                        or (i > 1 and words[i - 1].kind == 'bang_prefix' and words[i - 2].word == 'CALL')):
                    yield token
                    continue
                if token.word in stack:
                    directive_error(token, f"recursive EQUATE '{token.word}'")
                yield from self.expand(self.equates[token.word], stack + (token.word,))
            else:
                yield token

    def expand_line(self, tokens):
        emitted = False
        for separator, statement in split_statements(tokens):
            if is_equate(statement):
                self.define(statement)
            elif statement:
                if emitted:
                    yield separator
                yield from self.expand(statement)
                emitted = True

    def read(self, path, parents=()):
        try:
            source = path.read_text(encoding=self.encoding)
        except UnicodeDecodeError as error:
            prefix = error.object[:error.start].decode(self.encoding)
            lines = prefix.replace('\r\n', '\n').replace('\r', '\n').split('\n')
            byte = error.object[error.start]
            raise SourceEncodingError(
                f"{path}:{len(lines)}:{len(lines[-1]) + 1}: invalid UTF-8 at byte 0x{byte:02x}"
            ) from error
        if '\0' in source:
            raise Diagnostic(f"{path}: NUL bytes in source are unsupported")
        words = []
        parentheses = 0
        lines = source.split('\n')
        joined = branch_continuations(lines)
        for n, line in enumerate(lines, 1):
            newline = Token('\n', 'newline', n, len(line) + 1, path)
            include = INCLUDE.fullmatch(line)
            if include and not words:
                name = next(group for group in include.groups() if group is not None)
                if self.encoding == 'latin-1':
                    name = os.fsdecode(name.encode(self.encoding))
                for directory in (path.parent, *self.directories):
                    child = directory / name
                    if child.is_file():
                        break
                else:
                    directive_error(newline._replace(column=1), f"include file '{name}' not found")
                ancestors = parents + (path.resolve(),)
                if child.resolve() in ancestors:
                    directive_error(newline._replace(column=1), f"recursive include '{name}'")
                yield from self.read(child, ancestors)
                continue
            parentheses = lex_line(line, n, path, words, parentheses)
            if words and words[-1].kind == 'symbol' and words[-1].word == ',':
                continue
            tokens = list(angle_tokens(words))
            yield from self.expand_line(tokens)
            if n not in joined:
                yield newline
            words = []
            parentheses = 0
        if words:
            last = list(split_statements(words))[-1][1]
            if is_equate(last):
                directive_error(words[-1], "unfinished EQUATE list")
            if parentheses or not any(token.kind == 'name' and token.word in ('CRT', 'DISPLAY', 'PRINT')
                                      for token in last):
                directive_error(words[-1], "unfinished comma continuation")
            yield from self.expand_line(list(angle_tokens(words)))
            yield newline
        if not parents:
            yield newline._replace(word='', kind='eof')


class Diagnostic(Exception):
    pass


class SourceEncodingError(UnicodeError):
    pass


def c_string(value, encoding='utf-8'):
    # Octal escapes have a fixed upper bound of three digits in C. Escaping
    # question marks also prevents trigraph substitution on C99 compilers.
    return '"' + ''.join(chr(b) if 32 <= b < 127 and b not in b'"\\?'
                         else '\\%03o' % b for b in value.encode(encoding, errors='surrogateescape')) + '"'


class CommonBlock:
    def __init__(self, field, token):
        self.field = field
        self.token = token
        self.shapes = []
        self.matrix_slots = {}
        self.initializers = []


class Matrix(NamedTuple):
    field: str
    shape: Optional[tuple]  # A caller supplies the shape of a MAT parameter.
    common_block: Optional[str] = None

    @property
    def base(self):
        if self.shape is None:
            return f"frame->{self.field}.values"
        return f"frame->{self.field}->values"

    @property
    def limits(self):
        if self.shape is None:
            return f"frame->{self.field}.bounds"
        if None in self.shape:
            return f"frame->{self.field}->bounds"
        return "(const int[]){" + ", ".join(map(str, self.shape)) + "}"

    @property
    def count(self):
        if self.shape is None:
            return f"frame->{self.field}.count"
        if None in self.shape:
            return f"frame->{self.field}->count"
        return math.prod(n + 1 for n in self.shape)

    @property
    def rank(self):
        return f"frame->{self.field}.rank" if self.shape is None else len(self.shape)

    def argument(self):
        if self.shape is None:
            return f"frame->{self.field}"
        return f"(jbc_matrix){{{self.base}, {self.limits}, {self.rank}, {self.count}}}"


def compatible_dimensions(a, b):
    return len(a) == len(b) and all(x is None or y is None or x == y for x, y in zip(a, b))


def constant_dimension(tokens, start, end):
    token = tokens[start]
    if (end == start + 1 and token.kind == 'number' and token.word.isdigit()
            and 0 < len(token.word) <= 9):
        return int(token.word)
    return None


def dimension_shape(tokens, opening):
    """Read the rank and literal bounds without evaluating any expressions."""
    stack = [')']
    shape = []
    start = opening + 1
    for i in range(start, len(tokens)):
        token = tokens[i]
        if token.kind == 'array_open':
            stack.append('>')
        elif token.word in ('(', '['):
            stack.append(')' if token.word == '(' else ']')
        elif token.word == stack[-1] and (token.word != '>' or token.kind == 'array_close'):
            stack.pop()
            if not stack:
                shape.append(constant_dimension(tokens, start, i))
                return tuple(shape), i + 1
        elif token.word == ',' and len(stack) == 1:
            shape.append(constant_dimension(tokens, start, i))
            start = i + 1
    return (), len(tokens) - 1


def matrix_declarations(tokens):
    """Index the first declaration of each member before generating code."""
    members = {}
    for i, opening in enumerate(tokens):
        if opening.kind != 'name' or opening.word not in ('DIM', 'DIMENSION', 'COM', 'COMMON'):
            continue
        if (i and tokens[i - 1].word not in ('\n', ';', 'THEN', 'ELSE', 'ERROR', 'LOCKED')
                and not (i > 1 and tokens[i - 1].word == ':' and is_label(tokens[i - 2], tokens[i - 1]))):
            continue
        i += 1
        block_name = None
        if opening.word in ('COM', 'COMMON'):
            block_name = ''
            if tokens[i].word == '/':
                i += 1
                if tokens[i].kind == 'name':
                    block_name = tokens[i].word
                    i += 1
                if tokens[i].word != '/':
                    continue
                i += 1
        while tokens[i].kind == 'name':
            member = tokens[i]
            i += 1
            shape = ()
            if tokens[i].word == '(':
                shape, i = dimension_shape(tokens, i)
            elif block_name is None:
                break
            members.setdefault(member.word, (member, shape, block_name))
            if tokens[i].word != ',':
                break
            i += 1
            while tokens[i].word == '\n':
                i += 1
    return ((token, shape, block) for token, shape, block in members.values() if shape)


