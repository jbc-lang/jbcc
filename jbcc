#!/usr/bin/env python3
"""Translate a subset of jBC to standalone C99."""
from typing import NamedTuple
import argparse
import math
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile


TOKEN = re.compile(r"""(?P<space>[ \t]+)|(?P<name>[A-Za-z][A-Za-z0-9._$]*)|(?P<number>[0-9]+(?:\.[0-9]*)?|\.[0-9]+)|(?P<string>"[^"]*"|'[^']*'|\\[^\\]*\\)|(?P<symbol>\+=|-=|.)""")
COMPARISONS = {"=": "==", "EQ": "==", "#": "!=", "<>": "!=", "NE": "!=",
               "LT": "<", "<": "<", "LE": "<=", "<=": "<=", "GT": ">",
               ">": ">", ">=": ">=", "GE": ">="}
PRECEDENCE = {op: 2 if cmp in ("==", "!=") else 3 for op, cmp in COMPARISONS.items()}
PRECEDENCE.update({"AND": 1, ":": 4, "+": 5, "-": 5, "*": 6, "/": 6})


BUILTINS = {"SPACE": (1,), "COS": (1,), "SIN": (1,), "INT": (1,), "SYSTEM": (1,), "CHAR": (1,), "LEN": (1,), "FIELD": (3, 4), "COUNT": (2,), "DCOUNT": (2,), "NOT": (1,)}


OUTPUT_END = {";", "\n", "ELSE", "WHILE", "UNTIL", "REPEAT", "NEXT"}


class Token(NamedTuple):
    word: str
    kind: str
    line: int
    column: int
    path: Path


def angle_tokens(words):
    # A tight postfix opening bracket with a matching close denotes extraction.
    # Classify it before joining comparison operators: REC<1>=X ends in ] =.
    openings = []
    for i, token in enumerate(words):
        prev = words[i - 1] if i else None
        if token.word == '<' and prev and prev.column + len(prev.word) == token.column:
            if prev.kind in ('name', 'number', 'string') or prev.word in (')', '>'):
                openings.append(i)
        elif token.word == '>' and openings and prev.word != '<':
            j = openings.pop()
            words[j] = words[j]._replace(kind='array_open')
            words[i] = token._replace(kind='array_close')
        elif token.word in (';', 'THEN', 'ELSE'):
            openings.clear()
    i = 0
    while i < len(words):
        token = words[i]
        i += 1
        if i < len(words) and token.kind == words[i].kind == 'symbol':
            pair = token.word + words[i].word
            if pair in ('<=', '>=', '<>') and words[i].column == token.column + 1:
                token = token._replace(word=pair)
                i += 1
        yield token


def lex_line(line, n, path):
    words = []
    at_start = True
    for match in TOKEN.finditer(line):
        word = match[0]
        if match.lastgroup == 'space':
            continue
        if at_start and word in ('*', '!', 'REM'):
            break
        kind = match.lastgroup
        if kind == 'name' and words and words[-1].word == '@':
            kind = 'system_name'
        words.append(Token(word, kind, n, match.start() + 1, path))
        at_start = word == ';'
    while words and words[-1].word == ';':
        words.pop()
    return list(angle_tokens(words))


INCLUDE = re.compile(r"""\s*[$#]?(?:INSERT|INCLUDE)\s+(?:"([^"]+)"|'([^']+)'|([^;\s]+))\s*(?:;\s*(?:[*!]|REM\b).*)?""")


def directive_error(token, message):
    raise Diagnostic(f"{token.path}:{token.line}:{token.column}: {message}")


class Preprocessor:
    def __init__(self, directories):
        self.directories = directories
        self.equates = {}

    def define(self, words):
        i = 1
        while i < len(words):
            name = words[i]
            if name.kind != 'name' or i + 2 >= len(words) or words[i + 1].word not in ('TO', 'LIT'):
                directive_error(name, "expected EQUATE name TO expression")
            end = i + 2
            while end < len(words):
                if (words[end].word == ',' and end + 2 < len(words)
                        and words[end + 1].kind == 'name' and words[end + 2].word in ('TO', 'LIT')):
                    break
                end += 1
            if end == i + 2:
                directive_error(name, "empty EQUATE expression")
            self.equates[name.word] = words[i + 2:end]
            i = end + 1
        if len(words) == 1:
            directive_error(words[0], "missing EQUATE definition")

    def expand(self, words, stack=()):
        for token in words:
            if token.kind == 'name' and token.word in self.equates:
                if token.word in stack:
                    directive_error(token, f"recursive EQUATE '{token.word}'")
                yield from self.expand(self.equates[token.word], stack + (token.word,))
            else:
                yield token

    def read(self, path, parents=()):
        source = path.read_text(encoding='utf-8')
        if '\0' in source:
            raise Diagnostic(f"{path}: NUL bytes in source are unsupported")
        pending = []
        for n, line in enumerate(source.split('\n'), 1):
            newline = Token('\n', 'newline', n, len(line) + 1, path)
            include = INCLUDE.fullmatch(line)
            if include and not pending:
                name = next(group for group in include.groups() if group is not None)
                for directory in (path.parent, *self.directories):
                    child = directory / name
                    if child.is_file():
                        break
                else:
                    directive_error(newline._replace(column=1), f"include file '{name}' not found")
                ancestors = parents + (path.resolve(),)
                if child.resolve() in ancestors:
                    directive_error(newline._replace(column=1), f"recursive include '{name}'")
                yield from self.read(child, ancestors)
                continue
            words = lex_line(line, n, path)
            if pending or (words and words[0].word in ('EQU', 'EQUATE')):
                pending.extend(words)
                if pending[-1].word == ',':
                    continue
                self.define(pending)
                pending = []
            else:
                yield from self.expand(words)
            yield newline
        if pending:
            directive_error(pending[-1], "unfinished EQUATE list")
        if not parents:
            yield newline._replace(word='', kind='eof')


class Diagnostic(Exception):
    pass


def c_string(value):
    # Octal escapes have a fixed upper bound of three digits in C. Escaping
    # question marks also prevents trigraph substitution on C99 compilers.
    return '"' + ''.join(chr(b) if 32 <= b < 127 and b not in b'"\\?'
                         else '\\%03o' % b for b in value.encode('utf-8')) + '"'


class CommonBlock:
    def __init__(self, field, token):
        self.field = field
        self.token = token
        self.shapes = []
        self.size = 0


class Compiler:
    def __init__(self, path, unit=0):
        self.path = path
        self.unit = unit
        self.routine = None
        self.is_function = False
        self.functions = set()
        self.formals = []
        self.labels = {}
        self.targets = {}
        self.calls = []
        self.references = []
        self.has_gosub = False
        self.names = {}
        self.matrices = {}
        self.local_arrays = {}
        self.commons = {}
        self.common_names = set()
        self.body = []
        self.temporaries = 0
        self.loops = 0
        self.trig = False
        self.terminal = False
        self.has_goto = False
        self.sets_precision = False

        self.depth = 0
        self.assigned = set()

    @property
    def word(self):
        return self.current.word

    def advance(self):
        self.current = self.following
        self.following = next(self.tokens, None)

    def expect(self, word):
        if self.word != word:
            self.error(f"expected '{word}'")
        self.advance()

    def error(self, message, token=None):
        token = token or self.current
        directive_error(token, message)

    def emit(self, line):
        self.body.append("    " * self.depth + line)

    def variable(self, name):
        if name in self.matrices:
            self.error(f"array '{name}' requires subscripts")
        if name not in self.names:
            self.names[name] = f"frame->v{len(self.names)}"
        return self.names[name]

    def read_variable(self, token):
        if token.word not in self.assigned and not self.has_gosub:
            self.error(f"unknown variable or unsupported function '{token.word}'", token)
        var = self.variable(token.word)
        return self.checked_read(var, token)

    def checked_read(self, var, token):
        read = f"jbc_read({var}, {c_string(token.word)}, {self.location(token)})"
        # A later function in the expression can change this variable by reference.
        return self.temporary(read) if self.functions else read

    def location(self, token):
        return f"{c_string(str(token.path))}, {token.line}, {token.column}"

    def primary(self):
        word = self.word
        if word == '-':
            operator = self.current
            self.advance()
            return self.arithmetic(operator, '"0"', self.primary(), '-')
        if word == '(':
            self.advance()
            value = self.expression()
            if self.word != ')':
                self.error("expected ')'")
        elif word == '@':
            target = self.current
            self.advance()
            if self.word == '(':
                self.terminal = True
                self.advance()
                code = self.expression()
                self.expect(')')
                return self.postfix(self.temporary(f"jbc_cursor({code}, {self.location(target)})"))
            marks = {'AM': 254, 'FM': 254, 'VM': 253, 'SM': 252}
            if self.word not in marks:
                self.error("expected a dynamic-array mark")
            value = '"\\%03o"' % marks[self.word]
        elif word in self.matrices:
            target = self.current
            self.advance()
            slot = self.matrix_slot(target)
            value = self.checked_read(slot, target)
            return self.postfix(value)
        elif word in self.functions and self.following.word == '(':
            target = self.identifier()
            args = self.call_arguments()
            self.calls.append((target, len(args), True))
            result = self.temporary("NULL")
            self.emit(f"{routine_symbol(word)}({', '.join(['&' + result] + args)});")
            return self.postfix(result)
        elif word in BUILTINS and self.following.word == '(':
            target = self.current
            self.advance()
            self.advance()
            args = []
            if self.word != ')':
                args.append(self.expression())
                while self.word == ',':
                    self.advance()
                    args.append(self.expression())
            if self.word != ')':
                self.error("expected ')' after function arguments")
            if len(args) not in BUILTINS[word]:
                self.error(f"wrong argument count for '{word}'", target)
            if word == 'FIELD':
                if len(args) == 3:
                    args.append('"1"')
            if word in ("SIN", "COS"):
                self.trig = True
            if word == "SYSTEM":
                self.terminal = True
            if word in ("CHAR", "FIELD", "SPACE", "INT", "SIN", "COS", "SYSTEM"):
                args.append(self.location(target))
            value = self.temporary(f"jbc_{word.lower()}({', '.join(args)})")
        elif self.current.kind == 'name':
            value = self.read_variable(self.current)
        elif self.current.kind == 'number':
            whole, dot, fraction = word.partition('.')
            fraction = fraction.rstrip('0')
            value = c_string((whole.lstrip('0') or '0') + (dot + fraction if fraction else ''))
        elif self.current.kind == 'string':
            value = c_string(word[1:-1])
        else:
            self.error("expected a variable, integer, string or parenthesized expression")
        self.advance()
        return self.postfix(value)

    def postfix(self, value):
        while self.current.kind == 'array_open' or self.word == '[':
            if self.word == '[':
                args = self.substring_indices()
                value = self.temporary(f"jbc_substring({value}, {args}, NULL)")
            else:
                indices = self.array_indices()
                value = self.temporary(f"jbc_array({value}, {indices}, NULL)")
        return value

    def substring_indices(self):
        token = self.current
        self.expect('[')
        start = self.expression()
        self.expect(',')
        length = self.expression()
        self.expect(']')
        return f"{start}, {length}, {self.location(token)}"

    def array_indices(self):
        token = self.current
        self.advance()
        indices = [self.expression()]
        while self.word == ',':
            self.advance()
            indices.append(self.expression())
        if self.current.kind != 'array_close' or len(indices) > 3:
            self.error("expected one to three dynamic-array indices", token)
        self.advance()
        return f'(const char *[]){{{", ".join(indices)}}}, {len(indices)}'

    def expression(self, minimum=1, output=False):
        return self.expression_tail(self.primary(), minimum, output)

    def expression_tail(self, left, minimum=1, output=False):
        while self.current.kind != 'array_close' and PRECEDENCE.get(self.word, 0) >= minimum:
            if output and self.word == ':' and self.following.word in OUTPUT_END:
                break
            operator = self.word
            token = self.current
            self.advance()
            right = self.expression(PRECEDENCE[operator] + 1, output)
            if operator in COMPARISONS:
                call = f'(jbc_compare({left}, {right}, jbc_precision) {COMPARISONS[operator]} 0 ? "1" : "0")'
            elif operator == 'AND':
                call = f'(jbc_truth({left}) && jbc_truth({right}) ? "1" : "0")'
            elif operator == ':':
                call = f"jbc_concat({left}, {right})"
            else:
                left = self.arithmetic(token, left, right, operator)
                continue
            left = self.temporary(call)
        return left

    def temporary(self, call):
        name = f"expr_{self.temporaries}"
        self.temporaries += 1
        self.emit(f"const char *{name} = {call};")
        return name

    def arithmetic(self, token, left, right, op):
        location = self.location(token)
        return self.temporary(f"jbc_arithmetic('{op}', {left}, {right}, {location})")

    def clause(self, opening):
        # A multiline arm ends at END. An inline arm ends at EOL or ELSE.
        self.depth += 1
        if self.word == '\n':
            self.advance()
            self.sequence({'END'}, opening)
            self.expect('END')
        else:
            self.sequence({'ELSE', '\n'}, opening)
        self.depth -= 1

    def conditional(self):
        opening = self.current
        self.advance()
        condition = self.expression()
        self.conditional_arms(opening, f"jbc_truth({condition})")

    def conditional_arms(self, opening, condition):
        if self.word not in ('THEN', 'ELSE'):
            self.error("expected THEN or ELSE")
        inverted = self.word == 'ELSE'
        self.advance()
        self.emit(f"if ({'!' if inverted else ''}{condition}) {{")
        before = self.assigned.copy()
        self.clause(opening)
        taken = self.assigned
        self.assigned = before
        if not inverted and self.word == 'ELSE':
            self.advance()
            self.emit("} else {")
            self.clause(opening)
        self.assigned = taken & self.assigned
        self.emit("}")

    def file_statement(self):
        opening = self.current
        self.advance()
        op = opening.word
        if op == 'OPEN':
            name = self.expression()
            self.expect('TO')
            target = self.identifier().word
            call = f"jbc_open_file({name}, &{self.variable(target)})"
            self.assigned.add(target)
        else:
            if op == 'READ':
                target = self.identifier().word
                self.expect('FROM')
            else:
                value = self.expression()
                if self.word not in ('ON', 'TO'):
                    self.error("expected ON or TO after WRITE value")
                self.advance()
            handle = self.expression()
            self.expect(',')
            key = self.expression()
            if op == 'READ':
                call = f"jbc_read_record({handle}, {key}, &{self.variable(target)})"
                self.assigned.add(target)
            else:
                call = f"jbc_write_record({handle}, {key}, {value})"
        if op == 'WRITE' and self.word not in ('THEN', 'ELSE'):
            self.emit(f'if (!{call}) numeric_error({self.location(opening)}, "WRITE failed");')
        else:
            self.conditional_arms(opening, call)

    def case_statement(self):
        opening = self.current
        self.advance()
        self.expect('CASE')
        while self.word in (';', '\n'):
            self.advance()
        before = self.assigned.copy()
        outcomes = []
        exhaustive = False
        self.emit("do {")
        self.depth += 1
        while self.word == 'CASE':
            self.advance()
            self.assigned = before.copy()
            condition = self.expression()
            self.emit(f"if (jbc_truth({condition})) {{")
            self.depth += 1
            self.sequence({'CASE', 'END'}, opening)
            if not exhaustive:
                outcomes.append(self.assigned)
                exhaustive = condition == '"1"'
            self.emit("break;")
            self.depth -= 1
            self.emit("}")
        if not outcomes:
            self.error("expected CASE clause", opening)
        self.expect('END')
        self.expect('CASE')
        self.depth -= 1
        self.emit("} while (0);")
        if not exhaustive:
            outcomes.append(before)
        self.assigned = set.intersection(*outcomes)

    def print_statement(self):
        self.advance()
        if self.word not in OUTPUT_END:
            while True:
                if self.word != ':':
                    self.emit(f"fputs({self.expression(output=True)}, stdout);")
                if self.word == ':':
                    self.advance()
                    return
                if self.word != ',':
                    break
                self.emit("putchar('\\t');")
                self.advance()
        self.emit("putchar('\\n');")

    def begin_loop(self):
        mark = f"loop_mark_{self.loops}"
        self.loops += 1
        self.emit(f"struct jbc_buffer *{mark} = buffers;")
        self.emit("for (;;) {")
        self.depth += 1
        return mark

    def end_loop(self, mark):
        self.emit(f"jbc_collect({mark}, live);")
        self.depth -= 1
        self.emit("}")
        self.emit(f"jbc_collect({mark}, live);")

    def guard(self):
        until = self.word == 'UNTIL'
        self.advance()
        condition = self.expression()
        self.emit(f"if ({'' if until else '!'}jbc_truth({condition})) break;")

    def for_statement(self):
        opening = self.current
        self.advance()
        counter = self.current
        if counter.kind != 'name':
            self.error("expected FOR variable")
        self.advance()
        self.expect('=')
        initial = self.expression()
        symbol = self.variable(counter.word)
        self.emit(f"{symbol} = {initial};")
        self.assigned.add(counter.word)
        self.expect('TO')
        mark = self.begin_loop()
        limit = self.expression()
        step = '"1"'
        if self.word == 'STEP':
            self.advance()
            # Capture even a plain variable before the loop body can change it.
            step = self.temporary(self.expression())
        location = self.location(opening)
        self.emit(f"if (!jbc_for_test({symbol}, {limit}, {step}, {location})) break;")
        if self.word in ('WHILE', 'UNTIL'):
            self.guard()
        if self.word not in (';', '\n'):
            self.error("expected statement separator after FOR")
        before = self.assigned.copy()
        self.sequence({'NEXT'}, opening)
        self.advance()
        if self.current.kind == 'name' and self.word not in OUTPUT_END:
            if self.word != counter.word:
                self.error(f"expected NEXT {counter.word}")
            self.advance()
        increment = self.arithmetic(opening, symbol, step, '+')
        self.emit(f"{symbol} = {increment};")
        self.end_loop(mark)
        self.assigned = before

    def loop_statement(self):
        opening = self.current
        self.advance()
        mark = self.begin_loop()
        exits = None
        while True:
            self.sequence({'WHILE', 'UNTIL', 'REPEAT'}, opening)
            if self.word == 'REPEAT':
                self.advance()
                break
            exits = self.assigned.copy() if exits is None else exits & self.assigned
            self.guard()
            if self.word == 'DO':
                self.advance()
        self.end_loop(mark)
        if exits is not None:
            self.assigned = exits

    def identifier(self):
        token = self.current
        if token.kind != 'name':
            self.error("expected a name")
        self.advance()
        return token

    def call_arguments(self):
        args = []
        if self.word == '(':
            self.advance()
            while self.word != ')':
                if self.word in self.matrices:
                    target_element = self.identifier()
                    slot = self.matrix_slot(target_element)
                    if self.word in (',', ')'):
                        args.append('&' + slot)
                    else:
                        value = self.postfix(self.checked_read(slot, target_element))
                        args.append('&' + self.temporary(self.expression_tail(value)))
                elif self.current.kind == 'name' and self.following.word in (',', ')'):
                    name = self.identifier().word
                    args.append('&' + self.variable(name))
                    self.assigned.add(name)
                else:
                    args.append('&' + self.temporary(self.expression()))
                if self.word != ',':
                    break
                self.advance()
                if self.word == ')':
                    self.error("expected call argument")
            self.expect(')')
        return args

    def call_statement(self):
        self.advance()
        target = self.identifier()
        args = self.call_arguments()
        self.calls.append((target, len(args), False))
        self.emit(f"{routine_symbol(target.word)}({', '.join(args)});")

    def label_number(self, name):
        return self.targets.setdefault(name, len(self.targets) + 1)

    def local_label(self):
        if self.current.kind not in ('name', 'number'):
            self.error("expected a label")
        token = self.current
        self.advance()
        return token

    def dimension_bounds(self):
        self.expect('(')
        bounds = []
        while True:
            if self.current.kind != 'number' or not self.word.isdigit() or len(self.word) > 9:
                self.error("expected a positive constant dimension")
            size = int(self.word)
            if not size:
                self.error("expected a positive constant dimension")
            bounds.append(size)
            if math.prod(n + 1 for n in bounds) > 2147483647:
                self.error("dimensioned array is too large")
            self.advance()
            if self.word != ',':
                break
            self.advance()
        self.expect(')')
        return tuple(bounds)

    def declaration(self):
        opening = self.current
        common = self.word in ('COM', 'COMMON')
        self.advance()
        if common:
            name = ''
            if self.word == '/':
                self.advance()
                if self.word != '/':
                    name = self.identifier().word
                self.expect('/')
            if name not in self.commons:
                self.commons[name] = CommonBlock(f"common{len(self.commons)}", opening)
            block = self.commons[name]
        while True:
            token = self.identifier()
            name = token.word
            if name in self.names or name in self.matrices:
                self.error(f"duplicate declaration of '{name}'", token)
            bounds = self.dimension_bounds() if self.word == '(' or not common else ()
            count = math.prod(n + 1 for n in bounds)
            if common:
                base = f"frame->{block.field} + {block.size}"
                block.shapes.append(bounds)
                block.size += count
                self.common_names.add(name)
                if not bounds:
                    self.names[name] = f"frame->{block.field}[{block.size - 1}]"
                    self.assigned.add(name)
            else:
                field = f"matrix{len(self.local_arrays)}"
                self.local_arrays[field] = count
                base = f"frame->{field}"
            if bounds:
                self.matrices[name] = (base, bounds)
            if self.word != ',':
                break
            self.advance()
            while self.word == '\n':
                self.advance()

    def matrix_slot(self, token):
        base, bounds = self.matrices[token.word]
        self.expect('(')
        subscripts = [self.expression()]
        while self.word == ',':
            self.advance()
            subscripts.append(self.expression())
        self.expect(')')
        if len(subscripts) != len(bounds):
            self.error(f"expected {len(bounds)} subscripts for '{token.word}'", token)
        limits = ", ".join(map(str, bounds))
        index = f"index_{self.temporaries}"
        self.temporaries += 1
        self.emit(f"size_t {index} = jbc_index({len(bounds)}, (const int[]){{{limits}}}, "
                  f"(const char *[]){{{', '.join(subscripts)}}}, {self.location(token)});")
        return f"({base})[{index}]"

    def statement(self):
        if (self.current.kind in ('name', 'number') and self.following.word == ':'
                and self.word not in ('CRT', 'PRINT')
                and self.following.column == self.current.column + len(self.word)):
            token = self.local_label()
            if self.depth:
                self.error("labels must be at routine scope", token)
            if token.word in self.labels:
                self.error("duplicate label", token)
            self.labels[token.word] = token
            self.expect(':')
            self.emit(f"label_{self.label_number(token.word)}: ;")
            if self.word not in (';', '\n'):
                self.statement()
        elif self.word == 'PRECISION':
            token = self.current
            self.advance()
            self.sets_precision = True
            self.emit(f"jbc_set_precision({self.expression()}, {self.location(token)});")
        elif self.word == 'DEFFUN':
            self.advance()
            self.functions.add(self.identifier().word)
            self.expect('(')
            if self.word != ')':
                self.scalar_parameter()
                while self.word == ',':
                    self.advance()
                    self.scalar_parameter()
            self.expect(')')
        elif self.word in ('DIM', 'DIMENSION', 'COM', 'COMMON'):
            self.declaration()
        elif self.word in ('GOSUB', 'GOTO'):
            jump = self.word == 'GOTO'
            self.advance()
            target = self.local_label()
            number = self.label_number(target.word)
            self.references.append(target)
            if jump:
                self.has_goto = True
                self.emit("jbc_collect(entry_mark, live);")
                self.emit(f"goto label_{number};")
            else:
                self.emit(f"body_{self.unit}(frame, {number});")
                if self.is_function:
                    self.emit("if (frame->result) return;")
        elif self.word == 'RETURN':
            self.advance()
            if self.is_function and self.word not in OUTPUT_END and self.word != '':
                if self.word == '(' and self.following.word == ')':
                    self.advance()
                    self.advance()
                    value = '""'
                else:
                    value = self.expression()
                self.emit(f"frame->result = {value};")
            self.emit("return;")
        elif self.word == 'STOP':
            self.advance()
            self.emit("exit(EXIT_SUCCESS);")
        elif self.word in ('OPEN', 'READ', 'WRITE'):
            self.file_statement()
        elif self.word == 'BEGIN':
            self.case_statement()
        elif self.word == 'CALL':
            self.call_statement()
        elif self.word == 'IF':
            self.conditional()
        elif self.word == 'FOR':
            self.for_statement()
        elif self.word == 'LOOP':
            self.loop_statement()
        elif self.word in ('CRT', 'PRINT'):
            self.print_statement()
        elif self.current.kind == 'name':
            start = self.current
            self.advance()
            matrix = start.word in self.matrices
            var = self.matrix_slot(start) if matrix else None
            indices = self.array_indices() if self.current.kind == 'array_open' else None
            substring = self.substring_indices() if self.word == '[' else None
            operator = self.current
            if self.word not in ('=', '+=', '-='):
                self.error(f"unsupported statement '{start.word}'", start)
            self.advance()
            value = self.expression()
            var = var or self.variable(start.word)
            base = f'({var} ? {var} : "")'
            if substring:
                if operator.word != '=':
                    self.error("expected '=' for substring replacement", operator)
                text = self.temporary(f"jbc_array({base}, {indices}, NULL)") if indices else base
                value = self.temporary(f"jbc_substring({text}, {substring}, {value})")
            if operator.word != '=':
                if not matrix and start.word not in self.assigned and not self.has_gosub:
                    self.error(f"unassigned variable '{start.word}'", start)
                old = self.temporary(f"jbc_array({base}, {indices}, NULL)") if indices else self.checked_read(var, start)
                value = self.arithmetic(operator, old, value, operator.word[0])
            if indices:
                value = self.temporary(f"jbc_array({base}, {indices}, {value})")
            self.emit(f"{var} = {value};")
            if not matrix:
                self.assigned.add(start.word)
        else:
            self.error("expected an assignment, CRT or IF")

    def sequence(self, stops, opening=None):
        while self.word not in stops:
            if self.word == '':
                self.error(f"unterminated {opening.word}", opening)
            if self.word in (';', '\n'):
                self.advance()
                continue
            self.statement()
            if self.word not in stops and self.word not in (';', '\n'):
                self.error(f"unexpected '{self.word}'")

    def scalar_parameter(self):
        if self.word == 'MAT':
            self.error("MAT parameters are unsupported")
        return self.identifier()

    def parse(self, tokens):
        self.has_gosub = any(t.word == 'GOSUB' for t in tokens)
        self.tokens = iter(tokens)
        self.following = next(self.tokens)
        self.advance()
        while self.word == '\n':
            self.advance()
        if self.word in ('SUBROUTINE', 'SUB', 'FUNCTION'):
            header = self.word
            self.is_function = header == 'FUNCTION'
            self.advance()
            self.routine = self.identifier()
            if self.word == '(':
                self.advance()
                while self.word != ')':
                    param = self.scalar_parameter()
                    if param.word in self.formals:
                        self.error("duplicate parameter", param)
                    i = len(self.formals)
                    self.formals.append(param.word)
                    self.names[param.word] = f"(*frame->arg{i})"
                    self.assigned.add(param.word)
                    if self.word != ',':
                        break
                    self.advance()
                    if self.word == ')':
                        self.error("expected parameter")
                self.expect(')')
            if self.word not in (';', '\n'):
                self.error(f"expected separator after {header} declaration")
        self.sequence({'', 'END'})
        if self.word == 'END':
            self.advance()
            while self.word in (';', '\n'):
                self.advance()
            if self.word:
                self.error("unexpected text after final END")
        for target in self.references:
            if target.word not in self.labels:
                self.error(f"unknown label '{target.word}'", target)

    def signature(self):
        if not self.routine:
            return "int main(void)"
        return routine_signature(self.routine.word, len(self.formals), self.is_function)

    def render(self, memory_files=()):
        u = self.unit
        fields = [f"const char **arg{i};" for i in range(len(self.formals))]
        if self.is_function:
            fields.append("const char *result;")
        fields += [f"const char *{var.split('->')[1]};" for name, var in self.names.items()
                   if name not in self.formals and name not in self.common_names]
        fields += [f"const char **{b.field};" for b in self.commons.values()]
        fields += [f"const char **{field};" for field in self.local_arrays]
        lines = [f"struct frame_{u} {{"] + ["    " + f for f in fields or ["char unused;"]] + ["};"]
        lines += [f"static void body_{u}(struct frame_{u} *frame, int entry)", "{"]
        lines += ["    (void)frame;", "    (void)entry;"]
        if self.has_goto:
            lines.append("    struct jbc_buffer *entry_mark = buffers;")
        if self.loops or self.has_goto:
            roots = ["&" + var for var in self.names.values()] + ["NULL"]
            lines.append("    const char **live[] = {" + ", ".join(roots) + "};")
        if self.labels:
            lines.append("    switch (entry) {")
            for name in self.labels:
                n = self.targets[name]
                lines.append(f"    case {n}: goto label_{n};")
            lines.append("    }")
        lines += ["    " + line for line in self.body]
        lines += ["}", self.signature(), "{", f"    struct frame_{u} frame = {{0}};"]
        for i in range(len(self.formals)):
            lines.append(f"    frame.arg{i} = arg{i};")
        for name, block in self.commons.items():
            lines.append(f"    frame.{block.field} = jbc_storage({block.size}, {c_string(name)});")
        for field, size in self.local_arrays.items():
            lines.append(f"    frame.{field} = jbc_storage({size}, NULL);")
        if not self.routine:
            for name in memory_files:
                lines.append(f"    jbc_create_memory_file({c_string(name)});")
        if self.routine and self.sets_precision:
            lines.append("    int saved_precision = jbc_precision;")
        lines.append(f"    body_{u}(&frame, 0);")
        if self.routine and self.sets_precision:
            lines.append("    jbc_precision = saved_precision;")
        if self.is_function:
            lines.append('    *result = frame.result ? frame.result : "";')
        for field in self.local_arrays:
            lines.append(f"    jbc_release(frame.{field});")
        if not self.routine:
            lines.extend(["    jbc_finish();", "    return 0;"])
        return "\n".join(lines + ["}", ""])


def routine_symbol(name):
    return "routine_" + name.encode("utf8").hex()


def routine_signature(name, argc, is_function):
    params = ["const char **result"] if is_function else []
    params.extend(f"const char **arg{i}" for i in range(argc))
    return f"void {routine_symbol(name)}({', '.join(params) or 'void'})"


def compile_unit(path, directories, index=0):
    unit = Compiler(path, index)
    unit.parse(list(Preprocessor(directories).read(path)))
    return unit


def compile_program(paths, directories, memory_files=()):
    units = []
    routines = {}
    programs = 0
    for i, path in enumerate(paths):
        unit = compile_unit(path, directories, i)
        units.append(unit)
        if unit.routine:
            name = unit.routine.word
            if name in routines:
                unit.error("duplicate routine", unit.routine)
            routines[name] = unit
        else:
            programs += 1
    if programs != 1:
        raise Diagnostic("expected one main program among the input files")
    layouts = {}
    for unit in units:
        for name, block in unit.commons.items():
            if layouts.setdefault(name, block.shapes) != block.shapes:
                unit.error(f"incompatible COMMON layout for /{name}/", block.token)
        for target, argc, is_function in unit.calls:
            if target.word not in routines or routines[target.word].is_function != is_function:
                kind = "function" if is_function else "subroutine"
                unit.error(f"unknown {kind} '{target.word}'", target)
            if argc != len(routines[target.word].formals):
                unit.error(f"wrong argument count for '{target.word}'", target)
    runtime = (Path(__file__).resolve().parent / 'runtime' / 'jbc.c').read_text()
    prototypes = [u.signature() + ";" for u in routines.values()]
    features = runtime_features(units)
    return "\n".join([features, runtime] + prototypes + [u.render(memory_files) for u in units])


def runtime_features(units):
    flags = []
    if any(unit.trig for unit in units):
        flags.append("#define JBC_TRIG 1")
    if any(unit.terminal for unit in units):
        flags.append("#define JBC_TERMINAL 1")
    return "\n".join(flags)


def build_executable(source, output):
    try:
        compiler = shlex.split(os.environ.get('CC') or 'cc')
        flags = shlex.split(os.environ.get('CC_FLAGS', ''))
    except ValueError as error:
        raise Diagnostic(f"invalid CC or CC_FLAGS: {error}") from error
    if not compiler:
        raise Diagnostic("CC must name a C compiler")
    # Linking beside the destination keeps the final rename atomic.
    with tempfile.TemporaryDirectory(dir=output.parent) as directory:
        c_file = Path(directory) / 'program.c'
        binary = Path(directory) / 'program'
        c_file.write_text(source, encoding='utf-8')
        libraries = ['-lm'] if source.startswith('#define JBC_TRIG 1\n') else []
        command = compiler + ['-std=c99', str(c_file)] + libraries + flags + ['-o', str(binary)]
        completed = subprocess.run(command)
        if completed.returncode:
            raise Diagnostic(f"C compiler exited with status {completed.returncode}")
        os.replace(binary, output)


def main():
    cli = argparse.ArgumentParser(description=__doc__)
    cli.add_argument('source', nargs='+', type=Path)
    cli.add_argument('--memory-file', dest='memory_files', action='append', default=[], metavar='NAME',
                     help='provide an empty named file in the in-memory test backend (repeatable)')
    cli.add_argument('-I', dest='directories', action='append', type=Path, default=[], metavar='DIR')
    cli.add_argument('--exe', action='store_true', help='build a native executable using CC and CC_FLAGS')
    cli.add_argument('-o', required=True, type=Path, metavar='OUTPUT')
    args = cli.parse_args()
    try:
        if any(args.o.resolve() == p.resolve() for p in args.source):
            raise Diagnostic("source and output paths must differ")
        result = compile_program(args.source, args.directories, args.memory_files)
        if args.exe:
            build_executable(result, args.o)
            return 0
        with tempfile.NamedTemporaryFile(dir=args.o.parent, delete=False, mode='w',
                                         encoding='utf-8') as output:
            try:
                output.write(result)
                output.close()
                os.replace(output.name, args.o)
            finally:
                if os.path.exists(output.name):
                    os.unlink(output.name)
    except (Diagnostic, OSError, UnicodeError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
