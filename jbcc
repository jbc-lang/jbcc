        self.depth = 0
        self.assigned = set()
        self.maybe_assigned = set()
        self.assignment_facts = {}
        self.statement_stops = set()
        self.omitted_concatenations = 0

    @property
    def word(self):
        return self.current.word

    @property
    def following(self):
        return self.tokens[0] if self.tokens else None

    def advance(self):
        self.current = self.tokens.popleft()

    def expect(self, word):
        if self.word != word:
            self.error(f"expected '{word}'")
        self.advance()

    def error(self, message, token=None):
        token = token or self.current
        directive_error(token, message)

    def emit(self, line):
        self.body.append("    " * self.depth + line)

    def variable(self, name):
        if name in self.matrices:
            self.error(f"array '{name}' requires subscripts")
        if name not in self.names:
            self.names[name] = f"frame->v{len(self.names)}"
        return self.names[name]

    def assignment_error(self, message, token):
        if not self.possible_go:
            self.error(message, token)
        if self.pending_assignment_error is None:
            self.pending_assignment_error = (message, token)

    def read_variable(self, token):
        if (token.word not in self.assigned and token.word not in self.maybe_assigned
                and not self.has_unstructured_jumps):
            self.assignment_error(f"unknown variable or unsupported function '{token.word}'", token)
        var = self.variable(token.word)
        return self.checked_read(var, token)

    def checked_read(self, var, token):
        read = f"jbc_read({var}.value, {c_string(token.word)}, {self.location(token)})"
        # Capture the value before a later operand can overwrite this slot.
        return self.temporary(read) if self.functions or self.has_expression_writes else read

    def location(self, token):
        return f"{c_string(str(token.path))}, {token.line}, {token.column}"

    def primary(self, locate_source=False):
        word = self.word
        if word in STEP_OPERATORS:
            return self.postfix(self.prefix_step(), locate_source)
        if word in ('-', '+'):
            operator = self.current
            self.advance()
            operand = self.expression(PRECEDENCE["*"], locate_source=locate_source)
            if word == '+':
                return operand
            return self.temporary(f"jbc_negate({operand}, {self.location(operator)})")
        if word == '(':
            self.advance()
            value = self.expression()
            if self.word != ')':
                self.error("expected ')'")
        elif word == '@':
            target = self.current
            self.advance()
            if self.word == '(':
                self.terminal = True
                self.advance()
                col = self.expression()
                row = "NULL"
                if self.word == ',':
                    self.advance()
                    row = self.expression()
                self.expect(')')
                cursor = self.temporary(f"jbc_cursor({col}, {row}, {self.location(target)})")
                return self.postfix(cursor, locate_source)
            if self.word == 'SYSTEM.RETURN.CODE':
                self.advance()
                return self.postfix(self.temporary("jbc_system_return_code()"), locate_source)
            if self.word == 'SELECTED':
                self.advance()
                return self.postfix(self.temporary("jbc_selected()"), locate_source)
            if self.word in RECORD_VARIABLES:
                slot = RECORD_VARIABLES[self.word]
                self.advance()
                return self.postfix(self.temporary(f"{slot}.value"), locate_source)
            if self.word in ('DATE', 'TIME'):
                self.uses_startup_clock = True
                function = f"jbc_startup_{self.word.lower()}"
                self.advance()
                value = self.temporary(f"{function}({self.location(target)})")
                return self.postfix(value, locate_source)
            if self.word == 'WHO':
                self.uses_session = True
                self.advance()
                return self.postfix(self.temporary("jbc_login_name()"), locate_source)
            if self.word in ('LOGNAME', 'ACCOUNT'):
                self.uses_session = True
                self.advance()
                return self.postfix(self.temporary("jbc_account_name()"), locate_source)
            if self.word in ('TERM.TYPE', 'TERM_TYPE', 'TERMTYPE'):
                self.uses_session = True
                self.advance()
                return self.postfix(self.temporary("jbc_terminal_type()"), locate_source)
            if self.word == 'TTY':
                self.uses_session = True
                self.advance()
                return self.postfix(self.temporary("jbc_terminal_name()"), locate_source)
            if self.word == 'LPTRHIGH':
                self.uses_report = True
                self.advance()
                return self.postfix(self.temporary("jbc_lptrhigh()"), locate_source)
            if self.word == 'PATH':
                self.uses_session = True
                self.advance()
                return self.postfix(self.temporary(f"jbc_account_path({self.location(target)})"), locate_source)
            if self.word == 'PID':
                self.uses_session = True
                self.advance()
                return self.postfix(self.temporary("jbc_process_id()"), locate_source)
            if self.word == 'USERSTATS':
                self.uses_session = True
                self.uses_userstats = True
                self.needs_arguments = True
                self.advance()
                call = f"jbc_userstats({self.location(target)})"
                return self.postfix(self.temporary(call), locate_source)
            if self.word in ('USERNO', 'USER.NO', 'USER_NO', 'UDTNO'):
                self.uses_session = True
                self.advance()
                value = self.temporary(f"jbc_port_number({self.location(target)})")
                return self.postfix(value, locate_source)
            if self.word in ('SENTENCE', 'COMMAND'):
                self.needs_arguments = True
                self.advance()
                return self.postfix("jbc_command_line", locate_source)
            if self.word not in SYSTEM_CONSTANTS:
                if self.current.kind in ('name', 'system_name'):
                    self.error(f"unsupported system variable '@{self.word}'")
                self.error("expected a system variable name")
            value = SYSTEM_CONSTANTS[self.word]
        elif word in self.matrices:
            target = self.current
            self.advance()
            slot = self.matrix_slot(target)
            return self.variable_expression(target, slot, locate_source)
        elif word in self.functions and self.following.word == '(':
            target = self.identifier()
            args, kinds = self.call_arguments()
            declared = self.functions[word]
            if declared and (any(declared) or any(kinds)) and kinds != declared:
                self.error(f"arguments disagree with DEFFUN for '{word}'", target)
            self.calls.append((target, kinds, True))
            result = self.temporary("NULL")
            self.emit(f"{routine_symbol(word)}({', '.join(['&' + result] + args)});")
            return self.postfix(result, locate_source)
        elif word == 'GETENV' and self.following.word == '(':
            self.advance()
            self.advance()
            name = self.expression()
            output = 'NULL'
            target = None
            if self.word == ',':
                self.advance()
                target = self.identifier()
                output = '&' + self.variable_slot(target)
            self.expect(')')
            value = self.temporary(f'jbc_getenv({name}, {output})')
            if target and target.word not in self.matrices:
                self.assigned.add(target.word)
                for truth in (True, False):
                    self.assignment_facts[value, truth] = {target.word}
            return self.postfix(value, locate_source)
        elif word == 'IOCTL' and self.following.word == '(':
            return self.postfix(self.ioctl_expression(), locate_source)
        elif word == 'REMOVE' and self.following.word == '(':
            return self.postfix(self.remove_expression(), locate_source)
        elif word == 'INDICES' and self.following.word == '(':
            opening = self.current
            self.advance()
            self.expect('(')
            target = self.identifier()
            if target.word in self.matrices:
                handle = self.checked_read(self.matrix_slot(target), target)
            else:
                handle = self.read_variable(target)
            index = 'NULL'
            if self.word == ',':
                self.advance()
                index = self.expression()
            self.expect(')')
            call = f"jbc_indices({handle}, {index}, {self.location(opening)})"
            return self.postfix(self.temporary(call), locate_source)
        elif word == 'INMAT' and self.following.word == '(':
            self.advance()
            self.expect('(')
            args = "0, NULL"
            if self.word != ')':
                matrix = self.checked_matrix(self.matrix_name())
                args = f"{matrix.rank}, {matrix.limits}"
            self.expect(')')
            return self.postfix(self.temporary(f"jbc_inmat({args})"), locate_source)
        elif word == 'READNEXT' and (self.following.kind == 'name' or self.following.word == '@'):
            call = self.readnext_call()
            return self.postfix(self.temporary(f'{call} ? "1" : "0"'), locate_source)
        elif word in ('ASSIGNED', 'UNASSIGNED') and self.following.word == '(':
            self.advance()
            self.expect('(')
            target = self.identifier()
            slot = self.variable_slot(target)
            self.expect(')')
            assigned = word == 'ASSIGNED'
            comparison = '!=' if assigned else '=='
            value = self.temporary(f'{slot}.value {comparison} NULL ? "1" : "0"')
            if target.word not in self.matrices:
                self.assignment_facts[value, assigned] = {target.word}
            return self.postfix(value, locate_source)
        elif word in ('INSERT', 'REPLACE') and self.following.word == '(':
            value = self.array_update_function()
            return self.postfix(value, locate_source)
        elif word in BUILTINS and self.following.word == '(':
            target = self.current
            self.advance()
            self.advance()
            args = []
            reuse_positions = REUSE_POSITIONS.get(word, ())
            reuse = [0, 0, 0]
            if self.word != ')':
                while True:
                    index = len(args)
                    if (word == 'FILEINFO' and index == 0 and self.current.kind == 'name'
                            and self.following.word == ',' and self.word not in self.matrices):
                        # A bare file variable can be unassigned when probed.
                        slot = self.variable(self.identifier().word)
                        args.append(self.temporary(f"{slot}.value"))
                    elif index in reuse_positions and self.is_reuse_call():
                        args.append(self.reuse_scalar(word))
                        reuse[index] = 1
                    else:
                        args.append(self.expression())
                    if self.word != ',':
                        break
                    self.advance()
            if self.word != ')':
                self.error("expected ')' after function arguments")
            if len(args) not in BUILTINS[word]:
                self.error(f"wrong argument count for '{word}'", target)
            args.extend(str(reuse[i]) for i in reuse_positions)
            if word in ('DELETE', 'EXTRACT'):
                indices = args[1:]
                args = [args[0], f"(const char *[]){{{', '.join(indices)}}}", str(len(indices))]
            if word in ('CHANGE', 'EREPLACE', 'SWAP'):
                if len(args) == 3:
                    args.append('"-1"')
                if len(args) == 4:
                    args.append('"1"')
                args.extend((str(int(word == 'EREPLACE')),
                             c_string(f"{word} requires integer occurrence arguments")))
                word = 'CHANGE'
            if word in ('FIELD', 'FIELDS', 'GROUP') and len(args) == 3:
                args.append('"1"')
            if word == 'GROUP':
                word = 'FIELD'
            if (word, len(args)) in (('DROUND', 1), ('SMUL', 2), ('SDIV', 2)):
                args.append('NULL')
            if word == 'COMPARE' and len(args) == 2:
                args.append('"L"')
            if word in ('TRIMS', 'TRIMBS', 'TRIMFS'):
                args.append({'TRIMS': "'R'", 'TRIMBS': "'E'", 'TRIMFS': "'F'"}[word])
                word = 'TRIM_ARRAY'
            if word in ('TRIMF', 'TRIMB'):
                args.extend(['" "', '"L"' if word == 'TRIMF' else '"T"'])
                word = 'TRIM'
            elif word == 'TRIM':
                if len(args) == 1:
                    args.append('" "')
                if len(args) == 2:
                    args.append('"R"')
            if word in ('MOD', 'REM'):
                args.append(c_string(f"{word} requires numeric operands"))
                word = 'MOD'
            if word in ("SIN", "COS", "PWR", "SQRT", "EXP", "LN"):
                self.uses_math = True
            if word == "CALLONEXIT":
                self.uses_callonexit = True
            if word == "PUTENV":
                self.uses_putenv = True
            if word == "SENTENCE":
                self.needs_arguments = True
                if not args:
                    args.append("NULL")
                args.append(self.location(target))
            if word in ("KEYIN", "IN"):
                self.terminal = True
                word = "KEYIN"
                args.append(self.location(target))
            if word == "SYSTEM":
                self.terminal = True
                self.uses_session = True
            if word in ("LN", "EXP", "SQRT", "PWR", "RND", "BITXOR", "DTX", "LATIN1", "DROUND", "MATCHFIELD", "COMPARE", "FILEINFO", "CHANGE", "DELETE", "EXTRACT", "TIMEDATE", "TIME", "DATE", "ITYPE", "ICONV", "ICONVS", "OCONV", "OCONVS", "TRIM", "ABS", "ABSS", "NEG", "NEGS", "ADDS", "SUBS", "MULS", "SMUL", "SDIV", "DIVS", "DIV", "MOD", "SUM", "SUMMATION", "LEFT", "RIGHT", "FOLD", "SUBSTRINGS", "CHAR", "FIELD", "FIELDS", "FMT", "FMTS", "INDEX", "SPACE", "SPACES", "STR", "INT", "SIN", "COS", "SYSTEM"):
                args.append(self.location(target))
            if word == 'LOWCASE':
                word = 'DOWNCASE'
            elif word == 'DQUOTE':
                word = 'QUOTE'
            elif word in ('BYTELEN', 'LENDP'):
                word = 'LEN'
            elif word == 'ISALPHA':
                word = 'ALPHA'
            elif word == 'COMPARE':
                word = 'COMPARE_STRINGS'
            value = self.temporary(f"jbc_{word.lower()}({', '.join(args)})")
            if word == 'NOT':
                for truth in (True, False):
                    if (args[0], truth) in self.assignment_facts:
                        self.assignment_facts[value, not truth] = self.assignment_facts[args[0], truth]
        elif word == 'IF' and word not in self.assigned:
            return self.postfix(self.conditional_expression(), locate_source)
        elif self.current.kind == 'name' and self.following.word in STEP_OPERATORS:
            target = self.identifier()
            return self.variable_expression(target, self.variable(target.word), locate_source)
        elif self.current.kind == 'name':
            value = self.read_variable(self.current)
        elif self.current.kind == 'number':
            whole, dot, fraction = word.partition('.')
            fraction = fraction.rstrip('0')
            value = c_string((whole.lstrip('0') or '0') + (dot + fraction if fraction else ''))
        elif self.current.kind == 'string':
            value = c_string(word[1:-1], self.encoding)
        else:
            self.error("expected a variable, integer, string or parenthesized expression")
        self.advance()
        return self.postfix(value, locate_source)

    def variable_expression(self, target, slot, locate_source=False):
        if self.word in STEP_OPERATORS:
            operator = self.current
            self.advance()
            value = self.step_value(target, operator, slot, postfix=True)
        else:
            value = self.checked_read(slot, target)
        return self.postfix(value, locate_source)

    def postfix(self, value, locate_source=False):
        while self.current.kind == 'array_open' or self.word == '[':
            if self.word == '[':
                location = self.location(self.current)
                args = self.bracket_arguments(1, 3)
                operands = ", ".join(args)
                if len(args) == 1:
                    value = self.temporary(f"jbc_right({value}, {operands}, {location})")
                elif len(args) == 2:
                    value = self.temporary(f"jbc_substring({value}, {operands}, {location}, NULL)")
                else:
                    value = self.temporary(f"jbc_field({value}, {operands}, {location})")
            else:
                if locate_source:
                    break
                indices = self.array_indices()
                value = self.temporary(f"jbc_array({value}, {indices}, NULL)")
        return value

    def bracket_arguments(self, minimum, maximum):
        self.expect('[')
        args = [self.expression()]
        while len(args) < minimum or (len(args) < maximum and self.word == ','):
            self.expect(',')
            args.append(self.expression())
        self.expect(']')
        return args

    def index_expressions(self):
        token = self.current
        self.advance()
        indices = [self.expression()]
        while self.word == ',':
            self.advance()
            indices.append(self.expression())
        if self.current.kind != 'array_close' or len(indices) > 3:
            self.error("expected one to three dynamic-array indices", token)
        self.advance()
        return indices

    def assignment_indices(self):
        if self.word != '<':
            return None
        if self.current.kind != 'array_open':
            # A spaced < on an assignment target opens a selector. Mark its
            # terminator before parsing the indices with expression precedence.
            depth = 0
            for i, token in enumerate(self.tokens):
                if (token.word in ('\n', '') or (depth == 0 and token.word in ('THEN', 'ELSE'))
                        or (token.word == ';' and token.kind == 'symbol')):
                    self.error("expected closing '>' for dynamic-array assignment")
                if token.kind == 'array_open' or token.word in ('(', '['):
                    depth += 1
                elif token.kind == 'array_close' or token.word in (')', ']'):
                    depth -= 1
                elif depth == 0 and token.word in ('>', '>='):
                    self.tokens[i] = token._replace(kind='array_close', word='>')
                    if token.word == '>=':
                        self.tokens.insert(i + 1, token._replace(word='=', column=token.column + 1))
                    break
        return self.array_indices()

    def array_indices(self):
        indices = self.index_expressions()
        return f'(const char *[]){{{", ".join(indices)}}}, {len(indices)}'

    def is_reuse_call(self):
        return (self.word == 'REUSE' and self.following.word == '('
                and 'REUSE' not in self.functions and 'REUSE' not in self.matrices)

    def reuse_scalar(self, context):
        wrapper = self.current
        self.advance()
        self.expect('(')
        scalar = self.expression()
        self.expect(')')
        message = c_string(f"REUSE in {context} requires a scalar")
        return self.temporary(f"jbc_reuse_scalar({scalar}, {message}, {self.location(wrapper)})")

    def expression(self, minimum=1, colon_stops=(), locate_source=False, format_stops=()):
        reuse_left = self.is_reuse_call()
        if reuse_left:
            wrapper = self.current
            left = self.reuse_scalar("multiplication")
            if self.word != '*' or minimum > PRECEDENCE['*']:
                self.error("REUSE requires a direct multiplication operand", wrapper)
        else:
            left = self.primary(locate_source)
        return self.expression_tail(left, minimum, colon_stops, locate_source, reuse_left, format_stops)

    def is_format_mask(self):
        if self.current.kind in ('string', 'number'):
            return True
        if self.current.kind != 'name' or self.word in FORMAT_BOUNDARIES:
            return False
        if self.following.word == '(':
            return self.word in self.matrices
        return self.word in self.names or self.has_unstructured_jumps

    def missing_concat_operand(self):
        if self.current.kind == 'array_close' or self.word in ('', ':', ',', ')', ']', ';', '\n'):
            return True
        if self.word in PRECEDENCE:
            return self.word not in ('+', '-')
        # IN with a parenthesized operand can also be a statement delimiter.
        if (self.word == 'IN' and self.following.word == '('
                and self.tokens[1].word == ')'):
            return False
        return (self.word in FORMAT_BOUNDARIES and self.word not in self.names
                and self.word not in self.matrices and self.word not in self.functions)

    def expression_tail(self, left, minimum=1, colon_stops=(), locate_source=False,
                        reuse_left=False, format_stops=()):
        while self.current.kind not in ('array_open', 'array_close'):
            operator = self.word
            token = self.current
            precedence = PRECEDENCE.get(operator)
            if precedence is None:
                if minimum > FORMAT_PRECEDENCE or operator in format_stops or not self.is_format_mask():
                    break
                mask = self.primary()
                left = self.temporary(f"jbc_fmt({left}, {mask}, {self.location(token)})")
                continue
            concatenating = operator in CONCATENATION
            if precedence < minimum or (concatenating and self.following.word in colon_stops):
                break
            self.advance()
            if concatenating and self.missing_concat_operand():
                self.omitted_concatenations += 1
                continue
            if operator in LOGICAL:
                left = self.logical_expression(left, operator, colon_stops, locate_source, format_stops)
                continue
            reuse_right = operator == '*' and self.is_reuse_call()
            if reuse_right:
                wrapper = self.current
                right = self.reuse_scalar("multiplication")
                if PRECEDENCE.get(self.word, 0) > precedence:
                    self.error("REUSE requires a direct multiplication operand", wrapper)
            else:
                right = self.expression(precedence + 1, colon_stops, locate_source, format_stops)
            if reuse_left or reuse_right:
                left = self.temporary(f"jbc_muls({left}, {right}, {int(reuse_left)}, "
                                      f"{int(reuse_right)}, {self.location(token)})")
                reuse_left = False
                continue
            if operator in COMPARISONS:
                call = f'(jbc_compare({left}, {right}, jbc_precision) {COMPARISONS[operator]} 0 ? "1" : "0")'
            elif operator in ('MATCH', 'MATCHES'):
                call = f"jbc_matches({left}, {right})"
            elif operator in ('^', '**'):
                self.uses_math = True
                call = f"jbc_pwr({left}, {right}, {self.location(token)})"
            elif concatenating:
                call = f"jbc_concat({left}, {right})"
            else:
                left = self.arithmetic(token, left, right, operator)
                continue
            left = self.temporary(call)
        return left

    def logical_expression(self, left, operator, colon_stops, locate_source, format_stops):
        result = self.temporary(f'jbc_truth({left}) ? "1" : "0"')
        evaluate_at = '0' if operator in ('OR', '!') else '1'
        self.emit(f"if (*{result} == '{evaluate_at}') {{")
        self.depth += 1
        # A call on the skipped path cannot definitely initialize an argument.
        before = self.assigned.copy()
        both = evaluate_at == '1'  # AND needs both true, OR needs both false.
        left_facts = self.assignment_facts.get((left, both), set())
        self.assigned.update(left_facts)
        right = self.expression(PRECEDENCE[operator] + 1, colon_stops, locate_source, format_stops)
        facts = left_facts | self.assignment_facts.get((right, both), set())
        if facts:
            self.assignment_facts[result, both] = facts
        self.assigned = before
        self.emit(f'{result} = jbc_truth({right}) ? "1" : "0";')
        self.depth -= 1
        self.emit("}")
        return result

    def conditional_expression(self):
        self.advance()
        condition = self.expression()
        self.expect('THEN')
        result = self.temporary("NULL")
        before = self.assigned.copy()
        self.emit(f"if (jbc_truth({condition})) {{")
        self.depth += 1
        self.assigned.update(self.assignment_facts.get((condition, True), ()))
        yes = self.expression()
        self.expect('ELSE')
        self.emit(f"{result} = {yes};")
        yes_assigned = self.assigned
        self.depth -= 1
        self.emit("} else {")
        self.depth += 1
        self.assigned = before.union(self.assignment_facts.get((condition, False), ()))
        # The reference grammar gives ELSE the left-associative precedence of ^.
        no = self.expression(PRECEDENCE['^'] + 1)
        self.emit(f"{result} = {no};")
        self.depth -= 1
        self.emit("}")
        no_assigned = self.assigned
        self.assigned = yes_assigned & no_assigned
        for truth in (True, False):
            yes_facts = yes_assigned.union(self.assignment_facts.get((yes, truth), ()))
            no_facts = no_assigned.union(self.assignment_facts.get((no, truth), ()))
            facts = (yes_facts & no_facts) - self.assigned
            if facts:
                self.assignment_facts[result, truth] = facts
        return result

    def temporary(self, call):
        name = f"expr_{self.temporaries}"
        self.temporaries += 1
        self.emit(f"const char *{name} = {call};")
        return name

    def arithmetic(self, token, left, right, op):
        location = self.location(token)
        return self.temporary(f"jbc_arithmetic('{op}', {left}, {right}, {location})")

    def clause(self, opening, inline_stops=None):
        # A multiline arm has its own END. An inline arm can also end
        # where the enclosing loop resumes.
        self.depth += 1
        if self.word == '\n':
            self.advance()
            self.sequence({'END'}, opening)
            self.expect('END')
        else:
            stops = (inline_stops or {'ELSE', '\n'}) | (self.statement_stops & LOOP_BOUNDARIES)
            self.sequence(stops, opening)
        self.depth -= 1

    def conditional(self):
        opening = self.current
        self.advance()
        condition = self.expression()
        self.conditional_arms(opening, f"jbc_truth({condition})", condition)

    def conditional_arms(self, opening, condition, expression=None, default_else=None):
        if opening.word == 'MATREAD' and self.word == 'LOCKED':
            self.error("MATREAD LOCKED requires a locking file backend")
        if self.word not in ('THEN', 'ELSE'):
            self.error("expected THEN or ELSE")
        inverted = self.word == 'ELSE'
        self.advance()
        self.emit(f"if ({'!' if inverted else ''}{condition}) {{")
        before = self.assigned.copy()
        before_maybe = self.maybe_assigned.copy()
        self.assigned.update(self.assignment_facts.get((expression, not inverted), ()))
        self.clause(opening)
        taken = self.assigned
        taken_maybe = self.maybe_assigned
        self.assigned = before
        self.maybe_assigned = before_maybe
        self.assigned.update(self.assignment_facts.get((expression, inverted), ()))
        if not inverted and self.word == 'ELSE':
            self.advance()
            self.emit("} else {")
            self.clause(opening)
        elif not inverted and default_else is not None:
            self.emit("} else {")
            self.depth += 1
            default_else()
            self.depth -= 1
        # A later guard can protect a read after conditional initialization.
        possible = taken | self.assigned
        if expression in ('""', '"0"', '"1"'):
            if (expression == '"1"') != inverted:
                possible, self.maybe_assigned = taken, taken_maybe
            else:
                possible = self.assigned
        else:
            self.maybe_assigned.update(taken_maybe)
        self.assigned = taken & self.assigned
        # CLEAR anticipates names even when no variable slot exists yet.
        self.maybe_assigned.update((possible - self.assigned) & self.names.keys())
        self.emit("}")

    def variable_slot(self, token):
        if token.word in self.matrices:
            return self.matrix_slot(token)
        return self.variable(token.word)

    def change_or_convert_statement(self):
        change = self.word != 'CONVERT'
        self.advance()
        search = self.expression()
        if change and self.word == 'WITH':
            self.advance()
        else:
            self.expect('TO')
        replacements = self.expression()
        self.expect('IN')
        target = self.identifier()
        slot = self.variable_slot(target)
        scalar = target.word not in self.matrices
        if (scalar and target.word not in self.assigned and target.word not in self.maybe_assigned
                and not self.has_unstructured_jumps):
            self.assignment_error(f"unassigned variable '{target.word}'", target)
        indices = self.array_indices() if self.current.kind == 'array_open' else None
        value = self.checked_read(slot, target)
        if indices:
            value = self.temporary(f"jbc_array({value}, {indices}, NULL)")
        if change:
            value = self.temporary(f"change_substrings({value}, {search}, {replacements}, -1, 1)")
        else:
            value = self.temporary(f"jbc_convert({value}, {search}, {replacements})")
        if indices:
            value = self.temporary(f"jbc_array({slot}.value, {indices}, {value})")
        self.emit(f"assign_value(&{slot}, {value});")
        if scalar:
            self.assigned.add(target.word)

    def array_update_function(self):
        target = self.current
        self.advance()
        self.expect('(')
        source = self.expression()
        self.expect(',')
        indices = [self.expression()]
        while self.word == ',' and len(indices) < 3:
            self.advance()
            indices.append(self.expression())
        if self.word == ',' and len(indices) == 3:
            self.advance()
        else:
            self.expect(';')
        value = self.expression()
        self.expect(')')
        positions = ", ".join(indices)
        inserting = int(target.word == 'INSERT')
        return self.temporary(f"jbc_update_array({source}, {value}, (const char *[]){{{positions}}}, "
                              f"{len(indices)}, {inserting}, {self.location(target)})")

    def ins_statement(self):
        self.advance()
        value = self.expression()
        self.expect('BEFORE')
        target = self.identifier()
        slot = self.variable_slot(target)
        if self.current.kind != 'array_open':
            self.error("expected dynamic-array indices after INS target")
        indices = self.array_indices()
        self.emit(f"jbc_ins(&{slot}, {value}, {indices}, {self.location(target)});")
        if target.word not in self.matrices:
            self.assigned.add(target.word)

    def del_statement(self):
        self.advance()
        target = self.identifier()
        slot = self.variable_slot(target)
        if target.word not in self.matrices and target.word not in self.assigned and not self.has_unstructured_jumps:
            self.assignment_error(f"unassigned variable '{target.word}'", target)
        if self.current.kind != 'array_open':
            self.error("expected dynamic-array indices after DEL target")
        indices = self.array_indices()
        self.emit(f"jbc_del(&{slot}, {indices}, {c_string(target.word)}, {self.location(target)});")

    def remove_source_slot(self, source):
        if (source.word not in self.matrices and source.word not in self.assigned
                and source.word not in self.maybe_assigned and not self.has_unstructured_jumps):
            self.assignment_error(f"unassigned variable '{source.word}'", source)
        return self.variable_slot(source)

    def remove_expression(self):
        self.advance()
        self.expect('(')
        token = self.current
        if self.word in self.matrices:
            slot = self.matrix_slot(self.identifier())
            if self.word == ',':
                source = '&' + slot
            else:
                value = self.expression_tail(self.postfix(self.checked_read(slot, token)))
                source = self.value_argument(value)
        elif token.kind == 'name' and self.following.word == ',':
            source = '&' + self.remove_source_slot(self.identifier())
        else:
            source = self.value_argument(self.expression())
        self.expect(',')
        status = self.identifier()
        setting = self.variable_slot(status)
        self.expect(')')
        if status.word not in self.matrices:
            self.assigned.add(status.word)
        return self.temporary(f"jbc_remove(NULL, {source}, &{setting}, "
                              f"{c_string(token.word)}, {self.location(token)})")

    def remove_statement(self):
        self.advance()
        target = self.identifier()
        out = self.variable_slot(target)
        self.expect('FROM')
        source = self.identifier()
        array = self.remove_source_slot(source)
        self.expect('SETTING')
        status = self.identifier()
        setting = self.variable_slot(status)
        self.emit(f"jbc_remove(&{out}, &{array}, &{setting}, "
                  f"{c_string(source.word)}, {self.location(source)});")
        self.assigned.update((target.word, status.word))

    def find_statement(self):
        opening = self.current
        self.advance()
        needle = self.expression()
        self.expect('IN')
        source = self.expression()
        occurrence = '"1"'
        if self.word == ',':
            self.advance()
            occurrence = self.expression()
        self.expect('SETTING')
        slots = []
        targets = []
        while True:
            target = self.identifier()
            slots.append('&' + self.variable_slot(target))
            targets.append(target.word)
            if self.word != ',':
                break
            if len(slots) == 3:
                self.error(f"{opening.word} accepts at most three SETTING variables")
            self.advance()
        slots.extend(['NULL'] * (3 - len(slots)))
        # A miss leaves the slots untouched. Reads still check them at runtime.
        self.assigned.update(targets)
        substring = int(opening.word == 'FINDSTR')
        call = (f"jbc_find({substring}, {needle}, {source}, {occurrence}, {', '.join(slots)}, "
                f"{self.location(opening)})")
        self.conditional_arms(opening, call)

    def locate_statement(self):
        opening = self.current
        self.advance()
        needle = self.expression()
        self.expect('IN')
        source = self.expression(locate_source=True)
        indices = []
        start = None
        if self.current.kind == 'array_open':
            indices = self.index_expressions()
            if len(indices) == 3:
                start = indices.pop()
            args = ', '.join(indices)
            source = self.temporary(f"jbc_array({source}, (const char *[]){{{args}}}, {len(indices)}, NULL)")
        if self.word == ',':
            if start is not None:
                self.error("LOCATE with both a subvalue start and a separate start is unsupported")
            self.advance()
            start = self.expression()
        if start is None:
            start = '"1"'
        order = '""'
        if self.word == 'BY':
            self.advance()
            order = self.expression()
        self.expect('SETTING')
        target = self.identifier()
        if target.word in self.matrices:
            slot = self.matrix_slot(target)
        else:
            slot = self.variable(target.word)
            self.assigned.add(target.word)
        call = (f"jbc_locate({needle}, {source}, {254 - len(indices)}, {start}, "
                f"{order}, &{slot}, {self.location(opening)})")
        self.conditional_arms(opening, call)

    def delete_statement(self):
        opening = self.current
        self.advance()
        handle, key = self.file_key()
        setting = self.file_setting()
        self.file_error_arm(opening, f"jbc_delete_record({handle}, {key}, {setting})", setting)

    def clearfile_statement(self):
        opening = self.current
        self.advance()
        handle = "jbc_default_file.value"
        if self.word not in OUTPUT_END and self.word not in ('', 'SETTING', 'ON', 'LOCKED'):
            target = self.identifier()
            if target.word in self.matrices:
                handle = self.checked_read(self.matrix_slot(target), target)
            else:
                handle = self.read_variable(target)
        setting = self.file_setting()
        before = self.assigned.copy()
        self.emit(f"switch (jbc_clear_file({handle}, {setting})) {{")
        self.emit("case 0: break;")
        self.emit("default: {")
        if self.word == 'ON':
            self.advance()
            self.expect('ERROR')
            self.clause(opening, {'LOCKED', 'ELSE', '\n'})
            self.assigned = before.copy()
        elif setting == "NULL":
            self.emit(f'    numeric_error({self.location(opening)}, "CLEARFILE failed");')
        self.emit("    break;")
        self.emit("}")
        if self.word == 'LOCKED':
            self.advance()
            self.emit("case JBC_LOCKED: {")
            self.emit("    file_result(JBC_LOCKED);")
            if setting != "NULL":
                self.emit(f'    assign_value({setting}, "-2");')
            self.clause(opening)
            self.emit("    break;")
            self.emit("}")
            self.assigned = before
        self.emit("}")

    def file_error_arm(self, opening, call, setting):
        if self.word == 'ON':
            self.advance()
            self.expect('ERROR')
            self.emit(f"if (!{call}) {{")
            before = self.assigned.copy()
            self.clause(opening)
            self.assigned &= before
            self.emit("}")
        elif setting == "NULL":
            self.emit(f'if (!{call}) numeric_error({self.location(opening)}, "{opening.word} failed");')
        else:
            self.emit(f"{call};")

    def file_setting(self):
        setting = "NULL"
        if self.word == 'SETTING':
            self.advance()
            target = self.identifier()
            setting = '&' + self.variable_slot(target)
            self.assigned.add(target.word)
        return setting

    def callj_statement(self):
        opening = self.current
        self.advance()
        class_name = self.temporary(self.expression())
        self.expect(',')
        method = self.temporary(self.expression())
        self.expect(',')
        argument = self.temporary(self.expression())
        self.expect('SETTING')
        target = self.identifier()
        result = '&' + self.variable_slot(target)
        self.assigned.add(target.word)
        call = f"jbc_callj({class_name}, {method}, {argument}, {result}, {self.location(opening)})"
        self.file_error_arm(opening, call, result)

    def transaction_statement(self):
        opening = self.current
        self.advance()
        sync = opening.word == 'TRANSTART' and self.word == 'SYNC'
        if sync:
            self.advance()
        note = 'NULL'
        if self.word not in OUTPUT_END and self.word not in ('', 'THEN'):
            note = self.expression()
        message = c_string(f"{opening.word} requires a transaction backend")
        call = f"jbc_transaction({int(sync)}, {note}, {self.location(opening)}, {message})"
        self.conditional_arms(opening, call)

    def execute_statement(self, stops):
        opening = self.current
        self.advance()
        self.uses_execute = True
        clauses = ('CAPTURING', 'RETURNING', 'SETTING', 'RTNLIST')
        command = self.expression(format_stops=clauses)
        outputs = {}
        assigned = []
        while self.word in clauses:
            clause = 'RETURNING' if self.word == 'SETTING' else self.word
            if clause in outputs:
                self.error(f"duplicate {clause} clause")
            self.advance()
            if clause == 'RTNLIST':
                if not self.word or self.word in OUTPUT_END or self.word in stops or self.word in clauses:
                    outputs[clause] = "&select_lists[0]"
                    continue
                if self.current.kind in ('number', 'string'):
                    outputs[clause] = self.value_argument(self.primary())
                    continue
            target = self.identifier()
            outputs[clause] = '&' + self.variable_slot(target)
            assigned.append(target.word)
        self.assigned.update(assigned)
        self.emit(f"jbc_execute({command}, {outputs.get('CAPTURING', 'NULL')}, "
                  f"{outputs.get('RETURNING', 'NULL')}, {outputs.get('RTNLIST', 'NULL')}, "
                  f"{self.location(opening)});")

    def tape_unit(self):
        if self.word != 'UNIT':
            return None
        self.advance()
        self.expect('(')
        unit = self.expression()
        self.expect(')')
        return unit

    def tape_channel(self, unit, keywords=('ON', 'FROM')):
        if self.word not in keywords:
            return unit if unit is not None else '"0"'
        self.advance()
        if unit is None:
            return self.expression()
        # The reference generator uses UNIT in preference to a trailing channel.
        self.ignored_expression()
        return unit

    def ignored_expression(self):
        before = self.assigned.copy()
        self.emit("if (0) {")
        self.depth += 1
        self.emit(f"(void){self.expression()};")
        self.depth -= 1
        self.emit("}")
        self.assigned = before

    def tape_statement(self):
        opening = self.current
        self.advance()
        unit = self.tape_unit()
        if opening.word == 'READT':
            target = self.identifier()
            slot = self.variable_slot(target)
            channel = self.tape_channel(unit)
            self.assigned.add(target.word)
            call = f"jbc_readt(&{slot}, {channel}, {self.location(opening)})"
        elif opening.word == 'WRITET':
            record = self.temporary(self.expression())
            channel = self.tape_channel(unit, ('ON', 'TO', 'FROM'))
            call = f"jbc_writet({record}, {channel}, {self.location(opening)})"
        else:
            channel = self.tape_channel(unit)
            call = f"jbc_{opening.word.lower()}({channel}, {self.location(opening)})"
        self.conditional_arms(opening, call)

    def sequential_statement(self):
        opening = self.current
        op = opening.word
        self.advance()
        self.uses_sequential = True
        if op in ('OPENSEQ', 'OPENDEV', 'OSOPEN'):
            osopen = op == 'OSOPEN'
            existing = self.word == 'EXISTING'
            if existing:
                self.advance()
            append = self.word == 'APPEND'
            if append:
                self.advance()
            path = self.expression()
            name = 'NULL'
            if self.word == ',':
                self.advance()
                path = self.temporary(path)
                name = self.expression()
            mode = 'SEQ_READ_WRITE'
            if self.word == 'READONLY' or (osopen and self.word == 'WRITEONLY'):
                mode = 'SEQ_READ_ONLY' if self.word == 'READONLY' else 'SEQ_WRITE_ONLY'
                self.advance()
            self.expect('TO')
            target = self.identifier()
            slot = self.variable_slot(target)
            self.assigned.add(target.word)
            call = f'jbc_openseq({path}, {name}, {int(existing)}, {int(append)}, {mode}, {int(osopen)}, &{slot})'
        elif op in ('READSEQ', 'READBLK'):
            target = self.identifier()
            slot = self.variable_slot(target)
            self.expect('FROM')
            handle = self.expression()
            self.assigned.add(target.word)
            if op == 'READBLK':
                self.expect(',')
                size = self.expression()
                call = f'jbc_readblk({handle}, {size}, &{slot}, {self.location(opening)})'
            else:
                call = f'jbc_readseq({handle}, &{slot})'
        elif op == 'OSBREAD':
            target, slot = self.record_read_destination()
            self.expect('FROM')
            handle = self.temporary(self.expression(format_stops=('AT', 'LENGTH')))
            offset = 'NULL'
            if self.word == 'AT':
                self.advance()
                offset = self.temporary(self.expression(format_stops=('LENGTH',)))
            self.expect('LENGTH')
            length = self.expression()
            if target is not None:
                self.assigned.add(target)
            call = f'jbc_osbread({handle}, {offset}, {length}, &{slot})'
        elif op == 'OSBWRITE':
            value = self.temporary(self.expression())
            if self.word not in ('ON', 'TO'):
                self.error("expected ON or TO after OSBWRITE value")
            self.advance()
            handle = self.temporary(self.expression(format_stops=('AT', 'NODELAY')))
            offset = 'NULL'
            if self.word == 'AT':
                self.advance()
                offset = self.expression(format_stops=('NODELAY',))
            nodelay = self.word == 'NODELAY'
            if nodelay:
                self.advance()
            call = f'jbc_osbwrite({handle}, {offset}, {value}, {int(nodelay)})'
        elif op == 'OSWRITE':
            value = self.temporary(self.expression())
            append = self.word == 'APPEND'
            if append:
                self.advance()
            if self.word not in ('ON', 'TO'):
                self.error("expected ON or TO after OSWRITE value")
            self.advance()
            path = self.expression()
            call = f'jbc_oswrite({path}, {value}, {int(append)})'
        elif op == 'OSDELETE':
            path = self.expression()
            call = f'jbc_osdelete({path})'
        elif op == 'TTYGET':
            target = self.identifier()
            slot = self.variable_slot(target)
            self.expect('FROM')
            handle = self.expression()
            self.assigned.add(target.word)
            call = f'jbc_ttyget({handle}, &{slot})'
        elif op == 'TTYSET':
            value = self.temporary(self.expression())
            self.expect('ON')
            handle = self.expression()
            call = f'jbc_ttyset({handle}, {value})'
        elif op == 'OSREAD':
            target, slot = self.record_read_destination()
            self.expect('FROM')
            path = self.expression()
            if target is not None:
                self.assigned.add(target)
            call = f'jbc_osread({path}, &{slot})'
        elif op == 'TIMEOUT':
            handle = self.temporary(self.expression())
            self.expect(',')
            seconds = self.expression()
            self.emit(f'jbc_timeout({handle}, {seconds}, {self.location(opening)});')
            return
        elif op == 'SEEK':
            handle = self.expression()
            offset = origin = '"0"'
            if self.word == ',':
                self.advance()
                offset = self.expression()
                if self.word == ',':
                    self.advance()
                    origin = self.expression()
            call = f'jbc_seek({handle}, {offset}, {origin}, {self.location(opening)})'
        elif op == 'CREATE':
            call = f'jbc_createseq({self.expression()}, {self.location(opening)})'
        elif op == 'FLUSH':
            call = f'jbc_flushseq({self.expression()}, {self.location(opening)})'
        elif op == 'NOBUF':
            call = f'jbc_nobuf({self.expression()})'
        elif op == 'WEOFSEQ':
            target = self.identifier()
            if target.word in self.matrices:
                handle = self.checked_read(self.matrix_slot(target), target)
            else:
                handle = self.read_variable(target)
            call = f'jbc_weofseq({handle})'
        elif op in ('CLOSESEQ', 'OSCLOSE'):
            target = self.identifier()
            slot = self.variable_slot(target)
            call = f'jbc_closeseq(&{slot})'
            if op == 'OSCLOSE' and self.word == 'ON':
                self.advance()
                self.expect('ERROR')
                before = self.assigned.copy()
                self.emit(f"if (!{call}) {{")
                self.clause(opening)
                self.assigned &= before
                self.emit("}")
            elif self.word in ('THEN', 'ELSE'):
                self.conditional_arms(opening, call)
            else:
                self.emit(f'if (!{call}) numeric_error({self.location(opening)}, "{op} failed");')
            return
        else:
            value = self.expression()
            append = op != 'WRITEBLK' and self.word == 'APPEND'
            if append:
                self.advance()
            if self.word not in ('ON', 'TO'):
                self.error(f"expected ON or TO after {op} value")
            self.advance()
            handle = self.expression()
            if op == 'WRITEBLK':
                call = f'jbc_writeblk({handle}, {value}, {self.location(opening)})'
            else:
                call = f"jbc_writeseq({handle}, {value}, {int(append)}, {int(op == 'WRITESEQF')})"
        setting = self.file_setting()
        status = f'seq_status_{self.temporaries}'
        self.temporaries += 1
        self.emit(f'int {status} = {call};')
        if setting != 'NULL':
            self.emit(f'jbc_seq_setting({setting}, {status});')
        if op in ('OSBREAD', 'OSBWRITE', 'OSWRITE', 'OSDELETE'):
            self.file_error_arm(opening, f"!{status}", 'NULL')
        elif op in ('CREATE', 'SEEK'):
            self.conditional_arms(opening, f"!{status}")
        else:
            self.record_read_arms(opening, status, setting)

    def record_read_destination(self):
        if self.word == '@':
            self.advance()
            if self.word not in RECORD_VARIABLES:
                self.error("expected @ID, @RECORD or @FILENAME as a record read destination")
            slot = RECORD_VARIABLES[self.word]
            self.advance()
            return None, slot
        target = self.identifier()
        return target.word, self.variable_slot(target)

    def readv_statement(self):
        opening = self.current
        self.advance()
        target, out = self.record_read_destination()
        self.expect('FROM')
        handle, key, field = self.field_file_key()
        setting = self.file_setting()
        status = f"readv_status_{self.temporaries}"
        self.temporaries += 1
        update = int(opening.word == 'READVU')
        self.emit(f"int {status} = jbc_read_field({handle}, {key}, {field}, &{out}, "
                  f"{setting}, {update}, {self.location(opening)});")
        if target is not None:
            self.assigned.add(target)
        self.record_read_arms(opening, status)

    def matrix_file_statement(self):
        opening = self.current
        self.advance()
        target = self.matrix_name()
        matrix = self.checked_matrix(target)
        writing = opening.word == 'MATWRITE'
        if writing:
            if self.word not in ('TO', 'ON'):
                self.error("expected TO or ON after MATWRITE matrix")
            self.advance()
        else:
            self.expect('FROM')
        handle, key = self.file_key()
        setting = self.file_setting()
        args = f"{handle}, {key}, {matrix.base}, {matrix.rank}, {matrix.limits}"
        if not writing:
            status = f"matread_status_{self.temporaries}"
            self.temporaries += 1
            update = int(opening.word == 'MATREADU')
            self.emit(f"int {status} = jbc_matread({args}, {matrix.count}, {setting}, {update});")
            self.record_read_arms(opening, status)
            return
        call = f"jbc_matwrite({args}, {setting}, {c_string(target.word)}, {self.location(opening)})"
        if self.word == 'ON':
            self.advance()
            self.expect('ERROR')
            status = f"matwrite_status_{self.temporaries}"
            self.temporaries += 1
            self.emit(f"int {status} = {call};")
            self.emit(f"if ({status} != 0 && {status} != 128) {{")
            before = self.assigned.copy()
            self.clause(opening)
            self.assigned &= before
            self.emit("}")
        elif setting == "NULL":
            self.emit(f'if ({call}) numeric_error({self.location(opening)}, "MATWRITE failed");')
        else:
            self.emit(f"{call};")

    def file_key(self):
        key = self.expression()
        if self.word == ',':
            self.advance()
            return key, self.expression()
        return "jbc_default_file.value", key

    def field_file_key(self):
        key = self.expression()
        self.expect(',')
        field = self.expression()
        handle = "jbc_default_file.value"
        if self.word == ',':
            self.advance()
            handle, key, field = key, field, self.expression()
        return handle, key, field

    def read_record_statement(self):
        opening = self.current
        self.advance()
        target, out = self.record_read_destination()
        self.expect('FROM')
        handle, key = self.file_key()
        setting = self.file_setting()
        update = opening.word == 'READU'
        if update and self.word == 'WAIT':
            self.error("READU WAIT requires a backend with timed locks")
        status = f"read_status_{self.temporaries}"
        self.temporaries += 1
        function = 'jbc_readu' if update else 'jbc_read_record'
        self.emit(f"int {status} = {function}({handle}, {key}, &{out}, {setting});")
        if target is not None:
            self.assigned.add(target)
        self.record_read_arms(opening, status)

    def record_read_arms(self, opening, status, setting="NULL"):
        before = self.assigned.copy()
        branches = []
        if self.word == 'ON':
            self.advance()
            self.expect('ERROR')
            self.emit(f"if ({status} > 128) {{")
            self.clause(opening, {'LOCKED', 'THEN', 'ELSE', '\n'})
            branches.append(self.assigned)
            self.assigned = before.copy()
            self.emit("} else {")
            self.depth += 1
        elif opening.word == 'OSREAD':
            self.emit(f'if ({status} > 128) numeric_error({self.location(opening)}, "OSREAD failed");')
        sequential_open = opening.word in ('OPENSEQ', 'OPENDEV', 'OSOPEN')
        if sequential_open or opening.word in ('READU', 'READVU', 'MATREADU', 'RECORDLOCKU'):
            if self.word == 'LOCKED':
                self.advance()
                self.emit(f"if ({status} == JBC_LOCKED) {{")
                self.clause(opening, {'THEN', 'ELSE', '\n'})
                branches.append(self.assigned)
                self.assigned = before.copy()
                self.emit("} else {")
                self.depth += 1
            elif not sequential_open:
                self.emit(f'if ({status} == JBC_LOCKED) numeric_error({self.location(opening)}, '
                          f'"{opening.word} cannot wait for a simulated foreign lock");')
        if opening.word in ('WEOFSEQ', 'FLUSH', 'NOBUF', 'RECORDLOCKU') and self.word not in ('THEN', 'ELSE'):
            if setting == 'NULL':
                self.emit(f'if ({status}) numeric_error({self.location(opening)}, "{opening.word} failed");')
        else:
            self.conditional_arms(opening, f"!{status}")
        for branch in reversed(branches):
            self.depth -= 1
            self.emit("}")
            self.assigned &= branch

    def select_list(self, keyword):
        if self.word != keyword:
            return "&select_lists[0]"
        self.advance()
        return self.list_operand(assigning=keyword == 'TO')

    def list_operand(self, assigning=False, maximum=10):
        if self.current.kind == 'number':
            number = self.word.lstrip('0') or '0'
            if not number.isdigit() or len(number) > 2 or int(number) > maximum:
                self.error(f"select list number must be between 0 and {maximum}")
            self.advance()
            return f"&select_lists[{number}]"
        target = self.identifier()
        slot = self.variable_slot(target)
        if assigning:
            self.assigned.add(target.word)
        return '&' + slot

    def clearselect_statement(self):
        opening = self.current
        self.advance()
        slot = "&select_lists[0]"
        if self.word and self.word not in OUTPUT_END:
            slot = self.list_operand(maximum=11)
        self.emit(f"jbc_clearselect({slot}, {self.location(opening)});")

    def saved_list_statement(self):
        opening = self.current
        self.advance()
        self.uses_saved_lists = True
        if opening.word == 'DELETELIST':
            self.emit(f"jbc_deletelist({self.expression()}, {self.location(opening)});")
            return
        if opening.word == 'GETLIST':
            name = self.temporary(self.expression())
            dest = self.select_list('TO')
            setting = self.file_setting()
            self.conditional_arms(opening, f"jbc_readlist({name}, {dest}, {setting})")
            return
        if opening.word == 'WRITELIST':
            value = self.temporary(self.expression())
            if self.word not in ('ON', 'TO'):
                self.error("expected ON or TO after WRITELIST value")
            self.advance()
            name = self.expression()
            setting = self.file_setting()
            self.file_error_arm(opening, f"jbc_writelist({value}, {name}, {setting})", setting)
            return
        target = self.identifier()
        slot = self.variable_slot(target)
        name = '""'
        if self.word == 'FROM':
            self.advance()
            if self.word == '0' and self.following.word in ('THEN', 'ELSE', 'SETTING'):
                self.advance()
            else:
                name = self.expression()
        setting = self.file_setting()
        self.assigned.add(target.word)
        self.conditional_arms(opening, f"jbc_readlist({name}, &{slot}, {setting})")

    def select_statement(self):
        opening = self.current
        self.advance()
        source = "NULL"
        sorted_selection = opening.word == 'SSELECT'
        if self.word not in OUTPUT_END and self.word not in ('', 'TO', 'SETTING'):
            if not sorted_selection or self.word != 'ON' or self.following.word != 'ERROR':
                source = self.expression()
        dest = self.select_list('TO')
        setting = self.file_setting()
        if sorted_selection:
            self.file_error_arm(opening, f"jbc_sselect({source}, {dest}, {setting})", setting)
            return
        call = f"jbc_select({source}, {dest}, {setting})"
        if setting == 'NULL':
            self.emit(f'if (!{call}) numeric_error({self.location(opening)}, "SELECT requires an open default file");')
        else:
            self.emit(f"{call};")

    def readnext_call(self):
        opening = self.current
        self.advance()
        key = None
        if self.word == '@':
            self.advance()
            self.expect('ID')
            out = 'jbc_record_id'
        else:
            key = self.identifier()
            out = self.variable_slot(key)
        mv = 'NULL'
        if self.word == ',':
            self.advance()
            target = self.identifier()
            mv = '&' + self.variable_slot(target)
            self.assigned.add(target.word)
        source = self.select_list('FROM')
        setting = self.file_setting()
        if key:
            self.assigned.add(key.word)
        return f"jbc_readnext({source}, &{out}, {mv}, {setting}, {self.location(opening)})"

    def close_statement(self):
        opening = self.current
        self.advance()
        multiple = False
        while True:
            target = self.identifier()
            slot = self.variable_slot(target)
            call = f'jbc_close_file(&{slot})'
            if not multiple and self.word == 'ON':
                self.advance()
                self.expect('ERROR')
                self.emit(f'if (!{call}) {{')
                before = self.assigned.copy()
                self.clause(opening)
                self.assigned &= before
                self.emit("}")
                return
            self.emit(f'if (!{call}) numeric_error({self.location(target)}, "CLOSE requires an open record file");')
            if self.word != ',':
                return
            self.advance()
            multiple = True

    def status_statement(self):
        opening = self.current
        self.advance()
        target = self.identifier()
        slot = self.variable_slot(target)
        self.expect('FROM')
        handle = self.expression()
        setting = self.file_setting()
        self.assigned.add(target.word)
        call = f'jbc_file_status({handle}, &{slot}, {setting}, {self.location(opening)})'
        self.conditional_arms(opening, call)

    def open_statement(self):
        opening = self.current
        self.advance()
        section = '""'
        name = self.expression()
        if self.word == ',':
            self.advance()
            section = self.temporary(name)
            name = self.expression()
        slot = 'jbc_default_file'
        scope = 'NULL'
        if self.word == 'TO':
            self.advance()
            setting_clause = self.word == 'SETTING' and self.following.kind == 'name' and self.following.word not in (
                'THEN', 'ELSE', 'SETTING', 'ON')
            error_clause = self.word == 'ON' and self.following.word == 'ERROR'
            if self.word not in ('THEN', 'ELSE') and not setting_clause and not error_clause:
                target = self.identifier()
                slot = self.variable_slot(target)
                self.assigned.add(target.word)
                matrix = self.matrices.get(target.word)
                if (self.routine and target.word not in self.formals and target.word not in self.common_scalars
                        and not (matrix and matrix.common_block is not None)):
                    self.opens_local_files = True
                    scope = 'frame'
        setting = self.file_setting()
        status = f'open_status_{self.temporaries}'
        self.temporaries += 1
        self.emit(f'int {status} = jbc_open_file({section}, {name}, &{slot}, {scope}, {setting});')
        self.record_read_arms(opening, status)

    def write_statement(self):
        opening = self.current
        self.advance()
        op = opening.word
        value = self.expression()
        if self.word not in ('ON', 'TO'):
            self.error(f"expected ON or TO after {op} value")
        self.advance()
        if op in ('WRITEV', 'WRITEVU'):
            handle, key, field = self.field_file_key()
            setting = self.file_setting()
            keep_lock = int(op == 'WRITEVU')
            call = (f"jbc_write_field({handle}, {key}, {field}, {value}, {setting}, "
                    f"{keep_lock}, {self.location(opening)})")
            self.file_error_arm(opening, call, setting)
            return
        handle, key = self.file_key()
        setting = self.file_setting()
        keep_lock = int(op == 'WRITEU')
        call = f"jbc_write_record({handle}, {key}, {value}, {setting}, {keep_lock})"
        if op == 'WRITE' and self.word in ('THEN', 'ELSE'):
            self.conditional_arms(opening, call)
        else:
            self.file_error_arm(opening, call, setting)

    def case_statement(self):
        opening = self.current
        self.advance()
        self.expect('CASE')
        if self.word in (';', '\n'):
            while self.word in (';', '\n'):
                self.advance()
            if self.word == 'END':
                self.advance()
                self.expect('CASE')
                return
        if self.word != 'CASE':
            self.error("expected CASE clause", opening)
        before = self.assigned.copy()
        before_maybe = self.maybe_assigned.copy()
        outcomes = []
        possible = before_maybe.copy()
        exhaustive = False
        self.emit("do {")
        self.depth += 1
        while self.word == 'CASE':
            self.advance()
            self.assigned = before.copy()
            self.maybe_assigned = before_maybe.copy()
            condition = self.expression()
            self.emit(f"if (jbc_truth({condition})) {{")
            self.depth += 1
            self.assigned.update(self.assignment_facts.get((condition, True), ()))
            self.sequence({'CASE', 'END'}, opening)
            if not exhaustive and condition not in ('""', '"0"'):
                outcomes.append(self.assigned)
                possible.update(self.assigned)
                possible.update(self.maybe_assigned)
                exhaustive = condition == '"1"'
            self.emit("break;")
            self.depth -= 1
            self.emit("}")
        self.expect('END')
        self.expect('CASE')
        self.depth -= 1
        self.emit("} while (0);")
        if not exhaustive:
            outcomes.append(before)
        self.assigned = set.intersection(*outcomes)
        self.maybe_assigned = (possible - self.assigned) & self.names.keys()

    def report_statement(self):
        opening = self.current
        self.advance()
        self.uses_report = True
        unit = 'NULL'
        if self.word == 'ON':
            self.advance()
            unit = self.temporary(self.primary())
        location = self.location(opening)
        if opening.word == 'PAGE':
            number = 'NULL' if not self.word or self.word in OUTPUT_END else self.expression()
            self.emit(f"jbc_page({unit}, {number}, {location});")
        elif opening.word == 'FOOTING':
            self.emit(f"jbc_footing({unit}, {self.expression()}, {location});")
        else:
            heading = self.expression()
            self.emit(f"jbc_heading({unit}, {heading}, {int(opening.word == 'HEADINGN')}, {location});")

    def printer_statement(self):
        opening = self.current
        self.advance()
        mode = self.word
        self.advance()
        unit = 'NULL'
        if self.word == 'ON':
            self.advance()
            unit = self.primary()
        self.uses_report = True
        self.emit(f'jbc_printer(JBC_PRINTER_{mode}, {unit}, {self.location(opening)});')

    def print_statement(self):
        opening = self.current
        location = self.location(opening)
        omitted_before = self.omitted_concatenations
        self.advance()
        destination = 'jbc_print_channel' if opening.word == 'PRINT' else 'JBC_SCREEN'
        if opening.word == 'PRINT' and self.word == 'ON':
            self.uses_report = True
            self.advance()
            unit = self.primary()
            while self.word in ('+', '-'):
                op = self.current
                self.advance()
                unit = self.arithmetic(op, unit, self.primary(), op.word)
            destination = f'jbc_report_channel({unit}, {location})'
        if opening.word == 'PRINT':
            channel = f'channel_{self.temporaries}'
            self.temporaries += 1
            self.emit(f'int {channel} = {destination};')
            if self.word == ':':
                self.emit(f'(void){channel};')
            destination = channel
        while self.word and self.word not in OUTPUT_END:
            if self.word not in (':', ','):
                value = self.expression(colon_stops=OUTPUT_END)
                self.emit(f"jbc_output({destination}, {value}, {location});")
            if self.word in CONCATENATION:
                self.advance()
                return
            if self.word != ',':
                break
            self.emit(f'jbc_output({destination}, "\\t", {location});')
            self.advance()
        if self.omitted_concatenations == omitted_before:
            self.emit(f'jbc_output({destination}, "\\n", {location});')

    def begin_loop(self):
        self.loops += 1
        self.loop_stack.append(self.loops)
        self.emit("for (;;) {")
        self.depth += 1

    def end_loop_body(self):
        loop = self.loop_stack[-1]
        if loop in self.continued_loops:
            self.emit(f"continue_{loop}: ;")

    def continue_statement(self):
        token = self.current
        self.advance()
        if self.loop_stack:
            loop = self.loop_stack[-1]
            self.continued_loops.add(loop)
            self.emit(f"goto continue_{loop};")
        else:
            print(f"{token.path}:{token.line}:{token.column}: warning: CONTINUE outside a loop ignored",
                  file=sys.stderr)

    def exit_statement(self):
        token = self.current
        self.advance()
        if self.word == '(':
            self.advance()
            status = self.expression()
            self.expect(')')
            self.emit(f"jbc_exit({status}, {self.location(token)});")
        elif self.loop_stack:
            loop = self.loop_stack[-1]
            if loop in self.loop_exit_assignments:
                self.loop_exit_assignments[loop].intersection_update(self.assigned)
            else:
                self.loop_exit_assignments[loop] = self.assigned.copy()
            self.emit(f"goto exit_loop_{loop};")
        else:
            print(f"{token.path}:{token.line}:{token.column}: warning: {token.word} outside a loop ignored",
                  file=sys.stderr)

    def clear_statement(self):
        self.advance()
        if self.clear_assignments is None:
            # Locals first mentioned after CLEAR also get a slot at routine entry.
            self.clear_assignments = set(self.names)
            self.clear_assignments.update(token.word for token in self.tokens
                                          if token.kind == 'name' and token.word != 'IF')
        self.assigned.update(self.clear_assignments)
        self.emit(f"clear_locals_{self.unit}(frame);")

    def termination_statement(self, stops):
        aborting = int(self.word == 'ABORT')
        self.advance()
        if not self.word or self.word in OUTPUT_END or self.word in stops:
            self.emit(f"jbc_stop({aborting}, NULL, 0);")
            return
        args = [self.temporary(self.expression())]
        while self.word == ',':
            self.advance()
            args.append(self.temporary(self.expression()))
        self.emit(f"jbc_stop({aborting}, (const char *[]){{{', '.join(args)}}}, {len(args)});")

    def end_loop(self):
        self.emit("jbc_collect(entry_mark, live);")
        self.depth -= 1
        self.emit("}")
        loop = self.loop_stack.pop()
        exit_assigned = self.loop_exit_assignments.pop(loop, None)
        if exit_assigned is not None:
            self.emit(f"exit_loop_{loop}: ;")
        self.emit("jbc_collect(entry_mark, live);")
        return exit_assigned

    def guard(self):
        until = self.word == 'UNTIL'
        self.advance()
        condition = self.expression()
        self.emit(f"if ({'' if until else '!'}jbc_truth({condition})) break;")
        exit_assigned = self.assigned.union(self.assignment_facts.get((condition, until), ()))
        self.assigned.update(self.assignment_facts.get((condition, not until), ()))
        return exit_assigned

    def for_statement(self):
        opening = self.current
        self.advance()
        counter = self.current
        if counter.kind != 'name':
            self.error("expected FOR variable")
        self.advance()
        self.expect('=')
        initial = self.expression()
        symbol = self.variable(counter.word)
        self.emit(f"assign_value(&{symbol}, {initial});")
        self.assigned.add(counter.word)
        self.expect('TO')
        self.begin_loop()
        limit = self.expression()
        self.for_stack.append(self.loops)
        step = '"1"'
        if self.word == 'STEP':
            self.advance()
            # Capture even a plain variable before the loop body can change it.
            step = f"step_{self.loops}"
            self.saved_steps[self.loops] = step
            self.emit(f"{step} = {self.expression()};")
        location = self.location(opening)
        self.emit(f"if (!jbc_for_test({symbol}.value, {limit}, {step}, {location})) break;")
        before = self.assigned.copy()  # The bounds check can exit before the guard.
        if self.word in ('WHILE', 'UNTIL'):
            self.guard()
        if self.word not in (';', '\n'):
            self.error("expected statement separator after FOR")
        self.guarded_body(opening, 'NEXT')
        terminator = self.current
        self.advance()
        if self.current.kind == 'name' and self.word not in OUTPUT_END:
            if self.word != counter.word:
                name = self.current
                print(f"{name.path}:{name.line}:{name.column}: warning: NEXT {name.word} "
                      f"closes FOR {counter.word}", file=sys.stderr)
            self.advance()
        self.end_loop_body()
        if self.for_stack[-1] in self.saved_steps:
            self.emit(f'if (!{step}) numeric_error({self.location(terminator)}, '
                      '"NEXT requires the STEP expression from the FOR header");')
        value = self.checked_read(symbol, counter)
        increment = self.arithmetic(opening, value, step, '+')
        self.emit(f"assign_value(&{symbol}, {increment});")
        self.for_stack.pop()
        self.end_loop()
        # The first bounds check can skip the body, so check its new scalars on read.
        self.maybe_assigned.update((self.assigned - before) & self.names.keys())
        self.assigned = before

    def guarded_body(self, opening, terminator):
        exits = None
        while True:
            self.sequence({'WHILE', 'UNTIL', terminator}, opening)
            if self.word == terminator:
                return exits
            exit_assigned = self.guard()
            exits = exit_assigned if exits is None else exits & exit_assigned
            if self.word == 'DO':
                self.advance()

    def loop_statement(self):
        opening = self.current
        self.advance()
        self.begin_loop()
        exits = self.guarded_body(opening, 'REPEAT')
        self.advance()
        self.end_loop_body()
        bare_exits = self.end_loop()
        if bare_exits is not None:
            exits = bare_exits if exits is None else exits & bare_exits
        if exits is not None:
            # A later iteration can exit before revisiting an assignment.
            self.maybe_assigned.update((self.assigned - exits) & self.names.keys())
            self.assigned = exits

    def identifier(self):
        token = self.current
        if token.kind != 'name':
            self.error("expected a name")
        self.advance()
        return token

    def value_argument(self, expression):
        # Capture the expression before a later argument can change its value.
        value = self.temporary(expression)
        return f"&(jbc_variable){{{value}, 0, 0}}"

    def scalar_argument(self):
        if self.word in self.matrices:
            target = self.identifier()
            slot = self.matrix_slot(target)
            if self.word in (',', ')'):
                return '&' + slot, None
            value = self.variable_expression(target, slot)
            return self.value_argument(self.expression_tail(value)), None
        if self.current.kind == 'name' and self.following.word in (',', ')'):
            name = self.identifier().word
            return '&' + self.variable(name), name
        return self.value_argument(self.expression()), None

    def ioctl_expression(self):
        opening = self.identifier()
        self.expect('(')
        if (self.current.kind == 'name' and self.following.word == ','
                and self.word not in self.matrices):
            slot = self.variable(self.identifier().word)
            handle = self.temporary(f"{slot}.value")
        else:
            handle = self.temporary(self.expression())
        self.expect(',')
        command = self.temporary(self.expression())
        self.expect(',')
        output, name = self.scalar_argument()
        self.expect(')')
        value = self.temporary(f"jbc_ioctl({handle}, {command}, {output}, {self.location(opening)})")
        if name is not None:
            self.assignment_facts[value, True] = {name}
        return value

    def call_arguments(self):
        args = []
        kinds = []
        if self.word == '(':
            self.advance()
            while self.word != ')':
                matrix_argument = self.word == 'MAT'
                kinds.append(matrix_argument)
                if matrix_argument:
                    self.advance()
                    matrix = self.checked_matrix(self.matrix_name())
                    args.append(matrix.argument())
                else:
                    argument, name = self.scalar_argument()
                    args.append(argument)
                    if name is not None:
                        self.assigned.add(name)
                if self.word != ',':
                    break
                self.advance()
                if self.word == ')':
                    self.error("expected call argument")
            self.expect(')')
        return args, tuple(kinds)

    def subroutine_name(self):
        if self.current.kind == 'routine_name':
            target = self.current
            self.advance()
            return target
        if self.word != '!':
            return self.identifier()
        prefix = self.current
        self.advance()
        if prefix.kind != 'bang_prefix' or self.current.kind != 'name':
            self.error("expected a routine name immediately after '!'", prefix)
        return prefix._replace(word='!' + self.identifier().word, kind='name')

    def call_statement(self):
        self.advance()
        if self.word == '@' and self.current.kind != 'routine_name':
            opening = self.current
            self.advance()
            target = self.current
            if target.kind not in ('name', 'system_name'):
                self.error("expected a variable after CALL @")
            self.advance()
            if target.word in self.matrices:
                value = self.checked_read(self.matrix_slot(target), target)
            else:
                value = self.read_variable(target)
            name = self.temporary(value)
            args, kinds = self.call_arguments()
            values = [f"{{.{field} = {arg}}}" for field, arg in zip(argument_fields(kinds), args)]
            packed = "(jbc_argument[]){" + ", ".join(values) + "}" if values else "NULL"
            self.has_indirect_call = True
            self.emit(f"jbc_call_indirect({name}, {kind_string(kinds)}, {packed}, {self.location(opening)});")
            return
        target = self.subroutine_name()
        args, kinds = self.call_arguments()
        self.calls.append((target, kinds, False))
        self.emit(f"{routine_symbol(target.word)}({', '.join(args)});")

    def label_number(self, name):
        return self.targets.setdefault(name, len(self.targets) + 1)

    def local_label(self):
        if self.current.kind not in ('name', 'number'):
            self.error("expected a label")
        token = self.current
        self.advance()
        if self.word == ':':
            self.advance()
        return token

    def emit_jump(self, target, jump):
        number = self.label_number(target.word)
        self.references.append(target)
        if jump:
            self.has_goto = True
            self.emit("jbc_collect(entry_mark, live);")
            self.goto_sites[len(self.body)] = (target.word, tuple(self.for_stack))
            self.emit(f"goto label_{number};")
        else:
            self.gosub_sites[len(self.body)] = tuple(self.for_stack)
            self.emit(f"body_{self.unit}(frame, {number});")
            if self.is_function:
                self.emit("if (frame->result) return 0;")

    def jump_operator(self):
        operator = self.current
        self.advance()
        if operator.word == 'GO' and self.word == 'TO' and self.following.word != ':':
            self.advance()
        return operator.word != 'GOSUB'

    def indexed_jump(self):
        opening = self.current
        self.advance()
        index = self.expression()
        if self.word not in ('GO', 'GOTO', 'GOSUB'):
            self.error("expected GOTO or GOSUB")
        jump = self.jump_operator()
        targets = [self.local_label()]
        while self.word == ',':
            self.advance()
            targets.append(self.local_label())
        self.emit(f"switch (jbc_jump_index({index}, {len(targets)}, {self.location(opening)})) {{")
        for position, target in enumerate(targets, 1):
            self.emit(f"case {position}:")
            self.depth += 1
            self.emit_jump(target, jump)
            if not jump:
                self.emit("break;")
            self.depth -= 1
        self.emit("}")

    def dimension_bounds(self):
        self.expect('(')
        bounds = []
        while True:
            token = self.current
            if token.kind == 'number' and token.word.isdigit() and self.following.word in (',', ')'):
                if len(token.word) > 9 or int(token.word) == 0:
                    self.error("expected a positive constant dimension")
                bounds.append(int(token.word))
                self.advance()
            else:
                value = self.expression()
                bound = f"bound_{self.temporaries}"
                self.temporaries += 1
                self.emit(f"int {bound} = jbc_dimension({value}, {self.location(token)});")
                bounds.append(bound)
            if self.word != ',':
                break
            self.advance()
        self.expect(')')
        if math.prod(n + 1 for n in bounds if isinstance(n, int)) > 2147483647:
            self.error("dimensioned array is too large", token)
        return tuple(bounds)

    def declaration(self):
        opening = self.current
        common = self.word in ('COM', 'COMMON')
        self.advance()
        block_name = None
        block = None
        if common:
            name = ''
            if self.word == '/':
                self.advance()
                if self.word != '/':
                    name = self.identifier().word
                self.expect('/')
            if name not in self.commons:
                self.commons[name] = CommonBlock(f"common{len(self.commons)}", opening)
            block_name = name
            block = self.commons[name]
        while True:
            self.declaration_member(block_name, block)
            if self.word != ',':
                break
            self.advance()
            while self.word == '\n':
                self.advance()

    def declaration_member(self, block_name, block):
        common = block is not None
        token = self.identifier()
        name = token.word
        if common and self.common_scalars.get(name) == block_name and self.word != '(':
            return
        matrix = self.matrices.get(name)
        pending = self.pending_matrices.get(name) == token
        if (matrix and not pending and matrix.shape is not None and self.word == '('
                and (not common or matrix.common_block == block_name)):
            self.redeclare_matrix(token, matrix)
            return
        if not common and self.formals.get(name):
            bounds = self.dimension_bounds()
            matrix = self.matrices[name]
            self.emit(f"if ({matrix.rank} != {len(bounds)} || "
                      f"memcmp({matrix.limits}, (const int[]){{{', '.join(map(str, bounds))}}}, "
                      f"{len(bounds)} * sizeof(int))) numeric_error({self.location(token)}, "
                      '"incompatible MAT parameter dimensions");')
            return
        if name in self.names or (matrix and not pending):
            self.error(f"duplicate declaration of '{name}'", token)
        bounds = self.dimension_bounds() if self.word == '(' or not common else ()
        shape = tuple(n if isinstance(n, int) else None for n in bounds)
        if common:
            member = len(block.shapes)
            block.shapes.append(shape)
            if not bounds:
                self.common_scalars[name] = block_name
                self.names[name] = f"frame->{block.field}[{member}]"
                self.assigned.add(name)
                return
            block.matrix_slots[name] = member
            field = matrix.field if pending else f"{block.field}_m{member}"
        else:
            field = matrix.field if pending else f"matrix{len(self.local_arrays)}"
            self.local_arrays[field] = None if None in shape else math.prod(n + 1 for n in bounds)

        if common or None in shape:
            key = c_string(f"{block_name}:{member}") if common else "NULL"
            previous = "NULL" if common else f"frame->{field}"
            call = self.matrix_storage_call(previous, key, bounds, token)
            if None in shape:
                self.emit(f"frame->{field} = {call};")
            else:
                block.initializers.append(f"frame.{field} = {call};")
        self.matrices[name] = Matrix(field, shape, block_name)
        if pending:
            del self.pending_matrices[name]

    def matrix_storage_call(self, previous, key, bounds, token):
        return (f"jbc_matrix_storage({previous}, {key}, {len(bounds)}, "
                f"(const int[]){{{', '.join(map(str, bounds))}}}, {self.location(token)})")

    def redeclare_matrix(self, token, matrix):
        bounds = self.dimension_bounds()
        shape = tuple(bound if isinstance(bound, int) else None for bound in bounds)
        block_name = matrix.common_block
        kind = "local" if block_name is None else "COMMON"
        message = f"incompatible {kind} matrix dimensions"
        if not compatible_dimensions(matrix.shape, shape):
            self.error(message, token)
        if None not in matrix.shape and None not in shape:
            return

        for expected, bound in zip(matrix.shape, bounds):
            if expected is not None and not isinstance(bound, int):
                self.emit(f'if ({bound} != {expected}) numeric_error({self.location(token)}, {c_string(message)});')
        slot = f"frame->{matrix.field}"
        key = "NULL"
        if block_name is not None:
            member = self.commons[block_name].matrix_slots[token.word]
            key = c_string(f"{block_name}:{member}")
        call = self.matrix_storage_call(slot, key, bounds, token)
        self.emit(f"{slot} = {call};")

    def matrix_name(self):
        token = self.identifier()
        if token.word not in self.matrices:
            self.error(f"expected a dimensioned array '{token.word}'", token)
        return token

    def checked_matrix(self, token):
        matrix = self.matrices[token.word]
        if matrix.shape is not None and None in matrix.shape:
            kind = "COMMON" if matrix.common_block is not None else "local"
            self.emit(f'if (!frame->{matrix.field}) numeric_error({self.location(token)}, '
                      f'"{kind} matrix declaration has not executed");')
        return matrix

    def matrix_range(self):
        start = end = 'NULL'
        if self.word == ',':
            self.advance()
            start = self.expression()
            if self.word == ',':
                self.advance()
                end = self.expression()
        return start, end

    def matrix_delimiter(self):
        delimiter = SYSTEM_CONSTANTS['FM']
        if self.word in ('USING', ','):
            self.advance()
            delimiter = self.expression()
        return delimiter

    def matbuild_statement(self):
        opening = self.current
        self.advance()
        target = self.identifier()
        dest = self.variable_slot(target)
        self.expect('FROM')
        source = self.matrix_name()
        matrix = self.checked_matrix(source)
        start, end = self.matrix_range()
        delimiter = self.matrix_delimiter()
        result = self.temporary(f"jbc_matbuild({matrix.base}, {matrix.rank}, {matrix.limits}, "
                                f"{start}, {end}, {delimiter}, {c_string(source.word)}, {self.location(opening)})")
        self.emit(f"assign_value(&{dest}, {result});")
        if target.word not in self.matrices:
            self.assigned.add(target.word)

    def matparse_statement(self):
        opening = self.current
        self.advance()
        matrix = self.checked_matrix(self.matrix_name())
        start, end = self.matrix_range()
        self.expect('FROM')
        source = self.expression()
        delimiter = self.matrix_delimiter()
        setting = 'NULL'
        if self.word == 'SETTING':
            self.advance()
            target = self.identifier()
            setting = '&' + self.variable_slot(target)
            if target.word not in self.matrices:
                self.assigned.add(target.word)
        self.emit(f"jbc_matparse({matrix.base}, {matrix.rank}, {matrix.limits}, "
                  f"{start}, {end}, {source}, {delimiter}, {setting}, {self.location(opening)});")

    def matrix_assignment(self):
        self.advance()
        target = self.matrix_name()
        dest = self.checked_matrix(target)
        self.expect('=')
        if self.word == 'MAT':
            self.advance()
            source = self.matrix_name()
            src = self.checked_matrix(source)
            self.emit(f"jbc_matrix_copy({dest.argument()}, {src.argument()}, "
                      f"{c_string(source.word)}, {self.location(source)});")
        else:
            self.emit(f"jbc_matrix_fill({dest.base}, {dest.count}, {self.expression()});")

    def matrix_slot(self, token):
        matrix = self.checked_matrix(token)
        rank = matrix.rank
        self.expect('(')
        subscripts = [self.expression()]
        while self.word == ',':
            self.advance()
            subscripts.append(self.expression())
        self.expect(')')
        if matrix.shape is None:
            self.emit(f'if ({rank} != {len(subscripts)}) numeric_error({self.location(token)}, '
                      '"wrong number of MAT parameter subscripts");')
        elif len(subscripts) != rank:
            self.error(f"expected {rank} subscripts for '{token.word}'", token)
        index = f"index_{self.temporaries}"
        self.temporaries += 1
        self.emit(f"size_t {index} = jbc_matrix_index({rank}, {matrix.limits}, "
                  f"(const char *[]){{{', '.join(subscripts)}}}, {self.location(token)});")
        return f"({matrix.base})[{index}]"

    def prefix_step(self, statement=False):
        operator = self.current
        self.advance()
        target = self.identifier()
        slot = self.variable_slot(target)
        if statement and self.word in ('<', '['):
            self.error("increment and decrement require a variable or matrix element")
        return self.step_value(target, operator, slot)

    def get_argument_statement(self):
        opening = self.current
        self.advance()
        self.expect('(')
        self.expect('ARG.')
        position = 'NULL'
        if self.word == ',':
            self.advance()
            position = self.temporary(self.expression())
        self.expect(')')
        target = self.identifier()
        slot = self.variable_slot(target)
        self.needs_arguments = True
        value = self.temporary(f"jbc_get_argument({position}, {self.location(opening)})")
        scalar = target.word not in self.matrices
        if self.word in ('THEN', 'ELSE'):
            self.emit(f"if ({value}) assign_value(&{slot}, {value});")
            if scalar:
                self.assignment_facts[value, True] = {target.word}

            def assign_empty():
                self.emit(f'assign_value(&{slot}, "");')
                if scalar:
                    self.assigned.add(target.word)

            self.conditional_arms(opening, value, value, default_else=assign_empty)
        else:
            self.emit(f'assign_value(&{slot}, {value} ? {value} : "");')
            if scalar:
                self.assigned.add(target.word)

    def step_value(self, target, operator, slot, postfix=False):
        scalar = target.word not in self.matrices
        if scalar and target.word not in self.assigned and not self.has_unstructured_jumps:
            self.assignment_error(f"unassigned variable '{target.word}'", target)
        old = self.checked_read(slot, target)
        value = self.arithmetic(operator, old, '"1"', operator.word[0])
        self.emit(f"assign_value(&{slot}, {value});")
        if scalar:
            self.assigned.add(target.word)
        return old if postfix else value

    def statement(self, stops):
        if self.current.kind == 'program_header':
            self.advance()
        elif self.word == 'PROGRAM' and self.following.word in (';', '\n', ''):
            self.error("expected a program name", self.following)
        elif self.word == 'MAT':
            self.matrix_assignment()
        elif self.word == 'MATPARSE':
            self.matparse_statement()
        elif (self.word in ('MATREAD', 'MATREADU', 'MATWRITE') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.matrix_file_statement()
        elif self.word == 'MATBUILD':
            self.matbuild_statement()
        elif self.word == 'CONVERT' or (self.word in ('CHANGE', 'EREPLACE', 'SWAP')
                                       and self.word not in self.matrices
                                       and self.following.word not in ASSIGNMENT_PREFIXES):
            self.change_or_convert_statement()
        elif self.word == 'INS':
            self.ins_statement()
        elif self.word == 'DEL':
            self.del_statement()
        elif self.word == 'REMOVE':
            self.remove_statement()
        elif (self.word in ('FIND', 'FINDSTR') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.find_statement()
        elif self.word == 'LOCATE':
            self.locate_statement()
        elif self.word == 'NULL':
            self.advance()
        elif self.word == 'PRECISION':
            token = self.current
            self.advance()
            self.sets_precision = True
            self.emit(f"jbc_set_precision({self.expression()}, {self.location(token)});")
        elif self.word == 'DEFFUN':
            self.advance()
            function = self.identifier()
            kinds = []
            self.expect('(')
            if self.word != ')':
                kinds.append(self.parameter()[1])
                while self.word == ',':
                    self.advance()
                    kinds.append(self.parameter()[1])
            self.functions[function.word] = tuple(kinds)
            self.expect(')')
        elif self.word in ('DIM', 'DIMENSION', 'COM', 'COMMON'):
            self.declaration()
        elif self.word in ('GOSUB', 'GOTO') or (self.word == 'GO' and
                self.following.word not in ASSIGNMENT_PREFIXES and
                self.following.word != '('):
            jump = self.jump_operator()
            self.emit_jump(self.local_label(), jump)
        elif (self.word == 'ON' and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            self.indexed_jump()
        elif self.word == 'RETURN':
            opening = self.current
            self.advance()
            if self.word == 'TO':
                if self.is_function:
                    self.error("RETURN TO is not allowed in a FUNCTION", opening)
                self.advance()
                target = self.local_label()
                if not self.routine:
                    self.emit(f'if (!entry) numeric_error({self.location(opening)}, '
                              '"RETURN TO without an outstanding GOSUB");')
                self.return_targets[target.word] = target
                self.emit(f"return {self.label_number(target.word)};")
                return
            if self.is_function and self.word not in OUTPUT_END and self.word != '':
                if self.word == '(' and self.following.word == ')':
                    self.advance()
                    self.advance()
                    value = '""'
                else:
                    value = self.expression()
                self.emit(f"frame->result = {value};")
            self.emit("return 0;")
        elif self.word == 'EXIT' or (self.word == 'BREAK' and
                                     (self.following.word in (';', '\n') or self.following.word in stops)):
            self.exit_statement()
        elif (self.word == 'BREAK' and self.following.word in ('ON', 'OFF')
              and self.word not in self.matrices):
            opening = self.current
            self.advance()
            enabled = int(self.word == 'ON')
            self.advance()
            self.terminal = True
            self.emit(f"jbc_break_key({enabled}, {self.location(opening)});")
        elif (self.word == 'DEBUG' and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            opening = self.current
            self.advance()
            self.emit(f'numeric_error({self.location(opening)}, "DEBUG requires a jBC debugger");')
        elif (self.word == 'CALLJ' and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            self.callj_statement()
        elif (self.word in ('TRANSTART', 'TRANSEND', 'TRANSABORT')
              and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            self.transaction_statement()
        elif (self.word in ('STOP', 'ABORT') and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            self.termination_statement(stops)
        elif (self.word in ('DELETE', 'CLEARFILE') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            if self.word == 'DELETE':
                self.delete_statement()
            else:
                self.clearfile_statement()
        elif (self.word == 'RELEASE' and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            opening = self.current
            self.advance()
            on_error = self.word == 'ON' and self.following.word == 'ERROR'
            handle, key = ("NULL", "NULL") if on_error or not self.word or self.word in OUTPUT_END else self.file_key()
            call = f"jbc_release_lock({handle}, {key})"
            if self.word == 'ON':
                self.file_error_arm(opening, f"file_succeeded({call})", "NULL")
            else:
                self.emit(f"{call};")
        elif (self.word == 'RECORDLOCKU' and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            opening = self.current
            self.advance()
            handle, key = self.file_key()
            setting = self.file_setting()
            status = f"lock_status_{self.temporaries}"
            self.temporaries += 1
            self.emit(f"int {status} = jbc_recordlocku({handle}, {key}, {setting});")
            self.record_read_arms(opening, status, setting)
        elif (self.word == 'READ' or (self.word == 'READU' and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES)):
            self.read_record_statement()
        elif (self.word in ('READV', 'READVU') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.readv_statement()
        elif (self.word in ('READLIST', 'WRITELIST', 'GETLIST', 'DELETELIST') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.saved_list_statement()
        elif (self.word == 'FORMLIST' and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.advance()
            source = self.temporary(self.expression())
            dest = self.select_list('TO')
            setting = self.file_setting()
            self.emit(f"jbc_formlist({source}, {dest}, {setting});")
        elif (self.word in ('SELECT', 'SSELECT', 'READNEXT', 'CLEARSELECT') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            if self.word in ('SELECT', 'SSELECT'):
                self.select_statement()
            elif self.word == 'CLEARSELECT':
                self.clearselect_statement()
            else:
                opening = self.current
                self.conditional_arms(opening, self.readnext_call())
        elif (self.word in ('READT', 'REWIND', 'WEOF', 'WRITET') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.tape_statement()
        elif (self.word in ('OPENSEQ', 'OPENDEV', 'READSEQ', 'READBLK', 'WRITESEQ', 'WRITESEQF', 'WRITEBLK',
                            'CLOSESEQ', 'CREATE', 'WEOFSEQ', 'SEEK', 'FLUSH', 'NOBUF', 'TIMEOUT',
                            'OSREAD', 'OSOPEN', 'OSCLOSE', 'OSBREAD', 'OSBWRITE', 'OSWRITE', 'OSDELETE',
                            'TTYGET', 'TTYSET')
              and self.word not in self.matrices and self.following.word not in ASSIGNMENT_PREFIXES):
            self.sequential_statement()
        elif (self.word == 'OPEN' or (self.word == 'OPENPATH' and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES)):
            self.open_statement()
        elif (self.word == 'CLOSE' and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.close_statement()
        elif (self.word == 'STATUS' and self.following.kind == 'name'
              and self.word not in self.matrices):
            self.status_statement()
        elif (self.word == 'WRITE' or (self.word in ('WRITEU', 'WRITEV', 'WRITEVU')
              and self.word not in self.matrices and self.following.word not in ASSIGNMENT_PREFIXES)):
            self.write_statement()
        elif self.word == 'BEGIN':
            self.case_statement()
        elif self.word == 'CALL':
            self.call_statement()
        elif self.word == 'IF':
            self.conditional()
        elif self.word == 'FOR':
            self.for_statement()
        elif self.word == 'CONTINUE':
            self.continue_statement()
        elif self.word == 'LOOP':
            self.loop_statement()
        elif (self.word == 'ASSIGN' and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            opening = self.current
            self.advance()
            value = self.temporary(self.expression())
            self.expect('TO')
            self.expect('SYSTEM')
            self.expect('(')
            key = self.expression()
            self.expect(')')
            self.emit(f"jbc_assign_system({value}, {key}, {self.location(opening)});")
        elif (self.word == 'CLEARDATA' and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.advance()
            self.emit("jbc_cleardata();")
        elif (self.word == 'CLEAR' and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            self.clear_statement()
        elif (self.word == 'DATA' and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            self.advance()
            while True:
                self.emit(f"jbc_data({self.expression()});")
                if self.word != ',':
                    break
                self.advance()
        elif (self.word in ('EXECUTE', 'EXEC', 'PERFORM') and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            self.execute_statement(stops)
        elif (self.word == 'HUSH' and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            opening = self.current
            self.advance()
            self.uses_hush = True
            if self.word in ('ON', 'OFF'):
                state = '"1"' if self.word == 'ON' else '"0"'
                self.advance()
            elif not self.word or self.word in OUTPUT_END or self.word in stops:
                state = 'NULL'
            else:
                state = self.expression()
            self.emit(f"jbc_hush({state}, {self.location(opening)});")
        elif (self.word == 'ECHO' and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            self.advance()
            self.terminal = True
            if self.word in ('ON', 'OFF'):
                state = int(self.word == 'ON')
                self.advance()
            else:
                state = f"jbc_truth({self.expression()})"
            self.emit(f"jbc_echo({state});")
        elif (self.word == 'SLEEP' and self.following.word not in ASSIGNMENT_PREFIXES
              and not (self.word in self.matrices and self.following.word == '(')):
            opening = self.current
            self.advance()
            self.uses_sleep = True
            duration = '"1"' if not self.word or self.word in OUTPUT_END else self.expression()
            self.emit(f"jbc_sleep({duration}, {self.location(opening)});")
        elif (self.word == 'RANDOMIZE' and self.following.word not in ASSIGNMENT_PREFIXES
              and self.word not in self.matrices):
            self.advance()
            if self.word == '(':
                self.advance()
                if self.word != ')':
                    self.ignored_expression()
                self.expect(')')
        elif (self.word in ('INPUTCLEAR', 'CLEARINPUT') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            opening = self.current
            self.advance()
            self.terminal = True
            self.emit(f"jbc_inputclear({self.location(opening)});")
        elif (self.word == 'GET' and self.word not in self.matrices and self.following.word == '('
              and len(self.tokens) > 1 and self.tokens[1].word == 'ARG.'):
            self.get_argument_statement()
        elif (self.word in ('INPUT', 'PROMPT') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            opening = self.current
            self.advance()
            self.terminal = True
            if opening.word == 'PROMPT':
                self.emit(f"jbc_input_prompt = {self.expression()};")
            else:
                target = self.identifier()
                slot = self.variable_slot(target)
                limit = 'NULL'
                omitted_before = self.omitted_concatenations
                if self.word == ',':
                    self.advance()
                    limit = self.expression(colon_stops=OUTPUT_END | {'FOR', '_'})
                suppress = self.omitted_concatenations != omitted_before
                if self.word in CONCATENATION:
                    suppress = True
                    self.advance()
                discard_excess = self.word == '_'
                if discard_excess:
                    if limit == 'NULL':
                        self.error("INPUT underscore requires a length")
                    self.advance()
                    if not suppress and self.word in CONCATENATION:
                        suppress = True
                        self.advance()
                timeout = 'NULL'
                if self.word == 'FOR':
                    self.advance()
                    timeout = self.expression()
                call = (f"jbc_input(&{slot}, {limit}, {int(suppress)}, {int(discard_excess)}, "
                        f"{timeout}, {self.location(opening)})")
                self.assigned.add(target.word)
                if timeout == 'NULL':
                    self.emit(call + ";")
                else:
                    self.conditional_arms(opening, call)
        elif (self.word in ('HEADING', 'HEADINGE', 'HEADINGN', 'FOOTING', 'PAGE') and self.word not in self.matrices
              and self.following.word not in ASSIGNMENT_PREFIXES):
            self.report_statement()
        elif self.word == 'PRINTER' and self.following.word in ('ON', 'OFF', 'CLOSE', 'RESET'):
            self.printer_statement()
        elif (self.word in ('CRT', 'PRINT')
              or (self.word == 'DISPLAY' and self.following.word not in ASSIGNMENT_PREFIXES
                  and not (self.word in self.matrices and self.following.word == '('))):
            self.print_statement()
        elif self.word == '@' and self.following.word in RECORD_VARIABLES:
            self.advance()
            slot = RECORD_VARIABLES[self.word]
            self.advance()
            self.expect('=')
            self.emit(f"assign_value(&{slot}, {self.expression()});")
        elif self.word in STEP_OPERATORS:
            self.prefix_step(statement=True)
        elif self.current.kind == 'name':
            start = self.current
            self.advance()
            matrix = start.word in self.matrices
            var = self.matrix_slot(start) if matrix else None
            indices = self.assignment_indices()
            substring = None
            delimited = False
            if self.word == '[':
                location = self.location(self.current)
                bounds = self.bracket_arguments(1, 3)
                delimited = len(bounds) == 3
                if len(bounds) == 1:
                    bounds.insert(0, 'NULL')
                substring = f"{', '.join(bounds)}, {location}"
            operator = self.current
            if self.word in STEP_OPERATORS:
                if indices or substring:
                    self.error("increment and decrement require a variable or matrix element")
                self.advance()
                self.step_value(start, operator, var or self.variable(start.word))
                return
            if self.word not in ASSIGNMENTS:
                self.error(f"unsupported statement '{start.word}'", start)
            self.advance()
            value = self.expression()
            var = var or self.variable(start.word)
            base = f'({var}.value ? {var}.value : "")'
            if substring and operator.word not in ('=', ':='):
                self.error("expected '=' or ':=' for substring replacement", operator)
            compound = operator.word != '='
            text = base
            previous = base
            if compound:
                if (not matrix and start.word not in self.assigned and start.word not in self.maybe_assigned
                        and not self.has_unstructured_jumps):
                    self.assignment_error(f"unassigned variable '{start.word}'", start)
                previous = self.checked_read(var, start)
            if indices and (substring or compound):
                text = self.temporary(f"jbc_array({previous}, {indices}, NULL)")
            if compound:
                old = text if indices else previous
                if delimited:
                    text = old
                else:
                    if substring:
                        old = self.temporary(f"jbc_substring({old}, {substring}, NULL)")
                    if operator.word == ':=':
                        value = self.temporary(f"jbc_concat({old}, {value})")
                    else:
                        value = self.arithmetic(operator, old, value, operator.word[0])
            if delimited:
                append = int(operator.word == ':=')
                value = self.temporary(f"jbc_field_replace({text}, {substring}, {value}, {append})")
            elif substring:
                value = self.temporary(f"jbc_substring({text}, {substring}, {value})")
            if indices:
                value = self.temporary(f"jbc_array({base}, {indices}, {value})")
            self.emit(f"assign_value(&{var}, {value});")
            if not matrix:
                self.assigned.add(start.word)
        else:
            self.error("expected an assignment, CRT or IF")

    def loop_boundary_is_target(self):
        # Preserve assignments and labels using loop keywords in inline arms.
        return (self.following.word in ASSIGNMENT_PREFIXES
            or (self.word in self.matrices and self.following.word == '(')
            or is_label(self.current, self.following))

    def sequence(self, stops, opening=None):
        enclosing_stops = self.statement_stops
        self.statement_stops = stops
        while self.word not in stops or (
            self.word in LOOP_BOUNDARIES and opening.word != 'LOOP' and self.loop_boundary_is_target()
        ):
            if self.word == '':
                self.error(f"unterminated {opening.word}", opening)
            if self.word in (';', '\n'):
                self.advance()
                continue
            if is_label(self.current, self.following):
                token = self.local_label()
                if token.word in self.labels:
                    self.error("duplicate label", token)
                self.labels[token.word] = tuple(self.for_stack)
                self.emit(f"label_{self.label_number(token.word)}: ;")
                continue
            self.statement(stops)
            if self.word not in stops and self.word not in (';', '\n'):
                self.error(f"unexpected '{self.word}'")
        self.statement_stops = enclosing_stops

    def parameter(self):
        is_matrix = self.word == 'MAT'
        if is_matrix:
            self.advance()
        return self.identifier(), is_matrix

    def parse(self, tokens):
        self.has_expression_writes = any(
            t.kind == 'symbol' and t.word in STEP_OPERATORS
            or t.kind == 'name' and t.word in ('GETENV', 'IOCTL', 'REMOVE') and tokens[i + 1].word == '('
            for i, t in enumerate(tokens)
        )
        self.has_unstructured_jumps = any(
            t.kind == 'name' and (t.word in ('GOTO', 'GOSUB') or
                                  (t.word == 'RETURN' and n + 1 < len(tokens) and tokens[n + 1].word == 'TO'))
            for n, t in enumerate(tokens)
        )
        # GO is also a legal identifier. Resolve tentative assignment diagnostics
        # once we know whether any use actually emitted a jump.
        self.possible_go = any(t.word == 'GO' and tokens[i + 1].kind in ('name', 'number')
                               for i, t in enumerate(tokens) if t.kind == 'name')
        self.pending_assignment_error = None
        self.tokens = deque(tokens)
        self.advance()
        while self.word == '\n':
            self.advance()
        if self.word in ('SUBROUTINE', 'SUB', 'FUNCTION'):
            header = self.word
            self.is_function = header == 'FUNCTION'
            self.advance()
            self.routine = self.identifier() if self.is_function else self.subroutine_name()
            if self.word == '(':
                self.advance()
                while self.word != ')':
                    param, is_matrix = self.parameter()
                    if param.word in self.formals:
                        self.error("duplicate parameter", param)
                    i = len(self.formals)
                    self.formals[param.word] = is_matrix
                    if is_matrix:
                        self.matrices[param.word] = Matrix(f"arg{i}", None)
                    else:
                        self.names[param.word] = f"(*frame->arg{i})"
                        self.assigned.add(param.word)
                    if self.word != ',':
                        break
                    self.advance()
                    if self.word == ')':
                        self.error("expected parameter")
                self.expect(')')
            if self.word not in (';', '\n'):
                self.error(f"expected separator after {header} declaration")
        for index, (token, shape, block) in enumerate(matrix_declarations(tokens)):
            if token.word not in self.formals:
                self.matrices[token.word] = Matrix(f"declared_matrix{index}", shape, block)
                self.pending_matrices[token.word] = token
        self.sequence({'', 'END'})
        if self.word == 'END':
            self.advance()
            while self.word in (';', '\n'):
                self.advance()
            if self.word:
                self.error("unexpected text after final END")
        if self.pending_assignment_error and not self.has_goto:
            self.error(*self.pending_assignment_error)
        for token in self.pending_matrices.values():
            self.error(f"expected a declaration of '{token.word}'", token)
        for name, target in self.return_targets.items():
            if name not in self.labels:
                self.error(f"unknown label '{name}'", target)
        for target in self.references:
            if target.word not in self.labels:
                self.error(f"unknown label '{target.word}'", target)

    def reset_skipped_steps(self, target, active_fors):
        # A jump can enter a loop that ran before. Discard its stale STEP.
        entered = self.labels[target]
        return "".join(f"{self.saved_steps[loop]} = NULL; "
                       for depth, loop in enumerate(entered, 1)
                       if loop in self.saved_steps and entered[:depth] != active_fors[:depth])

    def signature(self):
        if not self.routine:
            return "int main(int argc, char **argv)" if self.needs_arguments else "int main(void)"
        return routine_signature(self.routine.word, self.formals.values(), self.is_function)

    def render(self, memory_files=(), memory_dicts=(), memory_locks=()):
        u = self.unit
        fields = [arg + ";" for arg in routine_parameters(self.formals.values())]
        if self.is_function:
            fields.append("const char *result;")
        local_scalars = [var for name, var in self.names.items()
                         if name not in self.formals and name not in self.common_scalars]
        fields += [f"jbc_variable {var.split('->')[1]};" for var in local_scalars]
        fields += [f"jbc_variable *{b.field};" for b in self.commons.values()]
        fields += [f"struct jbc_slots *{m.field};" for m in self.matrices.values() if m.shape is not None]
        lines = [f"struct frame_{u} {{"] + ["    " + f for f in fields or ["char unused;"]] + ["};"]
        if self.clear_assignments is not None:
            lines.extend([f"static void clear_locals_{u}(struct frame_{u} *frame)", "{", "    (void)frame;"])
            lines.extend(f'    assign_value(&{var}, "0");' for var in local_scalars)
            for field in self.local_arrays:
                lines.append(f'    if (frame->{field}) jbc_matrix_fill(frame->{field}->values, '
                             f'frame->{field}->count, "0");')
            lines.append("}")
        lines += [f"static int body_{u}(struct frame_{u} *frame, int entry)", "{"]
        lines += ["    (void)frame;", "    (void)entry;"]
        if self.loops or self.has_goto or (self.return_targets and self.gosub_sites):
            lines.append("    struct jbc_buffer *entry_mark = buffers;")
            for step in self.saved_steps.values():
                lines.append(f"    const char *{step} = NULL;")
            roots = ["&" + var + ".value" for var in self.names.values()]
            roots.extend("&" + step for step in self.saved_steps.values())
            roots.append("NULL")
            lines.append("    const char **live[] = {" + ", ".join(roots) + "};")
        if self.labels:
            lines.append("    switch (entry) {")
            for name in self.labels:
                n = self.targets[name]
                lines.append(f"    case {n}: goto label_{n};")
            lines.append("    }")
        for i, line in enumerate(self.body):
            if i in self.gosub_sites and self.return_targets:
                indent = "    " + line[:len(line) - len(line.lstrip())]
                lines.append(indent + "{")
                lines.append(indent + "    int resume = " + line.lstrip())
                lines.append(indent + "    if (resume) {")
                lines.append(indent + "        jbc_collect(entry_mark, live);")
                lines.append(indent + "        switch (resume) {")
                active_fors = self.gosub_sites[i]
                for name in self.return_targets:
                    n = self.targets[name]
                    resets = self.reset_skipped_steps(name, active_fors)
                    lines.append(indent + f"        case {n}: {resets}goto label_{n};")
                lines.extend([indent + "        }", indent + "    }", indent + "}"])
            else:
                if i in self.goto_sites:
                    resets = self.reset_skipped_steps(*self.goto_sites[i])
                    if resets:
                        indent = " " * (len(line) - len(line.lstrip()))
                        line = indent + resets + line.lstrip()
                lines.append("    " + line)
        lines.append("    return 0;")
        lines += ["}", self.signature(), "{", f"    struct frame_{u} frame = {{0}};"]
        for i in range(len(self.formals)):
            lines.append(f"    frame.arg{i} = arg{i};")
        for name, block in self.commons.items():
            lines.append(f"    frame.{block.field} = jbc_storage({len(block.shapes)}, {c_string(name)});")
            lines.extend("    " + init for init in block.initializers)
        for field, size in self.local_arrays.items():
            if size is not None:
                lines.append(f"    frame.{field} = storage({size}, NULL);")
        if not self.routine:
            if self.uses_startup_clock:
                lines.append("    jbc_init_startup_clock();")
            if self.uses_session:
                lines.append("    jbc_init_session();")
            if self.needs_arguments:
                lines.append("    jbc_init_arguments(argc, argv);")
            for section, names in (('', memory_files), ('DICT', memory_dicts)):
                for name in names:
                    lines.append(f"    jbc_create_memory_file({c_string(section)}, {c_string(name)});")
            for name, key in memory_locks:
                lines.append(f"    jbc_seed_memory_lock({c_string(name)}, {c_string(key)});")
        if self.routine and self.sets_precision:
            lines.append("    int saved_precision = jbc_precision;")
        seq_scope = self.routine and (self.uses_sequential or self.calls or self.has_indirect_call)
        if seq_scope:
            lines.extend(["#ifdef JBC_SEQUENTIAL", "    ++seq_depth;", "#endif"])
        lines.append(f"    body_{u}(&frame, 0);")
        if self.opens_local_files:
            lines.append("    jbc_close_local_files(&frame);")
        if self.routine and self.sets_precision:
            lines.append("    jbc_precision = saved_precision;")
        if self.is_function:
            lines.append('    *result = frame.result ? frame.result : "";')
        for field in self.local_arrays:
            lines.append(f"    if (frame.{field}) jbc_release(frame.{field}->values);")
        if seq_scope:
            roots = [f"&arg{i}->value" for i, matrix in enumerate(self.formals.values()) if not matrix]
            if self.is_function:
                roots.append("result")
            roots.append("NULL")
            lines.extend(["#ifdef JBC_SEQUENTIAL", "    jbc_leave_sequential((const char **[]){"
                          + ", ".join(roots) + "});", "#endif"])
        if not self.routine:
            lines.extend(["    jbc_finish();", "    return 0;"])
        return "\n".join(lines + ["}", ""])


def routine_symbol(name):
    return "routine_" + name.encode("utf8").hex()


def routine_parameters(kinds):
    return [f"jbc_matrix arg{i}" if matrix else f"jbc_variable *arg{i}" for i, matrix in enumerate(kinds)]


def routine_signature(name, kinds, is_function):
    params = ["const char **result"] if is_function else []
    params.extend(routine_parameters(kinds))
    return f"void {routine_symbol(name)}({', '.join(params) or 'void'})"


def argument_fields(kinds):
    return ["matrix" if matrix else "scalar" for matrix in kinds]


def kind_string(kinds):
    return c_string("".join("M" if matrix else "S" for matrix in kinds))


def render_indirect_calls(units):
    if not any(unit.has_indirect_call for unit in units):
        return ""
    lines = [
        "typedef union { jbc_variable *scalar; jbc_matrix matrix; } jbc_argument;",
        "static void jbc_call_indirect(const char *name, const char *kinds, const jbc_argument *args,",
        "                              const char *file, int line, int column)",
        "{",
        "    (void)kinds;",
        "    (void)args;",
        '    const char *message = "unknown subroutine";',
    ]
    for unit in units:
        if not unit.routine or unit.is_function:
            continue
        name = unit.routine.word
        kinds = tuple(unit.formals.values())
        args = ", ".join(f"args[{i}].{field}" for i, field in enumerate(argument_fields(kinds)))
        lines.extend([
            f"    if (strcmp(name, {c_string(name, unit.encoding)}) == 0) {{",
            f"        if (strcmp(kinds, {kind_string(kinds)}) == 0) {{",
            f"            {routine_symbol(name)}({args});",
            "            return;",
            "        }",
            '        message = "incompatible arguments for subroutine";',
            "    }",
        ])
    lines.extend([
        """    fprintf(stderr, "%s:%d:%d: %s '%s'\\n", file, line, column, message, name);""",
        "    jbc_terminate(EXIT_FAILURE);",
        "}",
    ])
    return "\n".join(lines)


def render_exit_callbacks(units):
    if not any(unit.uses_callonexit for unit in units):
        return ""
    lines = [
        "static jbc_exit_callback jbc_find_exit_callback(const char *name, size_t length)",
        "{",
        "    (void)name;",
        "    (void)length;",
    ]
    for unit in units:
        if not unit.routine or unit.is_function or tuple(unit.formals.values()) != (False,):
            continue
        name = unit.routine.word
        literal = c_string(name, unit.encoding)
        lines.append(f"    if (length == sizeof {literal} - 1 && !memcmp(name, {literal}, length))")
        lines.append(f"        return {routine_symbol(name)};")
    lines.extend(["    return NULL;", "}"])
    return "\n".join(lines)


def compile_unit(path, directories, index=0, *, source_encoding='utf-8'):
    encoding = SOURCE_ENCODINGS[source_encoding]
    unit = Compiler(path, index, encoding)
    unit.parse(list(Preprocessor(directories, encoding).read(path)))
    return unit


def compile_program(paths, directories, memory_files=(), memory_dicts=(), memory_locks=(), *, source_encoding='utf-8'):
    for name, _ in memory_locks:
        if name not in memory_files:
            raise Diagnostic(f"--memory-lock requires --memory-file {name}")
    units = []
    routines = {}
    programs = []
    for i, path in enumerate(paths):
        unit = compile_unit(path, directories, i, source_encoding=source_encoding)
        units.append(unit)
        if unit.routine:
            name = unit.routine.word
            if name in routines:
                unit.error("duplicate routine", unit.routine)
            routines[name] = unit
        else:
            programs.append(unit)
    if len(programs) != 1:
        raise Diagnostic("expected one main program among the input files")
    programs[0].needs_arguments = any(unit.needs_arguments for unit in units)
    programs[0].uses_session = any(unit.uses_session for unit in units)
    programs[0].uses_startup_clock = any(unit.uses_startup_clock for unit in units)
    layouts = {}
    for unit in units:
        for name, block in unit.commons.items():
            known = layouts.setdefault(name, list(block.shapes))
            if len(known) != len(block.shapes) or not all(
                    compatible_dimensions(a, b) for a, b in zip(known, block.shapes)):
                unit.error(f"incompatible COMMON layout for /{name}/", block.token)
            for i, shape in enumerate(block.shapes):
                known[i] = tuple(x if x is not None else y for x, y in zip(known[i], shape))
        for target, kinds, is_function in unit.calls:
            if target.word not in routines or routines[target.word].is_function != is_function:
                kind = "function" if is_function else "subroutine"
                unit.error(f"unknown {kind} '{target.word}'", target)
            if len(kinds) != len(routines[target.word].formals):
                unit.error(f"wrong argument count for '{target.word}'", target)
            if kinds != tuple(routines[target.word].formals.values()):
                unit.error(f"scalar/MAT argument mismatch for '{target.word}'", target)
    runtime = (Path(__file__).resolve().parent / 'runtime' / 'jbc.c').read_text()
    prototypes = [u.signature() + ";" for u in routines.values()]
    prototypes.append(render_indirect_calls(units))
    prototypes.append(render_exit_callbacks(units))
    features = runtime_features(units)
    return "\n".join([features, runtime] + prototypes + [u.render(memory_files, memory_dicts, memory_locks) for u in units])


def runtime_features(units):
    flags = []
    if any(unit.uses_callonexit for unit in units):
        flags.append("#define JBC_CALLONEXIT 1")
    if any(unit.uses_math for unit in units):
        flags.append("#define JBC_MATH 1")
    if any(unit.uses_execute for unit in units):
        flags.append("#define JBC_EXECUTE 1")
    if any(unit.uses_putenv for unit in units):
        flags.append("#define JBC_PUTENV 1")
    if any(unit.uses_hush for unit in units):
        flags.append("#define JBC_HUSH 1")
    if any(unit.uses_sleep for unit in units):
        flags.append("#define JBC_SLEEP 1")
    if any(unit.uses_sequential for unit in units):
        flags.append("#define JBC_SEQUENTIAL 1")
    if any(unit.uses_saved_lists for unit in units):
        flags.append("#define JBC_SAVED_LISTS 1")
    if any(unit.uses_report for unit in units):
        flags.append("#define JBC_REPORT 1")
    if any(unit.terminal for unit in units):
        flags.append("#define JBC_TERMINAL 1")
    if any(unit.uses_session for unit in units):
        flags.append("#define JBC_SESSION 1")
    if any(unit.uses_userstats for unit in units):
        flags.append("#define JBC_USERSTATS 1")
    return "\n".join(flags)


def build_executable(source, output):
    try:
        compiler = shlex.split(os.environ.get('CC') or 'cc')
        flags = shlex.split(os.environ.get('CC_FLAGS', ''))
    except ValueError as error:
        raise Diagnostic(f"invalid CC or CC_FLAGS: {error}") from error
    if not compiler:
        raise Diagnostic("CC must name a C compiler")
    # Linking beside the destination keeps the final rename atomic.
    with tempfile.TemporaryDirectory(dir=output.parent) as directory:
        c_file = Path(directory) / 'program.c'
        binary = Path(directory) / 'program'
        c_file.write_text(source, encoding='utf-8')
        libraries = ['-lm'] if source.startswith('#define JBC_MATH 1\n') else []
        command = compiler + ['-std=c99', str(c_file)] + libraries + flags + ['-o', str(binary)]
        completed = subprocess.run(command)
        if completed.returncode:
            raise Diagnostic(f"C compiler exited with status {completed.returncode}")
        os.replace(binary, output)


def main():
    cli = argparse.ArgumentParser(description=__doc__)
    cli.add_argument('source', nargs='+', type=Path)
    cli.add_argument('--memory-file', dest='memory_files', action='append', default=[], metavar='NAME',
                     help='provide an empty named file in the in-memory test backend (repeatable)')
    cli.add_argument('--memory-dict', dest='memory_dicts', action='append', default=[], metavar='NAME',
                     help='provide an empty dictionary section in the in-memory test backend (repeatable)')
    cli.add_argument('--memory-lock', dest='memory_locks', action='append', nargs=2, default=[],
                     metavar=('FILE', 'KEY'), help='simulate a foreign update lock on a registered memory file')
    cli.add_argument('-I', dest='directories', action='append', type=Path, default=[], metavar='DIR')
    cli.add_argument('--source-encoding', choices=SOURCE_ENCODINGS, default='utf-8',
                     help='decode source as UTF-8 or preserve literal source bytes (default: utf-8)')
    cli.add_argument('--exe', action='store_true', help='build a native executable using CC and CC_FLAGS')
    cli.add_argument('-o', required=True, type=Path, metavar='OUTPUT')
    args = cli.parse_args()
    try:
        if any(args.o.resolve() == p.resolve() for p in args.source):
            raise Diagnostic("source and output paths must differ")
        result = compile_program(args.source, args.directories, args.memory_files, args.memory_dicts,
                                 args.memory_locks, source_encoding=args.source_encoding)
        if args.exe:
            build_executable(result, args.o)
            return 0
        with tempfile.NamedTemporaryFile(dir=args.o.parent, delete=False, mode='w',
                                         encoding='utf-8') as output:
            try:
                output.write(result)
                output.close()
                os.replace(output.name, args.o)
            finally:
                if os.path.exists(output.name):
                    os.unlink(output.name)
    except (Diagnostic, OSError, UnicodeError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
